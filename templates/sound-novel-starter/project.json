{
  "version": 1,
  "title": "雪どけを待たない便り",
  "designWidth": 960,
  "designHeight": 540,
  "windowWidth": 1280,
  "windowHeight": 720,
  "clearColor": {
    "r": 0.04,
    "g": 0.05,
    "b": 0.08
  },
  "maxDeltaTime": 0.05,
  "// textures": "背景の写真（作り方と出典は CREDITS.md）。名前は assets/novel.backdrops.json の photos の texture と対。立ち絵と小物は cast_<名前>_<表情> の名前（assets/novel.cast.json の cast・props と faces）。cast__sample_plain はテスト用の立ち絵（art/cast/sample.py が作る単色の形・描き出しとテストだけが CastDoc.sample で使い、物語には出さない）。",
  "textures": [
    {
      "name": "bg_slope",
      "path": "assets/bg/slope.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_desk_room",
      "path": "assets/bg/desk_room.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_studio_eaves",
      "path": "assets/bg/studio_eaves.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_studio",
      "path": "assets/bg/studio.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_still_akari_slope",
      "path": "assets/bg/still_akari_slope.jpg",
      "hasAlpha": false
    },
    {
      "name": "cast_toma_plain",
      "path": "assets/cast/toma_plain.png",
      "hasAlpha": true
    },
    {
      "name": "cast_toma_puzzled",
      "path": "assets/cast/toma_puzzled.png",
      "hasAlpha": true
    },
    {
      "name": "cast_toma_smile",
      "path": "assets/cast/toma_smile.png",
      "hasAlpha": true
    },
    {
      "name": "cast_map_plain",
      "path": "assets/cast/map_plain.png",
      "hasAlpha": true
    },
    {
      "name": "cast__sample_plain",
      "path": "assets/cast/_sample_plain.png",
      "hasAlpha": true
    }
  ],
  "// glyphs": "起動時に焼く字。used = ソースとアセットにある字を先に焼く（シナリオの字がそろってからタイトル画面が出る）",
  "glyphs": "used",
  "fonts": [
    {
      "name": "default",
      "path": "assets/ShipporiMincho-Regular.subset.ttf",
      "fontSize": 32.0
    }
  ],
  "sounds": [
    {
      "name": "amb_winter_wind",
      "path": "assets/sfx/amb_winter_wind.wav",
      "looping": true
    },
    {
      "name": "ui_page",
      "path": "assets/sfx/ui_page.wav",
      "looping": false
    },
    {
      "name": "ui_cursor",
      "path": "assets/sfx/ui_cursor.wav",
      "looping": false
    },
    {
      "name": "ui_choice",
      "path": "assets/sfx/ui_choice.wav",
      "looping": false
    },
    {
      "name": "ui_open",
      "path": "assets/sfx/ui_open.wav",
      "looping": false
    },
    {
      "name": "ui_save",
      "path": "assets/sfx/ui_save.wav",
      "looping": false
    }
  ],
  "editor": {
    "resources": [
      {
        "id": "story",
        "pattern": "assets/novel.story.json",
        "title": "画面の言葉（タイトル画面・ボタン・セーブ）と話し手の呼び名",
        "role": "material",
        "schema": "assets/story.schema.json"
      },
      {
        "id": "backdrops",
        "pattern": "assets/novel.backdrops.json",
        "title": "背景の写真と時間帯の色（ぼかし・夕暮れ・夜・朝）",
        "role": "material",
        "schema": "assets/backdrops.schema.json"
      },
      {
        "id": "theme",
        "pattern": "assets/novel.theme.json",
        "title": "字・ウィンドウの色と待ちの印",
        "role": "material",
        "schema": "assets/theme.schema.json"
      },
      {
        "id": "credits",
        "pattern": "assets/novel.credits.json",
        "title": "クレジット（絵と音とフォントの出典）",
        "role": "material",
        "schema": "assets/credits.schema.json"
      },
      {
        "id": "kind",
        "pattern": "assets/novel.kind.json",
        "title": "手触り（字の大きさ・オート・スキップ・揺れ・蛍・雪）",
        "role": "tuning",
        "schema": "assets/kind.schema.json"
      },
      {
        "id": "keys",
        "pattern": "assets/novel.keys.json",
        "title": "操作（キーの割り当て）",
        "role": "tuning",
        "schema": "assets/keys.schema.json"
      },
      {
        "id": "small",
        "pattern": "assets/novel.small.json",
        "title": "小さい画面の字とボタンの大きさ",
        "role": "tuning",
        "schema": "assets/small.schema.json"
      },
      {
        "id": "portrait",
        "pattern": "assets/novel.portrait.json",
        "title": "縦の画面の字とボタンの大きさ",
        "role": "tuning",
        "schema": "assets/portrait.schema.json"
      },
      {
        "id": "rail",
        "pattern": "assets/novel.rail.json",
        "title": "縦の画面の操作の列",
        "role": "tuning",
        "schema": "assets/rail.schema.json"
      },
      {
        "id": "cast",
        "pattern": "assets/novel.cast.json",
        "title": "立ち絵と小物",
        "role": "material",
        "schema": "assets/cast.schema.json"
      },
      {
        "id": "shots",
        "pattern": "assets/novel.shots.json",
        "title": "描き出しの場面（make render の SHOT とギャラリーの並び）",
        "role": "tuning",
        "schema": "assets/shots.schema.json"
      },
      {
        "id": "mixer",
        "pattern": "assets/novel.mixer.json",
        "title": "音の通り道（環境音と効果音のバス）",
        "role": "tuning",
        "schema": "assets/mixer.schema.json"
      },
      {
        "id": "effects",
        "pattern": "assets/novel.effects.json",
        "title": "画面の粒の演出（蛍・雪の層の数と一度だけ出す秒）",
        "role": "tuning",
        "schema": "assets/effects.schema.json"
      },
      {
        "id": "prompts",
        "pattern": "assets/novel.prompts.json",
        "title": "入力の案内（払い・タップで選ぶ選択肢の矢印・絵・当たる物）",
        "role": "material",
        "schema": "assets/prompts.schema.json"
      },
      {
        "id": "project",
        "pattern": "project.json",
        "schema": "project.schema.json",
        "title": "ゲームの題・画面",
        "role": "tuning"
      }
    ]
  },
  "web": {
    "startPrompt": "タッチして開始",
    "compress": {
      "lossyImages": [
        {
          "glob": "assets/bg/*.jpg",
          "quality": 85
        }
      ]
    },
    "embed": [
      "assets/talk/dialogue.json"
    ],
    "omit": [
      "assets/talk/*.yarn",
      "assets/*.schema.json"
    ],
    "// deferred": "押して始めた後に裏で取る素材（シナリオで出てくる順）。タイトルの写真（slope）と環境音（winter_wind）、タイトルで鳴る返事の音は起動時に取る。届く前に使う所は暗転で待つ（背景・環境音）か、鳴らさずに進む（一発の音）。",
    "deferred": [
      "assets/sfx/ui_page.wav",
      "assets/bg/desk_room.jpg",
      "assets/cast/map_plain.png",
      "assets/sfx/ui_choice.wav",
      "assets/bg/studio_eaves.jpg",
      "assets/cast/toma_plain.png",
      "assets/cast/toma_puzzled.png",
      "assets/bg/studio.jpg",
      "assets/cast/toma_smile.png",
      "assets/bg/still_akari_slope.jpg"
    ],
    "keysDoc": "assets/novel.keys.json",
    "touchGestures": {
      "longPress": "touchHold",
      "swipeLeft": "rollback",
      "swipeUp": "flickUp",
      "swipeDown": "flickDown"
    },
    "orientation": "any",
    "portraitDesign": {
      "width": 540,
      "minHeight": 960
    }
  }
}
