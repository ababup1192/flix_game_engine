{
  "version": 1,
  "title": "夏草の駅",
  "designWidth": 960,
  "designHeight": 540,
  "windowWidth": 1280,
  "windowHeight": 720,
  "clearColor": {
    "r": 0.04,
    "g": 0.05,
    "b": 0.08
  },
  "maxDeltaTime": 0.05,
  "// textures": "背景の写真（出典は CREDITS.md）。名前は assets/novel.backdrops.json の photos の texture と対。",
  "textures": [
    {
      "name": "bg_station",
      "path": "assets/bg/station.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_paddy",
      "path": "assets/bg/paddy.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_lane",
      "path": "assets/bg/lane.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_engawa",
      "path": "assets/bg/engawa.jpg",
      "hasAlpha": false
    },
    {
      "name": "bg_river",
      "path": "assets/bg/river.jpg",
      "hasAlpha": false
    }
  ],
  "// glyphs": "起動時に焼く字。used = ソースとアセットにある字を先に焼く（シナリオの字がそろってからタイトル画面が出る）",
  "glyphs": "used",
  "fonts": [
    {
      "name": "default",
      "path": "assets/ShipporiMincho-Regular.subset.ttf",
      "fontSize": 32.0
    }
  ],
  "sounds": [
    {
      "name": "amb_evening",
      "path": "assets/sfx/amb_evening.wav",
      "looping": true
    },
    {
      "name": "amb_night",
      "path": "assets/sfx/amb_night.wav",
      "looping": true
    },
    {
      "name": "amb_river",
      "path": "assets/sfx/amb_river.wav",
      "looping": true
    },
    {
      "name": "amb_morning",
      "path": "assets/sfx/amb_morning.wav",
      "looping": true
    },
    {
      "name": "se_slap",
      "path": "assets/sfx/se_slap.wav",
      "looping": false
    },
    {
      "name": "se_furin",
      "path": "assets/sfx/se_furin.wav",
      "looping": false
    },
    {
      "name": "ui_page",
      "path": "assets/sfx/ui_page.wav",
      "looping": false
    },
    {
      "name": "ui_cursor",
      "path": "assets/sfx/ui_cursor.wav",
      "looping": false
    },
    {
      "name": "ui_choice",
      "path": "assets/sfx/ui_choice.wav",
      "looping": false
    },
    {
      "name": "ui_open",
      "path": "assets/sfx/ui_open.wav",
      "looping": false
    },
    {
      "name": "ui_save",
      "path": "assets/sfx/ui_save.wav",
      "looping": false
    }
