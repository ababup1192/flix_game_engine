{
  "version": 1,
  "title": "描き出しの場面",
  "note": "make render SHOT=<name> と make render-all（gallery/<name>.png）の場面と並び。実機でも START=shot:<name> で同じ World から開く。node = 開くノード、say = そのノードの何番目（0 から）の台詞を出し終えた所、until: \"choices\" = 選択肢が出るまで送った所（どちらも無ければノードの頭）。vars = シナリオの変数（$ を付けない名前 → 値）。open = 開く画面（title・log・save・load・settings・ask・credits・hold）。pointer = マウスの位置（design px）。at = 時計を据える秒。縦の画面・小さい画面・Doc を差し替える場面は src/render/SceneRender.flix がここの名前を引いて作る。node は bin/fge yarn build がシナリオにあるかを見る。",
  "shots": [
    { "name": "title", "open": "title", "at": 3.0 },
    { "name": "nvl", "node": "Station", "say": 2, "at": 4.0 },
    { "name": "adv", "node": "Paddy", "say": 3, "at": 4.0 },
    { "name": "choice", "node": "Paddy", "until": "choices", "at": 4.0 },
    { "name": "lane", "node": "Lane", "say": 2, "at": 4.0 },
    { "name": "engawa", "node": "Engawa", "say": 3, "at": 4.0 },
    { "name": "night", "node": "River", "until": "choices", "vars": { "closeness": "2" }, "at": 6.5 },
    { "name": "morning", "node": "Morning", "say": 1, "at": 4.0 },
    { "name": "hold", "node": "Station", "say": 7, "open": "hold", "at": 4.0 },
    { "name": "log", "open": "log", "pointer": [400.0, 300.0], "at": 4.0 },
    { "name": "save", "node": "River", "say": 2, "open": "save", "at": 4.0 },
    { "name": "load", "open": "load", "at": 4.0 },
    { "name": "settings", "node": "Paddy", "say": 3, "open": "settings", "at": 1.2 },
    { "name": "ask", "node": "Lane", "say": 2, "open": "ask", "at": 4.0 },
    { "name": "credits", "open": "credits", "at": 12.0 }
  ]
