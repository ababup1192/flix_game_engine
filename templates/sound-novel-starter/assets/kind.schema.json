{
  "//": "novel.kind.json の形の宣言（Studio の sections 方言）。手触りの数の初期値だけ Doc に置き、規則はコード側。既定は src/KindDoc.flix の defaults() が正。",
  "version": 1,
  "sections": {
    "bodySize": {
      "kind": "field",
      "type": "float",
      "label": "本文の字の大きさ（px）",
      "order": 1,
      "min": 12,
      "max": 40,
      "default": 22.0
    },
    "rubySize": {
      "kind": "field",
      "type": "float",
      "label": "ルビの字の大きさ（px）",
      "order": 2,
      "min": 6,
      "max": 20,
      "default": 11.0
    },
    "nameSize": {
      "kind": "field",
      "type": "float",
      "label": "話し手の名前の字の大きさ（px）",
      "order": 3,
      "min": 10,
      "max": 32,
      "default": 19.0
    },
    "lineGap": {
      "kind": "field",
      "type": "float",
      "label": "行の間（px。ルビが入るので rubySize 以上）",
      "order": 4,
      "min": 0,
      "max": 40,
      "default": 14.0
    },
    "advRows": {
      "kind": "field",
      "type": "int",
      "label": "ADV のウィンドウの行の数",
      "order": 5,
      "min": 1,
      "max": 6,
      "default": 3
    },
    "nvlRows": {
      "kind": "field",
      "type": "int",
      "label": "NVL の頁の行の数（入り切らなければ頁をめくる）",
      "order": 6,
      "min": 3,
      "max": 16,
      "default": 11
    },
    "cps": {
      "kind": "field",
      "type": "float",
      "label": "文字の速さの既定（1 秒の字数。設定の画面で変えた値は saves/novel.json）",
      "order": 7,
      "min": 5,
      "max": 200,
      "default": 40.0
    },
    "autoWait": {
      "kind": "field",
      "type": "float",
      "label": "オートの待ちの既定（秒）",
      "order": 8,
      "min": 0,
      "max": 10,
      "default": 1.2
    },
    "masterVolume": {
      "kind": "field",
      "type": "float",
      "label": "全体の音量の既定（0〜1。環境音と効果音に掛ける）",
      "order": 9,
      "min": 0,
      "max": 1,
      "default": 1.0
    },
    "ambienceVolume": {
      "kind": "field",
      "type": "float",
      "label": "環境音の音量の既定（0〜1）",
      "order": 10,
      "min": 0,
      "max": 1,
      "default": 0.7
    },
    "seVolume": {
      "kind": "field",
      "type": "float",
      "label": "効果音の音量の既定（0〜1）",
      "order": 11,
      "min": 0,
      "max": 1,
      "default": 0.8
    },
    "windowAlpha": {
      "kind": "field",
      "type": "float",
      "label": "文章のウィンドウの濃さの既定（0〜1。ADV のウィンドウと NVL の幕）",
      "order": 12,
      "min": 0,
      "max": 1,
      "default": 0.74
    },
    "autoPerChar": {
      "kind": "field",
      "type": "float",
      "label": "オートの待ちに足す 1 字あたりの秒",
      "order": 13,
      "min": 0,
      "max": 0.5,
      "default": 0.04
    },
    "skipInterval": {
      "kind": "field",
      "type": "float",
      "label": "スキップで 1 行を出す間（秒）",
      "order": 14,
      "min": 0,
      "max": 1,
      "default": 0.06
    },
    "logMax": {
      "kind": "field",
      "type": "int",
      "label": "ログに残す行の数",
      "order": 15,
      "min": 10,
      "max": 1000,
      "default": 120
    },
    "shakeSeconds": {
      "kind": "field",
      "type": "float",
      "label": "<<shake>> の長さ（秒）",
      "order": 16,
      "min": 0,
      "max": 3,
      "default": 0.35
    },
    "shakePx": {
      "kind": "field",
      "type": "float",
      "label": "<<shake>> の揺れ幅（px）",
      "order": 17,
      "min": 0,
      "max": 40,
      "default": 7.0
    },
    "fireflies": {
      "kind": "field",
      "type": "int",
      "label": "蛍の数",
      "order": 18,
      "min": 0,
      "max": 120,
      "default": 28
    },
    "snow": {
      "kind": "record",
      "label": "雪（<<fx snow>>）",
      "order": 19,
      "fields": {
        "count": {
          "type": "int",
          "label": "粒子の数",
          "order": 1,
          "min": 0,
          "max": 400,
          "default": 120
        },
        "fallSpeed": {
          "type": "float",
          "label": "落ちる速さ（px/秒）",
          "order": 2,
          "min": 1,
          "max": 200,
          "default": 28.0
        },
        "size": {
          "type": "float",
          "label": "粒子の半径（px）",
          "order": 3,
          "min": 0.3,
          "max": 8,
          "default": 2.4
        },
        "sway": {
          "type": "float",
          "label": "横に揺れる幅（px）",
          "order": 4,
          "min": 0,
          "max": 80,
          "default": 12.0
        },
        "fadeIn": {
          "type": "float",
          "label": "降り始めてから粒子がそろうまでの秒",
          "order": 5,
          "min": 0,
          "max": 10,
          "default": 1.5
        },
        "glow": {
          "type": "float",
          "label": "粒子の周りのにじみの濃さ（0〜1）",
          "order": 6,
          "min": 0,
          "max": 1,
          "default": 0.08
        },
        "glowRadius": {
          "type": "float",
          "label": "にじみの半径（粒子の半径の倍率）",
          "order": 7,
          "min": 1,
          "max": 8,
          "default": 2.2
        },
        "twinkleEvery": {
          "type": "float",
          "label": "光を拾って明るくなる平均の間（秒・粒子ごとにばらつく）",
          "order": 8,
          "min": 0.5,
          "max": 120,
          "default": 8.0
        },
        "twinkleSeconds": {
          "type": "float",
          "label": "明るくなって戻るまでの秒",
          "order": 9,
          "min": 0.05,
          "max": 3,
          "default": 0.45
        },
        "twinkleGain": {
          "type": "float",
          "label": "明るくなる時ににじみが強まる割合",
          "order": 10,
          "min": 0,
          "max": 4,
          "default": 0.7
        },
        "warmPhotos": {
          "type": "json",
          "label": "灯りのある背景の写真の名前の列（novel.backdrops.json の photos）",
          "order": 11,
          "default": [
            "studio_eaves"
          ]
        },
        "warmFromX": {
          "type": "float",
          "label": "暖かくなり始める横の位置（画面の幅に対する割合）",
          "order": 12,
          "min": 0,
          "max": 1,
          "default": 0.6
        },
        "warmColor": {
          "type": "color",
          "label": "灯りの側の暖かい色",
          "order": 13,
          "default": "#ffd9a8"
        },
        "warmStrength": {
          "type": "float",
          "label": "右端で暖かい色へ近づける割合（0〜1）",
          "order": 14,
          "min": 0,
          "max": 1,
          "default": 0.3
        }
      }
    },
    "creditsSpeed": {
      "kind": "field",
      "type": "float",
      "label": "クレジットが流れる速さ（px/秒）",
      "order": 20,
      "min": 5,
      "max": 200,
      "default": 34.0
    },
    "toastSeconds": {
      "kind": "field",
      "type": "float",
      "label": "知らせを出す秒",
      "order": 21,
      "min": 0.2,
      "max": 10,
      "default": 1.6
    },
    "holdFadeSeconds": {
      "kind": "field",
      "type": "float",
      "label": "素材を待つ時に黒へ重ねる秒・黒から戻す秒（ブラウザ版で後回しの背景・環境音がまだ届いていない時）",
      "order": 22,
      "min": 0.05,
      "max": 3,
      "default": 0.4
    },
    "holdGiveUpSeconds": {
      "kind": "field",
      "type": "float",
      "label": "素材を待ち切れずに諦めて先へ進むまでの秒（黒のままの間だけ数える）",
      "order": 23,
      "min": 1,
      "max": 120,
      "default": 20.0
    },
    "holdMarkSeconds": {
      "kind": "field",
      "type": "float",
      "label": "黒になってから隅に待ちの印（点の明滅）を出すまでの秒",
      "order": 24,
      "min": 0,
      "max": 10,
      "default": 0.4
    },
    "tapSlop": {
      "kind": "field",
      "type": "float",
      "label": "押した所からこれより離れずに離せばタップ（design px。越えたら払いかドラッグで、どれも離すと 1 行送る。左の払いは戻るだけ）",
      "group": "読む画面の押し（長押しの外は離すと送る）",
      "order": 25,
      "min": 1,
      "max": 80,
      "default": 12.0
    },
    "longPressSeconds": {
      "kind": "field",
      "type": "float",
      "label": "動かさずにこれ以上置いてから離すと長押し（秒。送らない）",
      "group": "読む画面の押し（長押しの外は離すと送る）",
      "order": 26,
      "min": 0.1,
      "max": 3,
      "default": 0.65
    },
    "swipeMin": {
      "kind": "field",
      "type": "float",
      "label": "押した所から離した所までこれ以上動かすと払い（design px）",
      "group": "読む画面の押し（長押しの外は離すと送る）",
      "order": 27,
      "min": 10,
      "max": 400,
      "default": 60.0
    },
    "swipeSeconds": {
      "kind": "field",
      "type": "float",
      "label": "払いと見なす長さ（秒。これより遅い動きはドラッグ）",
      "group": "読む画面の押し（長押しの外は離すと送る）",
      "order": 28,
      "min": 0.05,
      "max": 3,
      "default": 0.5
    },
    "cpsSlider": {
      "kind": "record",
      "label": "文字の速さのスライダー（字/秒）",
      "group": "設定の画面のスライダー",
      "order": 29,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 10.0
        },
        "max": {
          "type": "float",
          "label": "上限（ここまで上げるとノーウェイト = 行を一度に全部出す）",
          "order": 2,
          "default": 130.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 10.0
        }
      }
    },
    "autoWaitSlider": {
      "kind": "record",
      "label": "オートの待ちのスライダー（秒）",
      "group": "設定の画面のスライダー",
      "order": 30,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 0.2
        },
        "max": {
          "type": "float",
          "label": "上限",
          "order": 2,
          "default": 4.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 0.2
        }
      }
    },
    "masterVolumeSlider": {
      "kind": "record",
      "label": "全体の音量のスライダー",
      "group": "設定の画面のスライダー",
      "order": 31,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 0.0
        },
        "max": {
          "type": "float",
          "label": "上限",
          "order": 2,
          "default": 1.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 0.1
        }
      }
    },
    "ambienceVolumeSlider": {
      "kind": "record",
      "label": "環境音の音量のスライダー",
      "group": "設定の画面のスライダー",
      "order": 32,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 0.0
        },
        "max": {
          "type": "float",
          "label": "上限",
          "order": 2,
          "default": 1.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 0.1
        }
      }
    },
    "seVolumeSlider": {
      "kind": "record",
      "label": "効果音の音量のスライダー",
      "group": "設定の画面のスライダー",
      "order": 33,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 0.0
        },
        "max": {
          "type": "float",
          "label": "上限",
          "order": 2,
          "default": 1.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 0.1
        }
      }
    },
    "windowAlphaSlider": {
      "kind": "record",
      "label": "ウィンドウの濃さのスライダー",
      "group": "設定の画面のスライダー",
      "order": 34,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 0.2
        },
        "max": {
          "type": "float",
          "label": "上限",
          "order": 2,
          "default": 1.0
        },
        "step": {
          "type": "float",
          "label": "1 押しの量",
          "order": 3,
          "min": 0.01,
          "default": 0.1
        }
      }
    }
  }
}
