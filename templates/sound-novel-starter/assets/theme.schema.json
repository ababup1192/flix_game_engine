{
  "//": "novel.theme.json の形の宣言（Studio の sections 方言）。字・ウィンドウの色と待ちの印。写真の色は novel.backdrops.json の時間帯。",
  "version": 1,
  "sections": {
    "ink": {
      "kind": "field",
      "type": "color",
      "label": "本文の字",
      "order": 1,
      "required": true
    },
    "inkSeen": {
      "kind": "field",
      "type": "color",
      "label": "既読の行の字（スキップで飛ばせる行）",
      "order": 2,
      "required": true
    },
    "name": {
      "kind": "field",
      "type": "color",
      "label": "話し手の名前",
      "order": 3,
      "required": true
    },
    "accent": {
      "kind": "field",
      "type": "color",
      "label": "選んでいる物・オートとスキップの点灯（差し色）",
      "order": 4,
      "required": true
    },
    "panel": {
      "kind": "field",
      "type": "color",
      "label": "ADV のウィンドウ・選択肢・ウィンドウの地",
      "order": 5,
      "required": true
    },
    "veil": {
      "kind": "field",
      "type": "float",
      "label": "NVL の頁の下の幕の濃さ（ウィンドウの濃さに掛ける割合）",
      "order": 6,
      "min": 0,
      "max": 1,
      "default": 0.8
    },
    "firefly": {
      "kind": "field",
      "type": "color",
      "label": "蛍の光",
      "order": 7,
      "required": true
    },
    "loadingMark": {
      "kind": "field",
      "type": {
        "enum": [
          "dots",
          "ring",
          "none"
        ]
      },
      "label": "素材を待つ間の印（dots = 右下の点 3 つ・ring = 真ん中の回る輪と字・none = 黒だけ）",
      "order": 8,
      "default": "dots"
    },
    "speakers": {
      "kind": "list",
      "label": "話し手の色（id = シナリオの話し手の id・地の文は空）",
      "order": 9,
      "fields": {
        "id": {
          "type": "text",
          "label": "話し手の id（地の文は空）",
          "order": 1
        },
        "name": {
          "type": "text",
          "label": "人に見せる名前（空なら novel.story.json の names）",
          "order": 2
        },
        "color": {
          "type": "color",
          "label": "名前の字",
          "order": 3,
          "required": true
        },
        "ink": {
          "type": "color",
          "label": "本文の字",
          "order": 4,
          "required": true
        }
      }
    },
    "windows": {
      "kind": "catalog",
      "label": "メッセージ枠の型（鍵 = <<window 型>> の型の名前。Nvl と Adv はセーブの古い値と同じ字なので使えない）",
      "order": 10,
      "fields": {
        "kind": {
          "type": {
            "enum": [
              "nvl",
              "adv"
            ]
          },
          "label": "出し方（nvl = 画面いっぱいに積む・adv = 枠に今の 1 行）",
          "order": 1,
          "default": "adv",
          "required": true
        },
        "place": {
          "type": {
            "enum": [
              "bottom",
              "center"
            ]
          },
          "label": "adv の枠の置き場（bottom = 画面の下・center = 真ん中）",
          "order": 2,
          "default": "bottom"
        },
        "frame": {
          "type": {
            "enum": [
              "panel",
              "outline"
            ]
          },
          "label": "字の立たせ方（panel = 字の下に枠の地を敷く・outline = 地を敷かず字を暗い縁取りで囲む＝字幕の形）",
          "order": 3,
          "default": "panel"
        },
        "showName": {
          "type": "bool",
          "label": "adv の枠と縦の画面に話し手の名前を出すか（横の NVL の頁は名前を出さない）",
          "order": 4,
          "default": true
        },
        "quotes": {
          "type": "bool",
          "label": "台詞（話し手のある行）を「」で包むか",
          "order": 5,
          "default": true
        },
        "portrait": {
          "type": {
            "enum": [
              "page",
              "band",
              "frame"
            ]
          },
          "label": "縦の画面での字の出し方（page = 画面いっぱいの頁に上から積む・band = 画面の下の帯に今の行だけ。覆いは帯の上にだけ・frame = 画面の真ん中の枠に今の行だけ。高さは行の数）",
          "order": 6,
          "default": "page"
        },
        "bandHeight": {
          "type": "float",
          "label": "portrait が band の時の帯の高さ（画面の下端から px。帯の上端から字を出す）",
          "order": 7,
          "min": 60,
          "default": 236
        },
        "frameCenter": {
          "type": "float",
          "label": "portrait が frame の時の枠の真ん中の高さ（画面の高さに対する割合。右の列の下端より上には出さない）",
          "order": 8,
          "min": 0.2,
          "max": 0.8,
          "default": 0.4
        },
        "align": {
          "type": {
            "enum": [
              "left",
              "center"
            ]
          },
          "label": "この型の本文の揃え（center = 改行で区切った行ごとに真ん中へ寄せる。書くと型に替えた時にこの揃えへ戻る・書かなければ <<text align=>> で替えるまで left）",
          "order": 5.5
        }
      }
    },
    "legacyModes": {
      "kind": "record",
      "label": "セーブの古い mode の値の読み替え先（型の名前。欠け・windows に無い・出し方が違うと読み込みで知らせ、その出し方の最初の型で読む）",
      "order": 11,
      "fields": {
        "Nvl": {
          "type": "text",
          "label": "Nvl の読み替え先（kind が nvl の型の名前）",
          "order": 1,
          "default": "nvl",
          "required": true
        },
        "Adv": {
          "type": "text",
          "label": "Adv の読み替え先（kind が adv の型の名前）",
          "order": 2,
          "default": "bottom",
          "required": true
        }
      }
    }
  }
}
