{
  "//": "novel.cast.json の形の宣言（Studio の sections 方言）。立ち絵と小物の位置・一覧・出入りの秒。出し方と重ね方の決まりはコード（src/Cast.flix）。既定は src/CastDoc.flix の defaults() が正。",
  "version": 1,
  "sections": {
    "fadeSeconds": {
      "kind": "field",
      "type": "float",
      "label": "出入りと入れ替えの既定の秒",
      "group": "出し方",
      "order": 1,
      "min": 0,
      "max": 3,
      "default": 0.4
    },
    "slideDistance": {
      "kind": "field",
      "type": "float",
      "label": "from= / to= で端から滑る距離（画面に対する割合。1 で画面の外まで）",
      "group": "出し方",
      "order": 1,
      "min": 0,
      "max": 2,
      "default": 1.0
    },
    "sway": {
      "kind": "field",
      "type": "float",
      "label": "息の揺れの幅（画面の高さに対する割合・0 で止める）",
      "group": "出し方",
      "order": 2,
      "min": 0,
      "max": 0.02,
      "default": 0.002
    },
    "portraitVeilWithCast": {
      "kind": "field",
      "type": "float",
      "label": "縦の画面で人物が出ている間、頁の覆いの濃さに掛ける倍率（1 = 変えない・小さいほど人物がはっきり見える）",
      "group": "出し方",
      "order": 3,
      "min": 0,
      "max": 1,
      "default": 1.0
    },
    "highlight": {
      "kind": "record",
      "label": "話し手を明るくする（話し手が出ている間、ほかの人物を暗くする）",
      "group": "出し方",
      "order": 3,
      "fields": {
        "dim": {
          "type": "float",
          "label": "話していない人物を暗くする量（0 = 暗くしない・1 = 真っ黒）",
          "order": 1,
          "min": 0,
          "max": 1,
          "default": 0.35
        },
        "seconds": {
          "type": "float",
          "label": "話し手が替わった時に明るさをつなぐ秒",
          "order": 2,
          "min": 0,
          "max": 3,
          "default": 0.25
        },
        "voices": {
          "type": {
            "list": "text"
          },
          "label": "立ち絵を持たないが、話している間はほかの人物を暗くする話し手の id（声だけの人物・ゲームが自分で描く人物）",
          "order": 3
        }
      }
    },
    "propsOnPage": {
      "kind": "field",
      "type": {
        "enum": [
          "overWindow",
          "underWindow"
        ]
      },
      "label": "頁の幕がある間（横の NVL・縦の画面の頁）の小物の重なり順（overWindow = 幕の上・字の下でくすまない・underWindow = 人物と同じ層で幕の奥に薄く見える）",
      "group": "出し方",
      "order": 3,
      "default": "overWindow"
    },
    "slots": {
      "kind": "catalog",
      "label": "横の画面の位置（<<show 名前 at=位置>> に書く位置の名前）",
      "order": 4,
      "fields": {
        "x": {
          "type": "float",
          "label": "絵の中心の横の位置（画面の幅に対する割合）",
          "order": 1,
          "default": 0.5,
          "min": 0,
          "max": 1,
          "required": true
        },
        "bottom": {
          "type": "float",
          "label": "足元の縦の位置（画面の高さに対する割合。1 = 画面の下）",
          "order": 2,
          "default": 1.0,
          "min": 0,
          "max": 1,
          "required": true
        },
        "height": {
          "type": "float",
          "label": "絵の高さ（画面の高さに対する割合）",
          "order": 3,
          "default": 0.9,
          "min": 0.05,
          "max": 1.5,
          "required": true
        },
        "exclusive": {
          "type": "bool",
          "label": "その位置に出せるのは 1 つ（後から出した物が前の物を消す。false で何人でも立てる）",
          "order": 4,
          "default": true
        }
      }
    },
    "portraitSlots": {
      "kind": "catalog",
      "label": "縦の画面の位置（名前の集まりは slots と同じにする）",
      "order": 5,
      "fields": {
        "x": {
          "type": "float",
          "label": "絵の中心の横の位置（画面の幅に対する割合）",
          "order": 1,
          "default": 0.5,
          "min": 0,
          "max": 1,
          "required": true
        },
        "bottom": {
          "type": "float",
          "label": "足元の縦の位置（画面の高さに対する割合。1 = 画面の下）",
          "order": 2,
          "default": 1.0,
          "min": 0,
          "max": 1,
          "required": true
        },
        "height": {
          "type": "float",
          "label": "絵の高さ（画面の高さに対する割合）",
          "order": 3,
          "default": 0.9,
          "min": 0.05,
          "max": 1.5,
          "required": true
        },
        "exclusive": {
          "type": "bool",
          "label": "その位置に出せるのは 1 つ（後から出した物が前の物を消す。false で何人でも立てる）",
          "order": 4,
          "default": true
        }
      }
    },
    "cast": {
      "kind": "catalog",
      "label": "人物（鍵 = <<show 名前>> の名前）",
      "order": 6,
      "fields": {
        "label": {
          "type": "text",
          "label": "人に見せる名前",
          "order": 1,
          "default": ""
        },
        "aspect": {
          "type": "float",
          "label": "絵の横 ÷ 縦（実物の PNG と同じにする・make lint-cast が見る）",
          "order": 2,
          "default": 0.5,
          "min": 0.05,
          "max": 4,
          "required": true
        },
        "scale": {
          "type": "float",
          "label": "位置の高さに掛ける倍率",
          "order": 3,
          "default": 1.0,
          "min": 0.1,
          "max": 3
        },
        "face": {
          "type": "text",
          "label": "既定の表情（faces のどれか）",
          "order": 4,
          "default": ""
        },
        "slot": {
          "type": "text",
          "label": "既定の位置（slots の名前）",
          "order": 5,
          "default": "center"
        },
        "faces": {
          "type": {
            "list": "text"
          },
          "label": "表情の名前（テクスチャは cast_<名前>_<表情>）",
          "order": 6
        },
        "layer": {
          "type": "int",
          "label": "重ね順（大きいほど手前。既定は人物 500・小物 600・背景に付く絵 100）",
          "order": 7,
          "default": 500,
          "min": 0,
          "max": 999
        },
        "attach": {
          "type": "json",
          "label": "背景に付く絵にする時だけ書く: { \"bg\": { 写真の名前: 横のずれ（画面の幅に対する割合） } }。背景のすぐ上に描き、写真ごとに横へずらす",
          "order": 8
        },
        "markers": {
          "type": "json",
          "label": "絵の中の点の名前 → { \"x\": 割合, \"y\": 割合 }（絵の左上 0・右下 1。<<fx 名 on=名前.点>> と <<speak>> が粒を出す所）",
          "order": 9
        },
        "hideWindow": {
          "type": "bool",
          "label": "出ている間は文字の枠と字を消す（選択肢とボタンは出す）",
          "order": 10,
          "default": false
        },
        "speakFx": {
          "type": "text",
          "label": "<<speak 名前>> が markers の mouth から一度出す粒（novel.effects.json の puff の粒の名前。空なら出さない）",
          "order": 11,
          "default": ""
        }
      }
    },
    "props": {
      "kind": "catalog",
      "label": "小物（鍵 = <<show 名前>> の名前。何個でも出せ、exclusive の位置にだけは 1 つ）",
      "order": 7,
      "fields": {
        "label": {
          "type": "text",
          "label": "人に見せる名前",
          "order": 1,
          "default": ""
        },
        "aspect": {
          "type": "float",
          "label": "絵の横 ÷ 縦（実物の PNG と同じにする・make lint-cast が見る）",
          "order": 2,
          "default": 0.5,
          "min": 0.05,
          "max": 4,
          "required": true
        },
        "scale": {
          "type": "float",
          "label": "位置の高さに掛ける倍率",
          "order": 3,
          "default": 1.0,
          "min": 0.1,
          "max": 3
        },
        "face": {
          "type": "text",
          "label": "既定の表情（faces のどれか）",
          "order": 4,
          "default": ""
        },
        "slot": {
          "type": "text",
          "label": "既定の位置（slots の名前）",
          "order": 5,
          "default": "item"
        },
        "faces": {
          "type": {
            "list": "text"
          },
          "label": "表情の名前（テクスチャは cast_<名前>_<表情>）",
          "order": 6
        },
        "layer": {
          "type": "int",
          "label": "重ね順（大きいほど手前。既定は人物 500・小物 600・背景に付く絵 100）",
          "order": 7,
          "default": 600,
          "min": 0,
          "max": 999
        },
        "attach": {
          "type": "json",
          "label": "背景に付く絵にする時だけ書く: { \"bg\": { 写真の名前: 横のずれ（画面の幅に対する割合） } }。背景のすぐ上に描き、写真ごとに横へずらす",
          "order": 8
        },
        "markers": {
          "type": "json",
          "label": "絵の中の点の名前 → { \"x\": 割合, \"y\": 割合 }（絵の左上 0・右下 1。<<fx 名 on=名前.点>> と <<speak>> が粒を出す所）",
          "order": 9
        },
        "hideWindow": {
          "type": "bool",
          "label": "出ている間は文字の枠と字を消す（選択肢とボタンは出す）",
          "order": 10,
          "default": false
        },
        "speakFx": {
          "type": "text",
          "label": "<<speak 名前>> が markers の mouth から一度出す粒（novel.effects.json の puff の粒の名前。空なら出さない）",
          "order": 11,
          "default": ""
        }
      }
    }
  }
}
