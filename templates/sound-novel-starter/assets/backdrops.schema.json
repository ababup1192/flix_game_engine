{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "背景の写真と時間帯の色（novel.backdrops.json）",
  "description": "シナリオの <<bg 写真 grade=時間帯 time=秒>> の名前はここの鍵。写真は昼の実写で、時間帯の色とぼかしはシェーダー（src/Backdrop.flix）が付ける。",
  "type": "object",
  "required": [
    "version",
    "photos",
    "grades"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "defaultTransition": {
      "type": "string",
      "enum": [
        "fade",
        "black",
        "wipe",
        "slide",
        "pan",
        "cut"
      ],
      "description": "transition= を省いた <<bg>> の切り替え（fade = 重ねる・black = 短く暗転・wipe = 左から塗り替える・slide = 前の写真を左へ送る・pan = 横へ振ったように流れながら重ねる・cut = すぐ替わる）",
      "default": "fade"
    },
    "defaultSeconds": {
      "type": "number",
      "minimum": 0,
      "default": 1.0,
      "description": "time= を省いた <<bg>> の切り替えの秒"
    },
    "defaultEase": {
      "type": "string",
      "enum": ["linear", "smoothstep", "inSine", "outSine", "inOutSine", "inQuad", "outQuad", "inOutQuad", "inCubic", "outCubic", "inOutCubic", "inQuart", "outQuart", "inOutQuart", "inExpo", "outExpo", "inOutExpo", "inBack", "outBack", "inOutBack", "inElastic", "outElastic", "inOutElastic", "inBounce", "outBounce", "inOutBounce"],
      "default": "linear",
      "description": "ease= を省いた <<bg>> の切り替えの進みの曲線"
    },
    "black": {
      "type": "object",
      "description": "transition=black の暗転の形。<<bg … time=>> の秒を、暗くなる間・暗いまま止まる間・明ける間に、この比で分ける（足して 1 でなくてよい）。写真は止まる間の真ん中で替わる。前の背景が無い（blank の）時は、この形によらず暗い所から全部の秒で明ける。Ren'Py の Fade(out, hold, in) と同じ形",
      "properties": {
        "fadeOut": { "type": "number", "minimum": 0, "default": 0.5, "description": "暗くなる間の比" },
        "hold":    { "type": "number", "minimum": 0, "default": 0.0, "description": "暗いまま止まる間の比" },
        "fadeIn":  { "type": "number", "minimum": 0, "default": 0.5, "description": "明ける間の比（0 なら暗いまま切り替えの終わりで一度に明ける）" }
      }
    },
    "ground": {
      "type": "color",
      "description": "写真の下に敷く地の色（blank の写真・素材の待ち・black の暗転で見える色。無ければ夜の紺 #0a0d14）"
    },
    "initial": {
      "type": "object",
      "description": "背景が無い間（最初の <<bg>> の前・セーブの背景が無い時）に描く背景。最初の <<bg>> はこれから重ねる",
      "required": ["photo", "grade"],
      "properties": {
        "photo": { "type": "string", "description": "photos の名前" },
        "grade": { "type": "string", "description": "grades の名前" }
      }
    },
    "title": {
      "type": "object",
      "description": "タイトル画面の背景の動き（写真と時間帯は novel.story.json の titlePhoto・titleGrade）",
      "properties": {
        "scale": { "type": "number", "minimum": 0.1, "maximum": 4, "default": 1, "description": "画面の真ん中を軸に広げる倍率" },
        "drift": {
          "type": "object",
          "description": "実時間 t 秒で x = sin(t × rate[0] + phase[0]) × amp[0] だけ漂う（y は [1]）",
          "properties": {
            "amp": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "rate": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "phase": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          }
        }
      }
    },
    "photos": {
      "type": "object",
      "description": "写真の名前 → 写真",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "texture": {
            "type": "string",
            "description": "project.json の textures の名前（blank の写真は空でよい）"
          },
          "blank": {
            "type": "boolean",
            "description": "絵を持たない写真（何も描かず地の色を見せる暗闇）。true なら texture は要らず、描き出しでも何も描かない"
          },
          "label": {
            "type": "string",
            "description": "セーブ画面に出す場所の名前"
          },
          "aspect": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "絵の横÷縦（書いた写真は画面を覆うように比を保って真ん中で切り抜く。縦に長い still など。書かなければ 16:9 の写真として画面に合わせて敷く）"
          }
        }
      }
    },
    "grades": {
      "type": "object",
      "description": "時間帯の名前 → 色とぼかし",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "blur": {
            "type": "number",
            "description": "ぼかしの半径（画面の幅に対する割合）",
            "minimum": 0,
            "maximum": 0.05
          },
          "taps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "description": "ぼかしで読む点の数"
          },
          "saturation": {
            "type": "number",
            "description": "彩度（1 = そのまま）",
            "minimum": 0,
            "maximum": 2
          },
          "exposure": {
            "type": "number",
            "description": "明るさ（1 = そのまま）",
            "minimum": 0,
            "maximum": 2
          },
          "tint": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "赤・緑・青の倍率"
          },
          "lift": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "暗い所に足す色"
          },
          "sky": {
            "type": "string",
            "description": "上から差す光の色（#rrggbb）"
          },
          "skyStrength": {
            "type": "number",
            "description": "上から差す光の強さ",
            "minimum": 0,
            "maximum": 1
          },
          "skyReach": {
            "type": "number",
            "description": "上から差す光の届く深さ（画面の高さに対する割合）",
            "minimum": 0,
            "maximum": 1
          },
          "vignette": {
            "type": "number",
            "description": "四隅を落とす強さ",
            "minimum": 0,
            "maximum": 1
          },
          "focusPull": {
            "type": "number",
            "description": "切り替えの頭で余分にぼかす量（blur の倍数）",
            "minimum": 0,
            "maximum": 4
          },
          "cast": {
            "type": "object",
            "description": "立ち絵と小物に掛ける色（無ければ絵のまま。人の姿が写った一枚絵の時間帯は書かない）",
            "properties": {
              "tint": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "赤・緑・青の倍率"
              },
              "exposure": {
                "type": "number",
                "description": "明るさ（1 = そのまま）",
                "minimum": 0,
                "maximum": 2
              },
              "saturation": {
                "type": "number",
                "description": "彩度（1 = そのまま）",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  }
}
