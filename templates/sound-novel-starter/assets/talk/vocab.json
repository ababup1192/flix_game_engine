{
  "commands": {
    "audio": {
      "params": [
        {
          "name": "channel",
          "pos": 1,
          "req": true,
          "type": "choice",
          "values": [
            "ambience",
            "bgm",
            "se",
            "all"
          ]
        },
        {
          "list": true,
          "name": "sound",
          "orWords": [
            "off"
          ],
          "pos": 2,
          "ref": {
            "from": [
              {
                "doc": "../../project.json",
                "path": "sounds[].name"
              }
            ]
          },
          "req": true,
          "type": "name"
        },
        {
          "max": 1,
          "min": 0,
          "name": "volume",
          "orNames": {
            "from": [
              {
                "doc": "../novel.mixer.json",
                "keys": "volumes"
              }
            ]
          },
          "type": "num"
        },
        {
          "max": 30,
          "min": 0,
          "name": "fade",
          "type": "num"
        },
        {
          "name": "wait",
          "type": "flag"
        }
      ],
      "summary": "環境音（ambience。, で重ねる）・音楽（bgm）を替える・止める、効果音を 1 回鳴らす（se。wait = 音の長さだけ待つ）、all off で環境音と音楽を止める（volume = 数か novel.mixer.json の volumes の名前・fade = 秒）"
    },
