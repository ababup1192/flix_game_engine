{
  "commands": {
    "audio": {
      "params": [
        {
          "name": "channel",
          "pos": 1,
          "req": true,
          "type": "choice",
          "values": [
            "ambience",
            "se"
          ]
        },
        {
          "name": "sound",
          "orWords": [
            "off"
          ],
          "pos": 2,
          "ref": {
            "from": [
              {
                "doc": "../../project.json",
                "path": "sounds[].name"
              }
            ]
          },
          "req": true,
          "type": "name"
        }
      ],
      "summary": "環境音を替える・止める（ambience）・効果音を 1 回鳴らす（se）"
    },
    "bg": {
      "params": [
        {
          "name": "photo",
          "pos": 1,
          "ref": {
            "from": [
              {
                "doc": "../novel.backdrops.json",
                "keys": "photos"
              }
            ]
          },
          "req": true,
          "type": "name"
        },
        {
          "name": "grade",
          "ref": {
            "from": [
              {
                "doc": "../novel.backdrops.json",
                "keys": "grades"
              }
            ]
          },
          "type": "name"
        },
        {
          "default": "1.0",
          "name": "time",
          "type": "time"
        }
      ],
      "summary": "背景の写真を時間帯の色で替え、秒かけて重ねる"
    },
    "fx": {
      "params": [
        {
          "name": "name",
          "orWords": [
            "off"
          ],
          "pos": 1,
          "req": true,
          "type": "choice",
          "values": [
            "fireflies"
          ]
        }
      ],
      "summary": "画面のパーティクルの演出を出す・止める"
    },
    "hide": {
      "params": [
        {
          "name": "name",
          "oneOf": "target",
          "orWords": [
            "all"
          ],
          "pos": 1,
          "ref": {
            "from": [
              {
                "doc": "../novel.cast.json",
                "keys": "cast"
              },
              {
                "doc": "../novel.cast.json",
                "keys": "props"
              }
            ]
          },
          "type": "name"
        },
        {
          "name": "at",
          "oneOf": "target",
          "ref": {
            "from": [
              {
                "doc": "../novel.cast.json",
                "keys": "slots"
              }
            ]
          },
          "type": "name"
        },
        {
          "max": 10,
          "min": 0,
          "name": "time",
          "type": "num"
        }
      ],
      "summary": "立ち絵か小物を消す（all = 全部・at= = その位置に出ている物）"
    },
    "shake": {
      "params": [],
      "summary": "画面を短く揺らす（長さと幅は novel.kind.json）"
    },
    "show": {
      "params": [
        {
          "name": "name",
          "pos": 1,
          "ref": {
            "from": [
              {
                "doc": "../novel.cast.json",
                "keys": "cast"
              },
              {
                "doc": "../novel.cast.json",
                "keys": "props"
              }
            ]
          },
          "req": true,
          "type": "name"
        },
        {
          "name": "face",
          "pos": 2,
          "type": "name"
        },
        {
          "name": "at",
          "ref": {
            "from": [
              {
                "doc": "../novel.cast.json",
                "keys": "slots"
              }
            ]
          },
          "type": "name"
        },
        {
          "max": 10,
          "min": 0,
          "name": "time",
          "type": "num"
        }
      ],
      "summary": "立ち絵か小物を出す・表情や位置を替える（time を省くと novel.cast.json の fadeSeconds）"
    },
    "window": {
      "params": [
        {
          "name": "mode",
          "pos": 1,
          "req": true,
          "type": "choice",
          "values": [
            "nvl",
            "bottom",
            "clear",
            "off"
          ]
        }
      ],
      "summary": "文字の出し方を替える（nvl = 画面いっぱい・bottom = 下のウィンドウ）・NVL の頁をめくる（clear）・文字の枠と字を消す（off。次の台詞で戻る）"
    }
  },
  "nodeRefs": {
    "from": [
      {
        "doc": "../novel.shots.json",
        "path": "shots[].node"
      }
    ]
  },
  "nodes": {
    "from": [
      {
        "doc": "../novel.story.json",
        "path": "opening"
      }
    ]
  },
  "speakers": {
    "from": [
      {
        "doc": "../novel.story.json",
        "keys": "names"
      }
    ]
  },
  "tags": {},
  "vars": {
    "from": [
      {
        "doc": "../novel.story.json",
        "keys": "vars"
      }
    ]
  },
  "version": 2
}
