    {
      "title": "Reply",
      "file": "assets/talk/yukidoke.yarn",
      "line": 125,
      "headers": [],
      "body": [
        {
          "kind": "command",
          "line": 127,
          "name": "audio",
          "args": [
            "ambience",
            "off"
          ]
        },
        {
          "kind": "command",
          "line": 128,
          "name": "bg",
          "args": [
            "desk_room",
            "grade=lamplight",
            "time=1.5"
          ]
        },
        {
          "kind": "command",
          "line": 129,
          "name": "window",
          "args": [
            "nvl"
          ]
        },
        {
          "kind": "line",
          "line": 130,
          "text": "配達のついでに封筒を渡し、次の朝には一通受け取る。"
        },
        {
          "kind": "line",
          "line": 131,
          "text": "数日で、机の木目が隠れ始めた。"
        },
        {
          "kind": "line",
          "line": 132,
          "speaker": "toma",
          "text": "白く残す線の両側を削るので、残す所ほど手が要ります。"
        },
        {
          "kind": "line",
          "line": 133,
          "speaker": "toma",
          "text": "窓の霜を写そうと、紙を当ててみました。",
          "parts": [
            {
              "text": "窓の"
            },
            {
              "markup": "ruby",
              "value": "しも"
            },
            {
              "text": "霜"
            },
            {
              "close": "ruby"
            },
            {
              "text": "を写そうと、紙を当ててみました。"
            }
          ]
        },
        {
          "kind": "line",
          "line": 134,
          "speaker": "toma",
          "text": "指で押さえた所から溶けて、枝が一本なくなりました。"
        },
        {
          "kind": "line",
          "line": 135,
          "speaker": "toma",
          "text": "版ではそこだけ太い。窓にはもう、確かめる枝もありません。"
        },
        {
          "kind": "line",
          "line": 136,
          "text": "軒下では二言で終わる人が、紙では窓の前に私を立たせる。"
        },
        {
          "kind": "command",
          "line": 137,
          "name": "window",
          "args": [
            "clear"
          ]
        },
        {
          "kind": "line",
          "line": 138,
          "text": "昨日は帰るなり横になり、便せんに触らなかった。"
        },
        {
          "kind": "line",
          "line": 139,
          "text": "今日も元気に坂を上りました、と書いて、線を引く。"
        },
        {
          "kind": "line",
          "line": 140,
          "text": "鉛筆を置いた一日は、確かにここにあった。"
        },
        {
          "kind": "options",
          "line": 141,
          "options": [
            {
              "line": 141,
              "text": "返事が遅れたのは、疲れて休んでいたからと書く",
              "body": [
                {
                  "kind": "line",
                  "line": 142,
                  "speaker": "akari",
                  "text": "昨日は疲れて、帰ってから休んでいました。"
                },
                {
                  "kind": "line",
                  "line": 143,
                  "speaker": "akari",
                  "text": "手紙を書かずに過ごす日もあります。"
                },
                {
                  "kind": "line",
                  "line": 144,
                  "text": "句点を置き、その先の余白はそのままにした。"
                },
                {
                  "kind": "set",
                  "line": 145,
                  "name": "$shared_tiredness",
                  "expr": {
                    "kind": "value",
                    "value": true
                  }
                }
              ]
            },
            {
              "line": 146,
              "text": "今日見つけた雪の形を描く",
              "body": [
                {
                  "kind": "line",
                  "line": 147,
                  "speaker": "akari",
                  "text": "窓の縁の雪です。片方だけ耳の長い兎に見えました。"
                },
                {
                  "kind": "line",
                  "line": 148,
                  "speaker": "akari",
                  "text": "右の耳は、屋根から落ちたひとかけらです。"
                },
                {
                  "kind": "line",
                  "line": 149,
                  "text": "休んだ昨日は消さず、今夜はこの絵を送る。"
                }
              ]
            }
          ]
        },
        {
          "kind": "line",
          "line": 150,
          "speaker": "akari",
          "text": "太く残った枝にも、あの朝の指の温度がありそうです。"
        },
        {
          "kind": "line",
          "line": 151,
          "text": "折った便せんの下から、臨時配達の予定表が出てきた。"
        },
        {
          "kind": "line",
          "line": 152,
          "text": "最後の日まで、あと三日。"
        },
        {
          "kind": "line",
          "line": 153,
          "text": "その先は、郵便を持って窓をたたくことができない。"
        },
        {
          "kind": "jump",
          "line": 154,
          "node": "LastDelivery"
        }
      ]
    },
