    {"name": "choice", "kind": "flag", "doc": "選択肢を出している"},
    {"name": "cursor", "kind": "num", "doc": "一番手前のカーソルの番号（0 から。確認のウィンドウ → 画面 → 選択肢 → タイトルの順に見る）"},
    {"name": "stayed", "kind": "flag", "doc": "シナリオの変数 $stayed（true の結末へ向かっている）"},
    {"name": "closeness", "kind": "num", "doc": "シナリオの変数 $closeness"}
