  "probes": [
    {"name": "phase", "kind": "text", "doc": "場面（Title・Reading・Credits）"},
    {"name": "panel", "kind": "text", "doc": "開いている画面（Closed・Log・SaveSlots・LoadSlots・Settings・Hidden）"},
    {"name": "ask", "kind": "text", "doc": "確認のウィンドウで尋ねている事（無ければ空。字の間は詰める。Load(Numbered(1),0)・ToTitle・Quit など）"},
    {"name": "tab", "kind": "text", "doc": "セーブ・ロードの画面の今のページ（Auto・Quick・Numbered(1) など。画面が閉じていれば空）"},
    {"name": "logSize", "kind": "num", "doc": "バックログの行の数"},
    {"name": "talk", "kind": "text", "doc": "開いているシナリオのノード（閉じていれば空）"},
    {"name": "talkLine", "kind": "text", "doc": "今出している行のシナリオの行（ファイル:行）"},
    {"name": "talkCursor", "kind": "text", "doc": "シナリオの実行位置（ファイル:行。<<wait>> の間は前の時間を取る演出の行・読んでいなければ空）"},
    {"name": "mode", "kind": "text", "doc": "文章の出し方（Nvl・Adv）"},
    {"name": "photo", "kind": "text", "doc": "今の背景の写真の名前（無ければ空）"},
