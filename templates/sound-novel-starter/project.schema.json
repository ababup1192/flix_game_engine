{
  "//": "project.json の形の宣言（Studio の sections 方言）。editor.resources（この一覧そのもののレジストリ）はわざと載せない — 目次を編集画面から壊さないため。保存は触った値だけを書き換えるので、載せていないフィールドが消えることはない。",
  "version": 1,
  "sections": {
    "title":         { "kind": "field", "type": "text", "label": "ゲームの題（ウィンドウのタイトルに出る）", "group": "題と画面", "order": 1, "required": true },
    "designWidth":   { "kind": "field", "type": "int", "label": "絵を描く基準の幅（px。この座標系で全部描く）", "group": "題と画面", "order": 2, "min": 160, "max": 1920, "default": 480 },
    "designHeight":  { "kind": "field", "type": "int", "label": "絵を描く基準の高さ（px。変えると見える範囲が変わる）", "group": "題と画面", "order": 3, "min": 120, "max": 1080, "default": 300 },
    "windowWidth":   { "kind": "field", "type": "int", "label": "ウィンドウの幅（px。絵の見え方は変わらない）", "group": "題と画面", "order": 4, "min": 320, "max": 3840, "default": 960 },
    "windowHeight":  { "kind": "field", "type": "int", "label": "ウィンドウの高さ（px）", "group": "題と画面", "order": 5, "min": 240, "max": 2160, "default": 600 },
    "windowScale":   { "kind": "field", "type": "int", "label": "ウィンドウの拡大率（等倍 = 1。ドットの粗さが変わる）", "group": "題と画面", "order": 6, "min": 1, "max": 8, "default": 2 },

    "maxDeltaTime":  { "kind": "field", "type": "float", "label": "1 フレームで進める秒の上限（重いときにすり抜けないための天井）", "group": "動きと文字", "order": 10, "min": 0.01, "max": 0.5, "default": 0.05 },
    "glyphs":        { "kind": "field", "type": "text", "label": "起動時に用意する字（auto=出た字から / used=ソースとアセットの字を先に / all=全字）", "group": "動きと文字", "order": 11, "default": "auto" },

    "clearColor": {
      "kind": "record",
      "label": "画面を毎フレーム塗り潰す色（0〜1。絵が全部載る下地）",
      "order": 20,
      "fields": {
        "r": { "type": "float", "label": "赤（0〜1）", "order": 1, "min": 0, "max": 1, "default": 0.137255 },
        "g": { "type": "float", "label": "緑（0〜1）", "order": 2, "min": 0, "max": 1, "default": 0.156863 },
        "b": { "type": "float", "label": "青（0〜1）", "order": 3, "min": 0, "max": 1, "default": 0.227451 }
      }
    },

    "fonts": {
      "kind": "list",
      "label": "フォント（文言を日本語にするならここを差し替える）",
      "order": 30,
      "fields": {
        "name":     { "type": "text",  "label": "コードから呼ぶ名前（default が既定のフォント）", "order": 1, "required": true },
        "path":     { "type": "text",  "label": "ファイルの場所（assets/ からの相対）", "order": 2, "required": true },
        "fontSize": { "type": "float", "label": "用意する大きさ（大きいほど拡大に強い・起動は遅い）", "order": 3, "min": 8, "max": 200, "default": 60 }
      }
    },

    "textures": {
      "kind": "list",
      "label": "読み込む画像（このゲームはドット絵を JSON で持つので空のまま）",
      "order": 31,
      "fields": {
        "name":     { "type": "text", "label": "コードから呼ぶ名前", "order": 1, "required": true },
        "path":     { "type": "text", "label": "PNG の場所（assets/ からの相対）", "order": 2, "required": true },
        "hasAlpha": { "type": "bool", "label": "透明を持つ画像か", "order": 3, "default": true }
      }
    },

    "sounds": {
      "kind": "list",
      "label": "読み込む音（このゲームはまだ無音なので空のまま）",
      "order": 32,
      "fields": {
        "name":    { "type": "text", "label": "コードから呼ぶ名前", "order": 1, "required": true },
        "path":    { "type": "text", "label": "音ファイルの場所（assets/ からの相対）", "order": 2, "required": true },
        "looping": { "type": "bool", "label": "繰り返し鳴らすか（BGM は true）", "order": 3, "default": false }
      }
    }
  }
}
