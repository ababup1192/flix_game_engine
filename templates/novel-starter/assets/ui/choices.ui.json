{
  "$schema": "ui.schema.json",
  "version": 1,
  "//": "選択肢パネル。チップは固定幅で、幅に収まらないチップは wrap(真偽値=flex)で次の行へ。ラベルの長い文言は wrap: 130(px)の文字折り返しで 2 行に折れる(流し込みは UiSlots.fill が slot0..slot5 へ。ラベル = slotN/label、クリックの意味 = slotN の meta。選べない選択肢(<<if>> が偽)は字を slotN/labelOff の @hint の色で出す)。",
  "defaultFont": "default",
  "paletteFile": "assets/ui/palette.json",

  "templates": {
    "chip": { "widget": "box", "width": 142, "height": 26, "visible": false,
              "color": "@chip", "cornerRadius": 3, "borderWidth": 1, "borderColor": "@chipBorder",
              "hover": { "color": "@chipHover", "borderColor": "@hoverEdge" },
              "zIndex": 111,
              "dir": "column", "mainAlign": "center", "crossAlign": "center",
              "children": [
                { "name": "label", "widget": "text", "text": "", "fontSize": 8,
                  "wrap": 130, "tint": "@label", "zIndex": 112 },
                { "name": "labelOff", "widget": "text", "text": "", "fontSize": 8, "visible": false,
                  "wrap": 130, "tint": "@hint", "zIndex": 112 } ] }
  },

  "root": {
    "name": "novel_choices", "visible": false,
    "children": [
      { "name": "panel", "widget": "box", "abs": [12, 170], "width": 456, "height": 48,
        "color": "@panel", "alpha": 0.92, "cornerRadius": 4, "zIndex": 110,
        "dir": "row", "wrap": true, "pad": [6, 6, 6, 6], "gap": 6,
        "children": [
          { "name": "slot0", "use": "chip" },
          { "name": "slot1", "use": "chip" },
          { "name": "slot2", "use": "chip" },
          { "name": "slot3", "use": "chip" },
          { "name": "slot4", "use": "chip" },
          { "name": "slot5", "use": "chip" }
        ] }
    ]
  }
}
