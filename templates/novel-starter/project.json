{
  "version": 1,
  "title": "消えた絵",
  "designWidth": 480,
  "designHeight": 300,
  "windowWidth": 960,
  "windowHeight": 600,
  "windowScale": 2,
  "clearColor": {"r": 0.062745, "g": 0.062745, "b": 0.109804},
  "maxDeltaTime": 0.05,
  "textures": [],
  "// glyphs": "起動時に焼く字。auto=出た字から順に焼く / used=ソースとアセットにある字を先に焼く / all=フォントの全字",
  "glyphs": "auto",
  "fonts": [
    {"name": "default", "path": "assets/PixelMplus10-Regular.ttf", "fontSize": 10.0}
  ],
  "sounds": [],
  "editor": {
    "resources": [
      {
        "id": "story",
        "pattern": "assets/novel.story.json",
        "title": "表紙の文言・灯りの数・話し手の呼び名",
        "schema": "assets/story.schema.json",
        "role": "material"
      },
      {
        "id": "theme",
        "pattern": "assets/novel.theme.json",
        "title": "色（部屋・壁・窓・灯り）",
        "schema": "assets/theme.schema.json",
        "role": "material"
      },
      {
        "id": "sprite",
        "pattern": "assets/*.sprite.json",
        "title": "ドット絵（額縁）",
        "schema": "assets/sprite.schema.json",
        "role": "material"
      },
      {
        "id": "ui",
        "pattern": "assets/ui/*.ui.json",
        "title": "画面の枠（会話窓・選択肢）",
        "schema": "assets/ui/ui.schema.json",
        "role": "material"
      },
      {
        "id": "palette",
        "pattern": "assets/ui/palette.json",
        "title": "枠の色（会話窓・選択肢ボタン・文字）",
        "role": "material"
      },
      {
        "id": "kind",
        "pattern": "assets/novel.kind.json",
        "title": "手触り（文字送り・暗さ）",
        "schema": "assets/kind.schema.json",
        "role": "tuning"
      },
      {
        "id": "keys",
        "pattern": "assets/novel.keys.json",
        "title": "操作（キーの割り当て）",
        "schema": "assets/keys.schema.json",
        "role": "tuning"
      },
      {
        "id": "scenes",
        "pattern": "assets/*.scenes.json",
        "title": "場面の説明（ギャラリーに出る題と一言）",
        "schema": "assets/scenes.schema.json",
        "role": "tuning"
      },
      {
        "id": "project",
        "pattern": "project.json",
        "schema": "project.schema.json",
        "title": "ゲームの題・画面",
        "role": "tuning"
      }
    ]
  }
}
