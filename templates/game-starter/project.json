{
  "version": 1,
  "title": "__TITLE__",
  "designWidth": __W__,
  "designHeight": __H__,
  "windowWidth": __WW__,
  "windowHeight": __WH__,
  "windowScale": 2,
  "clearColor": {"r": 0.066667, "g": 0.066667, "b": 0.101961},
  "maxDeltaTime": 0.05,
  "textures": [],
  "// glyphs": "起動時に焼く字。auto=出た字から順に焼く / used=ソースとアセットにある字を先に焼く / all=フォントの全字",
  "glyphs": "auto",
  "fonts": [
    {"name": "default", "path": "assets/Xolonium-Regular.ttf", "fontSize": 60.0}
  ],
  "sounds": [],
  "// shots": "render の場面の名前（source of truth は Shots.names。ここは bin/fge render の使い方に出す写し）。場面を足したら Shots.names と一緒にここも足す",
  "shots": ["main", "quit"],
  "// prebuild": "bin/fge の run・render の前に、deps のどれかが out より新しければ entry を流して作り直す物",
  "prebuild": [
    {"out": "assets/__NAME__.palette.json", "deps": ["assets/__NAME__.theme.json", "assets/__NAME__.sprite.json", "src/Palette.flix", "src/ThemeDoc.flix"], "entry": "Palette.write"}
  ],
  "// tasks": "ゲーム固有の作業（bin/fge task <名前> [K=V…]・Makefile に別名があれば make <名前> も）。entry はヘッドレスの入口・cmd はコマンドの並び・env は K=V の既定",
  "tasks": {
    "palette": {"entry": "Palette.write", "about": "Studio が読む色の写し（assets/__NAME__.palette.json）を無条件に作り直す（入力が新しい時は render の前に prebuild が作り直す）"},
    "atelier-preview": {"entry": "SceneRender.atelier", "about": "atelier/ の候補と assets/ の現行を debug/atelier/ に描き出す"}
  },
  "// precommit": "pre-commit で流す物の名前（tasks の名前か engine の検査の名前）",
  "precommit": ["lint-flixlint"],
  "editor": {
    "resources": [
      {
        "id": "theme",
        "pattern": "assets/__NAME__.theme.json",
        "title": "色（背景・差し色）",
        "schema": "assets/theme.schema.json",
        "role": "material"
      },
      {
        "id": "shader",
        "pattern": "assets/*.shader.json",
        "title": "空の塗り",
        "schema": "assets/shader.schema.json",
        "role": "material"
      },
      {
        "id": "sprite",
        "pattern": "assets/*.sprite.json",
        "title": "ドット絵",
        "schema": "assets/sprite.schema.json",
        "role": "material"
      },
      {
        "id": "sample",
        "pattern": "assets/sample.kind.json",
        "title": "手触り（速さ）",
        "schema": "assets/sample.schema.json",
        "role": "tuning"
      },
      {
        "id": "keys",
        "pattern": "assets/player.keys.json",
        "title": "キー割り当て（どのキーで動かすか）",
        "schema": "assets/keys.schema.json",
        "role": "tuning"
      },
      {
        "id": "scenes",
        "pattern": "assets/*.scenes.json",
        "title": "場面の説明（ギャラリーに出る題と一言）",
        "schema": "assets/scenes.schema.json",
        "role": "tuning"
      },
      {
        "id": "project",
        "pattern": "project.json",
        "schema": "project.schema.json",
        "title": "ゲームの題・画面",
        "role": "tuning"
      }
    ]
  }
}
