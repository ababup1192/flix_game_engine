  "// shots": "render の場面の名前（source of truth は Shots.names。ここは bin/fge render の使い方に出す写し）。場面を足したら Shots.names と一緒にここも足す",
  "shots": ["title", "village", "quest", "join", "world", "cave", "dungeon1", "dungeon2", "dungeon3", "battle", "magic", "item", "equip", "boss", "clear", "ending"],
  "// tasks": "ゲーム固有の作業（bin/fge task <名前> [K=V…]・Makefile に別名があれば make <名前> も）。entry はヘッドレスの入口・cmd はコマンドの並び・env は K=V の既定",
  "tasks": {
    "bot": {"entry": "BotRun.play", "about": "自動の通しプレイ（タイトルからエンディングまで）→ debug/bot.md。詰んだら 1（BOT_RUNS=本数・BOT_SEED=1 本目の種）", "env": {"BOT_RUNS": "5", "BOT_SEED": "0"}},
    "balance": {"entry": "BalanceSim.play", "about": "つり合いのシミュレーション（戦いだけ）→ debug/balance.md。知らせるだけで終了コードはいつも 0（BALANCE_SEEDS=1 組の種の数）", "env": {"BALANCE_SEEDS": "500"}}
  },
  "// precommit": "pre-commit で流す物の名前（tasks の名前か engine の検査の名前）",
  "precommit": ["lint-flixlint"],
  "editor": {
    "resources": [
      {
        "id": "rules",
        "pattern": "assets/rpg.rules.json",
        "title": "遊びの決まり（歩く・文字送り・暗転・始まり）",
        "schema": "assets/rules.schema.json",
        "role": "tuning"
      },
      {
        "id": "map",
        "pattern": "assets/maps/*.map.json",
        "title": "マップ（地図・出入口・人・小物）",
        "schema": "assets/map.schema.json",
        "role": "content"
      },
      {
        "id": "text",
        "pattern": "assets/rpg.text.json",
        "title": "言葉（話し手の呼び名・メニュー）",
        "schema": "assets/text.schema.json",
        "role": "content"
      },
      {
        "id": "party",
        "pattern": "assets/rpg.party.json",
        "title": "仲間（仲間ごとの値）",
        "schema": "assets/party.schema.json",
        "role": "content"
      },
      {
        "id": "items",
        "pattern": "assets/rpg.items.json",
        "title": "道具",
        "schema": "assets/items.schema.json",
        "role": "content"
      },
      {
        "id": "shops",
        "pattern": "assets/rpg.shops.json",
        "title": "店と宿（品・宿代）",
        "schema": "assets/shops.schema.json",
        "role": "tuning"
      },
      {
        "id": "keys",
        "pattern": "assets/rpg.keys.json",
        "title": "操作（キーの割り当て）",
        "schema": "assets/keys.schema.json",
        "role": "tuning"
      },
      {
        "id": "foes",
        "pattern": "assets/rpg.foes.json",
        "title": "敵（敵ごとの数と絵）",
        "schema": "assets/foes.schema.json",
        "role": "content"
      },
      {
        "id": "foe_moves",
        "pattern": "assets/rpg.foe_moves.json",
        "title": "敵の技（選ぶ重み）",
        "schema": "assets/foe_moves.schema.json",
        "role": "tuning"
      },
      {
        "id": "spells",
        "pattern": "assets/rpg.spells.json",
        "title": "呪文（呪文ごとの数と的）",
        "schema": "assets/spells.schema.json",
        "role": "tuning"
      },
      {
        "id": "mixer",
        "pattern": "assets/rpg.mixer.json",
        "title": "音の通り道（曲・効果音・UI のバスの音量とダッキング）",
        "role": "tuning"
      },
      {
        "id": "recolors",
        "pattern": "assets/rpg.recolors.json",
        "title": "色違い（色票の鍵の差し替え）",
        "schema": "assets/recolors.schema.json",
        "role": "material"
      },
      {
        "id": "sprite",
        "pattern": "assets/*.sprite.json",
        "title": "ドット絵（タイル・人・敵・窓）",
        "schema": "assets/sprite.schema.json",
        "role": "material"
      },
      {
        "id": "project",
        "pattern": "project.json",
        "schema": "project.schema.json",
        "title": "ゲームの題・画面",
        "role": "tuning"
      }
    ]
  },
  "web": {
    "// startupBudget": "ブラウザ版の起動の予算。開いてすぐ押した人が最初の場面を動かせるまでの 4G の秒（起動＋押した後の待ちのうちロゴで覆えない分）がこれを超えると、bin/fge export-web と web-check が止まる。16 秒を超えるなら why が要る（公開される）",
    "startupBudget": { "seconds": 16, "why": "" },
    "keysDoc": "assets/rpg.keys.json",
    "// deferred": "押して始めた後に裏で取る素材（使う順）。タイトルの曲は起動時に取る。曲（ループの音）は届く前に鳴らす所が来ても待たずに進み、届いたら鳴る。届く前の絵を描くコマは engine が出さずに待つので、絵を足す時はタイトルで使わない物だけをここへ",
    "deferred": [
      "assets/bgm/bgm_village.wav",
      "assets/bgm/bgm_world.wav",
      "assets/bgm/bgm_battle.wav",
      "assets/bgm/bgm_mine.wav",
      "assets/bgm/bgm_boss.wav"
    ],
    "virtualPad": {
      "dpad": true,
      "buttons": [
        {
          "label": "A",
          "action": "confirm"
        },
        {
          "label": "B",
          "action": "cancel"
        }
      ]
    }
  }
}
