{
  "//": "rpg.terrain.json（セル文字 → 地面の質感の表）の形の宣言（Studio の sections 方言）。色は \"#rrggbb\" か \"@キー\"（テーマの色）。edge・height・surface は入れ子が深いので生 JSON で編集する。語彙は engine_world/src/TerrainDoc.flix の冒頭。",
  "version": 1,
  "sections": {
    "styleMix": {
      "kind": "record",
      "label": "角の形の混ぜ具合",
      "description": "style が mix のマスで、丸い角と四角い角をどれだけ混ぜるか。",
      "order": 1,
      "fields": {
        "round": { "type": "float", "label": "丸い角の割合", "min": 0, "max": 1, "order": 1 },
        "square": { "type": "float", "label": "四角い角の割合", "min": 0, "max": 1, "order": 2 }
      }
    },
    "entries": {
      "kind": "list",
      "label": "質感の表（文字 → 塗り・フチ・角）",
      "order": 2,
      "fields": {
        "char": { "type": "text", "label": "マップの文字", "order": 1 },
        "name": { "type": "text", "label": "名前", "order": 2 },
        "fill": { "type": "text", "label": "塗り色（#rrggbb か @キー）", "order": 3 },
        "style": { "type": "text", "label": "角の形（round / square / diamond / mix）", "order": 4 },
        "edgeWidth": { "type": "float", "label": "フチの太さ（px）", "order": 5 },
        "jitter": { "type": "float", "label": "対角辺の岩肌の揺らぎ", "order": 6 },
        "mottle": { "type": "float", "label": "マスごとの明るさの揺らぎの最大量（0 = なし）", "order": 7 }
      }
    }
  }
}
