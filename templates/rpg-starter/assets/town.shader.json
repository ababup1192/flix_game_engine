{
  "version": 1,
  "title": "水面のゆらぎ",
  "note": "水路の動く水面（feature_lab の Water.shader.json が出発点）。Worley の網目を南へ流し（scroll.y）、snap で 2px の升目に落としてから quantize で 3 階調に量子化する — 滑らかなグラデはこの画風の禁止事項。色は岸のタイル（waterDeep/water/waterGlint）と同じ系の青緑。流れの速さ=scroll / 網目=scaled.factor / 階調数=quantize.steps / 升目の粗さ=snap.cells。",
  "name": "canal_water",
  "cycleRate": 1.0,
  "out": {
    "kind": "fill",
    "shade": {
      "kind": "ramp",
      "lo": {
        "r": 0.22,
        "g": 0.36,
        "b": 0.46
      },
      "hi": {
        "r": 0.62,
        "g": 0.8,
        "b": 0.85
      },
      "field": {
        "kind": "quantize",
        "steps": 3,
        "of": {
          "kind": "snap",
          "cells": {
            "x": 16.0,
            "y": 232.0
          },
          "of": {
            "kind": "smoothstep",
            "lo": 0.1,
            "hi": 0.7,
            "of": {
              "kind": "warp",
              "amount": 0.06,
              "scale": 3.0,
              "seed": 7,
              "of": {
                "kind": "scaled",
                "factor": 3.0,
                "scroll": {
                  "x": 0.015,
                  "y": 0.09
                },
                "of": {
                  "kind": "worley",
                  "scale": 1.0,
                  "seed": 42,
                  "out": "f2mf1"
                }
              }
            }
          }
        }
      }
    },
    "alpha": {
      "kind": "const",
      "value": 0.88
    }
  }
}
