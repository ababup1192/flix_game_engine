          ]
        },
        {
          "kind": "line",
          "line": 211,
          "text": "くろがねゴブリンは\nあなの おくへ にげていった！"
        }
      ]
    },
    {
      "title": "Mimic",
      "file": "assets/talk/rune.yarn",
      "line": 214,
      "headers": [],
      "body": [
        {
          "kind": "line",
          "line": 216,
          "text": "たからばこを あけた！"
        },
        {
          "kind": "line",
          "line": 217,
          "text": "なんと たからばこは\nひとくいばこ だった！"
        },
        {
          "kind": "command",
          "line": 218,
          "name": "fight",
          "args": [
            "mimic",
            "MimicWon"
          ]
        }
      ]
    },
    {
      "title": "MimicWon",
      "file": "assets/talk/rune.yarn",
      "line": 221,
      "headers": [],
      "body": [
        {
          "kind": "command",
          "line": 223,
          "name": "open",
          "args": [
            "b3_mimic"
          ]
        },
        {
          "kind": "command",
          "line": 224,
