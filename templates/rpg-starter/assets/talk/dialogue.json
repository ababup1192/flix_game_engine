    {
      "title": "Koron",
      "file": "assets/talk/rune.yarn",
      "line": 194,
      "headers": [],
      "body": [
        {
          "kind": "line",
          "line": 196,
          "speaker": "koron",
          "text": "まいど！ こうどうの\nぎょうしょうにん コロンです。"
        },
        {
          "kind": "line",
          "line": 197,
          "speaker": "koron",
          "text": "このさきは まっくら。\nたいまつを つかえば\nあしもとが よく みえますよ。"
        },
        {
          "kind": "command",
          "line": 198,
          "name": "shop",
          "args": [
            "mine"
          ]
        },
        {
          "kind": "line",
          "line": 199,
          "speaker": "koron",
          "text": "また どうぞ！"
        }
      ]
    },
    {
      "title": "Kurogane",
      "file": "assets/talk/rune.yarn",
      "line": 202,
      "headers": [],
      "body": [
        {
          "kind": "line",
          "line": 204,
          "speaker": "kurogane",
          "text": "グルル…\nこの おたからは わたさねえ！"
        },
        {
          "kind": "command",
          "line": 205,
          "name": "fight",
          "args": [
            "kurogane",
            "KuroganeWon"
          ]
