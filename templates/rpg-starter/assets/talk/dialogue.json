          ]
        },
        {
          "kind": "line",
          "line": 225,
          "text": "ひとくいばこを たおした！\n300G を てにいれた！"
        }
      ]
    },
    {
      "title": "Tablet",
      "file": "assets/talk/rune.yarn",
      "line": 228,
      "headers": [],
      "body": [
        {
          "kind": "line",
          "line": 230,
          "text": "いしぶみに なにか ほってある…"
        },
        {
          "kind": "line",
          "line": 231,
          "text": "「みずうみの みちは\n ひの のぼる かたより\n ひの しずむ かたへ\n さいごに ほしの みちしるべ」"
        }
      ]
    },
    {
      "title": "MinaFather",
      "file": "assets/talk/rune.yarn",
      "line": 234,
      "headers": [],
      "body": [
        {
          "kind": "if",
          "line": 236,
          "clauses": [
            {
              "line": 236,
              "condition": {
                "kind": "variable",
                "name": "$mina"
              },
              "body": [
                {
                  "kind": "line",
                  "line": 237,
                  "speaker": "father",
                  "text": "ミナ…！\nミナじゃないか！"
                },
                {
                  "kind": "line",
                  "line": 238,
                  "speaker": "mina",
                  "text": "とうちゃん！\nぶじだったんだね…！"
                },
                {
                  "kind": "line",
                  "line": 239,
                  "speaker": "father",
                  "text": "すまん しんぱいを かけた。\nあしを くじいて\nうごけなかったんだ。"
                }
              ]
            }
          ]
        },
        {
          "kind": "line",
          "line": 241,
          "speaker": "father",
          "text": "きずぐすりを わけてやろう。"
        },
        {
          "kind": "command",
          "line": 242,
          "name": "heal"
        },
        {
          "kind": "line",
          "line": 243,
          "text": "みんなの HPと MPが\nすっかり かいふくした！"
        },
        {
          "kind": "line",
          "line": 244,
          "speaker": "father",
          "text": "みずうみの すいしょうは\nひがしの あお、にしの あお、\nきたの あお の じゅんに ともすんだ。"
        },
        {
          "kind": "line",
          "line": 245,
          "speaker": "father",
          "text": "わしは ここで まっている。\nいずみを たのんだぞ。"
        }
      ]
    },
    {
      "title": "Boss",
      "file": "assets/talk/rune.yarn",
      "line": 248,
      "headers": [],
      "body": [
        {
          "kind": "if",
          "line": 250,
          "clauses": [
            {
              "line": 250,
