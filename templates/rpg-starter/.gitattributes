# 改行の決まり。Windows の core.autocrlf で sh と Makefile が CRLF になり、Git Bash の sh が
# `$'\r': command not found` で止まるのを防ぐ。
* text=auto eol=lf

*.sh             text eol=lf
Makefile         text eol=lf
*.mk             text eol=lf
bin/fge          text eol=lf
bin/headless-run text eol=lf
bin/flix         text eol=lf

# cmd.exe と PowerShell が読む物は CRLF。
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.wav   binary
*.ogg   binary
*.mp3   binary
*.glb   binary
*.jar   binary
*.fpkg  binary
*.zip   binary
*.exe   binary
*.wasm  binary
