#!/usr/bin/env bash
# flix ラッパ。CWD が ide/ 配下のときは AWT/Swing 用に -XstartOnFirstThread を付けない。
# それ以外 (engine, editor, ゲームの GLFW ベース) では macOS のときだけ AppKit 要件のため付ける
# (Linux/CI の JVM は -XstartOnFirstThread を拒否するので付けない)。
#
# IDE モードかつ `run` サブコマンドのときに限り、起動前に
# `make -C <project_root> clean-game-builds` を呼ぶ。
# ProjectLoader.findSceneFiles の Fs.Glob が templates/*/build/class 配下の
# 数十万 .class ファイルを stat して数分かかる問題を回避するため。
# (clean したぶん incremental compile のキャッシュは失われる)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
case "$PWD" in
    */ide|*/ide/*)
        if [ "$1" = "run" ]; then
            make -C "$PROJECT_ROOT" clean-game-builds >&2
        fi
        FLAGS=""
        ;;
    *)
        # -XstartOnFirstThread は macOS の GLFW/AppKit がメインスレッドを要求するための専用フラグ。
        # Linux/CI の JVM はこのオプションを知らず「Could not create the Java VM」で起動失敗するので、
        # Darwin のときだけ付ける (build-pkg/check だけを回す CI では不要でもある)。
        FLAGS=""
        if [ "$(uname)" = "Darwin" ]; then
            FLAGS="-XstartOnFirstThread"
        fi
        # test と描き出し (run --entrypoint SceneRender.*) はヘッドレス処理 (実ウィンドウを開かない) なので
        # java.awt.headless=true を明示する。-XstartOnFirstThread 下でワーカースレッドが
        # AWT を初期化 (HeadlessFont → BufferedImage) すると AppKit 待ちで永久ハングし得るため。
        # ゲーム実機起動 (通常の run) には付けない。
        case "$1 $*" in
            test\ *|test) FLAGS="$FLAGS -Djava.awt.headless=true" ;;
            *"--entrypoint SceneRender"*) FLAGS="$FLAGS -Djava.awt.headless=true" ;;
            *)
                # editor_server (常駐 HTTP サーバ) の run も実ウィンドウを開かないので headless。
                # HTTP ワーカースレッドが AWT を初期化すると上記と同じ AppKit 待ちハングになり得る。
                case "$PWD" in
                    */editor_server|*/editor_server/*) FLAGS="$FLAGS -Djava.awt.headless=true" ;;
                esac
                ;;
        esac
        ;;
esac

# コンパイラ jar の入手は devbox (flix.nix) に任せ、実行は手元の java で行う。
# flix.nix の flix コマンドを直に exec しないのは、それが自分専用の JRE を同梱していて
# こちらの jdk (devbox の jdk@21) と別マイナー版になり、フォント計測がわずかにズレて
# 描画スナップショットが崩れるため。jar だけ nix store から借り、JRE は固定する。
# 見つけ方: PATH 上の flix コマンドのうち /nix/store 実体に解決されるものを取り、
# その隣の share/java/flix/flix.jar を使う (nixpkgs の flix パッケージの配置)。
# 環境変数 FLIX_JAR が実在の jar を指していれば、それを最優先で使う（新しい版のコンパイラを
# devbox を作り直す前に試すときの口）。
if [ -n "${FLIX_JAR:-}" ] && [ ! -f "$FLIX_JAR" ]; then
    echo "FLIX_JAR が指す jar がありません: $FLIX_JAR" >&2
    exit 127
fi
FLIX_JAR="${FLIX_JAR:-}"
while [ -z "$FLIX_JAR" ] && IFS= read -r candidate; do
    real="$(readlink -f "$candidate" 2>/dev/null)"
    case "$real" in
        /nix/store/*)
            jar="$(dirname "$(dirname "$real")")/share/java/flix/flix.jar"
            if [ -f "$jar" ]; then FLIX_JAR="$jar"; break; fi
            ;;
    esac
done < <(type -aP flix)

# devbox シェルの外 (素のターミナル・Studio の .app 等) では PATH に flix が居ない。
# engine 自身の devbox profile から直接借りる — new-game で産まれたゲームの
# make check が「シェルの入り方」で失敗しないように。
if [ -z "$FLIX_JAR" ]; then
    for prof in "$PROJECT_ROOT/.devbox/nix/profile/default/bin/flix"; do
        real="$(readlink -f "$prof" 2>/dev/null)"
        case "$real" in
            /nix/store/*)
                jar="$(dirname "$(dirname "$real")")/share/java/flix/flix.jar"
                if [ -f "$jar" ]; then FLIX_JAR="$jar"; break; fi
                ;;
        esac
    done
fi

# nix が無ければ手動配置の bin/flix.jar にフォールバック。
if [ -z "$FLIX_JAR" ] && [ -f "$SCRIPT_DIR/flix.jar" ]; then
    FLIX_JAR="$SCRIPT_DIR/flix.jar"
fi

if [ -z "$FLIX_JAR" ]; then
    echo "flix.jar が見つかりません。devbox shell に入るか、bin/flix.jar を配置してください。" >&2
    exit 127
fi

# java も同じ理由で devbox の外に備える: PATH の java が使えなければ engine の devbox の jdk を使う。
# 居るかどうか (command -v) では見ないのは、macOS には必ず /usr/bin/java という
# 「Java を入れてください」と言うだけのスタブが居て、本物と見分けが付かないため。
# Studio の .app から起こした make は PATH が /usr/bin:/bin:... しか無く、必ずこれを掴む。
JAVA_CMD="java"
if ! java -version >/dev/null 2>&1; then
    JAVA_CMD="$PROJECT_ROOT/.devbox/nix/profile/default/bin/java"
fi
if ! "$JAVA_CMD" -version >/dev/null 2>&1; then
    echo "java が見つかりません。devbox shell に入るか、PATH に JDK を通してください。" >&2
    exit 127
fi
# WhyNot: JVM の既定のスタックに任せないのは、Flix の型検査が式の深さぶんだけ
# 再帰するため。既定は OS で違い、Linux は macOS より小さいので、手元で通るソースが
# CI でだけ StackOverflowError になる。-Xss は仮想アドレスを予約するだけで、
# 実メモリは使った分しか要らない。
# ヒープの上限は物理メモリの 50%（GC は JVM の既定 = G1）。flix run はコンパイラとゲームが 1 つの JVM を
# 分け合い、上限が足りないと Flix の最適化 (Inliner) が OutOfMemoryError になる。既定の 25% は
# 16GB の機械で 4GB で、大きなゲームでは足りないことがある（2026-10-14・Studio の server の
# EngineTasks.memoryArgs と .app の engine/flix と同じ値）。絶対値 (-Xmx) にしないのは、ゲームが育つと山も育つため。
exec "$JAVA_CMD" -Xss32m -XX:MaxRAMPercentage=50 $FLAGS -jar "$FLIX_JAR" "$@"
