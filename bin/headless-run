#!/usr/bin/env bash
# headless-run — 描き出しの入口（`flix run --entrypoint X` の X と同じ字）を、先に作った jar から流す。
#
# 使い方（ゲームの根で）:
#   headless-run <モジュール.関数>          例: headless-run SceneRender.all   窓なしで流す（描き出し・動画・長い計算）
#   headless-run --window <入口>           窓ありで流す（GL を開く入口。main はファイル直下の def main() = 遊ぶ入口で、
#                                          make run・Studio のプレイが使う。DEBUG=true などの環境変数はそのまま通る）
#   headless-run --build-only              jar を新しくするだけで流さない（Studio が開いた時・保存の後に裏で呼ぶ）
#   headless-run --status                  jar が新しいかを 1 語で答えるだけ（作らない・鍵も取らない）:
#                                          fresh（新しい）・stale（作り直しが要る）・failed（前に作れず、src は変わっていない）・
#                                          building（他の人が作っている）。終わりの番号は 0（形の誤りだけ 2）
#
# --window の旗: Darwin は -XstartOnFirstThread（GLFW がメインスレッドを要る）を付け、-Djava.awt.headless=true は付けない
# （bin/flix の run と同じ分け方）。常駐が「GL が要る」と答えた入口（終了コード 124・x needs-gl）も、この旗で流し直す。
#
# flix run は呼ぶたびにパッケージ全体をコンパイルし直す（1 回 30 秒〜数分）。ここでは
# src・flix.toml・lib のどれかが変わった時だけ jar を 1 本作り直し、あとは java -jar で流す。
# 動画を何本も続けて描く・make render で 1 枚だけ描く、のどちらもコンパイルの分だけ速くなる。
#
# 入口の拾い方: src の `pub def 名前(): Unit \ IO =`（引数なし・効果は IO だけ・1 行）を全部拾い、
# 環境変数 FGE_ENTRY で選ぶ小さな main（FgeHeadlessMain）を足してから jar にする。
# Flix は main から届かない関数を jar に入れないので、入口を main に並べておく必要がある。
# 拾えない形の入口（引数あり・別の効果つき・複数行・mod が 2 つ以上あるファイル）は flix run に回す。
# jar を作れなかった時は、エラーの最後を見せて止める（FGE_HEADLESS_FALLBACK=1 の時だけ flix run で続ける）。
#
# jar が古いかは中身の指紋（bin/fge resident manifest: src・flix.toml・lib の中身の SHA-256。lib/github は flix.toml と
# packages.lock に名前のある版だけ）を build/headless/jar.manifest と比べて決める。bin/fge-go が無い時だけ更新時刻で決める。
#
# HEADLESS_RESIDENT=1 なら、jar を確かめた後にまずゲームの根の常駐（窓なしのゲーム・既定の入口 E2e.serveHeadless）
# へ頼む（bin/fge resident run）。常駐を使えない時（終了コード 125）だけ下の java -jar で流す。
#
# jar の置き場: build/headless/（git に入れない）。作る場所は build/headless/proj で、
# ゲームの src を写した上に FgeHeadlessMain.flix を足す（ゲームの src には何も書かない）。
# 2 本の make が同時に来ても作るのは 1 本だけ（build/headless/.lock で順番に。鍵に作り手の pid を
# 書き、作り手が落ちていたら次の人が外す。15 分待っても空かなければ flix run で流す）。
# 作り直しは別名で書いてから mv するので、走っている JVM の jar は消えない。
# 作れなかった時は build/headless/.failed に印（エラーの最後の 15 行）を、.failed.manifest に作れなかった時の中身の指紋を残し、
# 指紋が変わるまで作り直さない
# （作れない状態のまま毎回コンパイルを 2 回払わないため）。jar を作り直させたい時は rm -rf build/headless。
#
# 作り終えたら「[headless-run] jar を作った（N 秒）」を出し、N を build/headless/last-build-seconds に残す。
#
# jar を分け合う（docs/design/prebuilt-jar.md）: 作る前に、段 1（この機械の ~/.cache/flix-headless-jar/<鍵>/）、段 2（ゲームの repo の
# Release headless-jar-cache・gh で取る・30 秒で諦める）の順に見て、鍵と中身の SHA-256 が合えば写して使い
# （「[headless-run] 先に作った jar を使う（段 1 か 2・N 秒）」）、作ったら段 1 へ置く。段 2 へ上げるのは作り手だけ（FGE_JAR_PUBLISH_REMOTE=1）。
# 鍵は元の指紋（src・flix.toml・packages.lock。lib は lock が決める）・入口の束・コンパイラの jar・作り方の版（headless_revision）から作る。
# packages.lock が無いゲームは分け合わない。FGE_JAR_CACHE=off で段 1 も段 2 も使わない・FGE_PREBUILT_JAR=off で段 2 を使わない。
#
# 環境変数: FGE_HEADLESS_FALLBACK=1 = jar を作れない時も flix run で続ける（既定は止める）。
#           FLIX_CMD = jar を作る flix（既定はこのエンジンの bin/flix）。1 語のパスで渡す
# （相対パスはここで絶対パスにする — jar は build/headless/proj へ移って作るため）。
#           JAVA = jar を流す java（既定は PATH の java、無ければエンジンの devbox の java）。
#           HEADLESS_JAVA_OPTS = java へ足す旗（既定の旗の後ろに付くので上書きできる。例: -Xss64m）。
#           jar から流す時だけ効く（flix run へ回った時は bin/flix の旗のまま）。
set -euo pipefail

usage() {
    echo "使い方: headless-run [--window] <モジュール.関数 | main> | --build-only | --status   (ゲームの根で。例: headless-run SceneRender.all・headless-run --window main)" >&2
    exit 2
}
mode=run
gl=0
entry=""
while [ $# -gt 0 ]; do
    case "$1" in
        --window)     gl=1 ;;
        --build-only) mode=build ;;
        --status)     mode=status ;;
        -*)           usage ;;
        *)            [ -z "$entry" ] || usage; entry=$1 ;;
    esac
    shift
done
if [ "$mode" = run ] && [ -z "$entry" ]; then usage; fi
if [ "$mode" != run ] && { [ -n "$entry" ] || [ "$gl" = 1 ]; }; then usage; fi
engine="$(cd "$(dirname "$0")/.." && pwd)"
flix="${FLIX_CMD:-$engine/bin/flix}"
case "$flix" in
    /*) ;;
    */*) flix="$PWD/$flix" ;;
esac
out=build/headless
jar=$out/headless.jar
proj=$out/proj
main=FgeHeadlessMain
fge_go="$engine/bin/fge-go"
# 作り方の版。入口の拾い方（list_entries）か入口の束の書き方（build_dispatcher）を変えたら 1 上げる
# （段 1 の鍵に混ぜるので、前の作り方の jar を分け合わない）。
headless_revision=1

if [ ! -d src ] || [ ! -f flix.toml ]; then
    echo "headless-run: ゲームの根（src/ と flix.toml のある所）で呼んでください" >&2
    exit 2
fi

# src から入口を拾う。mod の行より後の pub def をそのモジュールの物とする。mod が 2 つ以上ある
# ファイル（入れ子を含む）はどの mod の物か行だけでは決められないので、丸ごと拾わない。
# mod の無いファイルの `def main(): Unit \ IO =`（窓ありで遊ぶ入口）は main として拾う。
list_entries() {
    find src -name '*.flix' | LC_ALL=C sort | while IFS= read -r f; do
        mods=$(grep -cE '^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]' "$f" || true)
        if [ "$mods" = 0 ]; then
            if grep -qE '^def[[:space:]]+main\(\):[[:space:]]*Unit[[:space:]]*\\[[:space:]]*IO[[:space:]]*=' "$f"; then echo main; fi
            continue
        fi
        [ "$mods" = 1 ] || continue
        sed -nE \
            -e 's/^[[:space:]]*(pub[[:space:]]+)?mod[[:space:]]+([A-Za-z0-9_.]+).*/M \2/p' \
            -e 's/^[[:space:]]*pub[[:space:]]+def[[:space:]]+([A-Za-z0-9_]+)\(\):[[:space:]]*Unit[[:space:]]*\\[[:space:]]*IO[[:space:]]*=.*/D \1/p' \
            "$f" | awk '$1 == "M" { m = $2 } $1 == "D" && m != "" { print m "." $2 }'
    done
}

# jar を使わずに flix run で流す。HEADLESS_JAVA_OPTS はここでは効かない（旗は bin/flix の物）ので知らせる。
# 拾えない形の入口以外（jar を作れなかった・鍵が空かない）は止める。flix run に落とすと毎回の全量
# コンパイルで数分遅くなり、測った時間も狂ったまま気づけない。続けたい時だけ FGE_HEADLESS_FALLBACK=1。
loud_fallback() {
    {
        echo "================================================================"
        echo "[headless-run] jar を使えません — $1"
        if [ -s "$out/.failed" ]; then
            echo "  作った時のエラーの最後（$out/build.log）:"
            sed 's/^/    /' "$out/.failed"
        fi
        echo "  理由を直すと src が新しくなり次から作り直す。rm -rf build/headless でも作り直す。"
        if [ "${FGE_HEADLESS_FALLBACK:-}" = 1 ]; then
            echo "  FGE_HEADLESS_FALLBACK=1 なので flix run（全量コンパイル）で流す — この回は数分遅く、測った時間は jar の時と比べられない。"
        else
            echo "  止めます（flix run で続けたい時だけ FGE_HEADLESS_FALLBACK=1）。"
        fi
        echo "================================================================"
    } >&2
    if [ "${FGE_HEADLESS_FALLBACK:-}" = 1 ]; then run_with_flix; fi
    exit 3
}

run_with_flix() {
    if [ -n "${HEADLESS_JAVA_OPTS:-}" ]; then
        echo "[headless-run] flix run で流すので HEADLESS_JAVA_OPTS（${HEADLESS_JAVA_OPTS}）は効かない（深い再帰はスタックが足りずに落ちうる）" >&2
    fi
    if [ "$entry" = main ]; then exec "$flix" run; fi
    exec "$flix" run --entrypoint "$entry"
}

# 中身の指紋はこの起動で 1 回だけ作る（src と lib を全部読むので、呼ぶたびに作ると 1 枚撮りの頭で
# 何度も払う）。bin/fge-go が無い・作れない時は空。
manifest_start=""
if [ -x "$fge_go" ]; then
    manifest_start=$("$fge_go" resident manifest . 2>/dev/null || true)
fi

# 入口の一覧は、指紋が前回と同じなら前回の物を使う。
# WhyNot: 毎回 list_entries しない — src の .flix ごとに grep・sed・awk を起こすので、
# internet_dungeon では 1 枚撮り 1.28 秒のうち 0.74 秒をこれが占めた（2026-10-19 実測）。
# 指紋は src の中身から作るので、入口が増えた・消えた時は必ず指紋が変わり、作り直しになる。
entries_cache=$out/entries.cache
if [ -n "$manifest_start" ] && [ "$(head -1 "$entries_cache" 2>/dev/null)" = "$manifest_start" ]; then
    entries="$(tail -n +2 "$entries_cache")"
else
    entries="$(list_entries)"
    if [ -n "$manifest_start" ]; then
        mkdir -p "$out"
        { printf '%s\n' "$manifest_start"; printf '%s\n' "$entries"; } > "$entries_cache.tmp.$$"
        mv "$entries_cache.tmp.$$" "$entries_cache"
    fi
fi
if [ "$mode" = run ] && ! printf '%s\n' "$entries" | grep -qxF "$entry"; then
    # 拾えない形の入口は今までどおりコンパイルして流す。
    run_with_flix
fi

build_dispatcher() {
    echo "// 自動生成（エンジンの bin/headless-run）。手で直さない。"
    echo "// 環境変数 FGE_ENTRY の名前の入口を 1 つ流す（main はファイル直下の def main()。だから関数の名前は main にしない）。"
    echo "mod $main {"
    echo "    import java.lang.System"
    echo ""
    echo "    pub def dispatch(): Unit \\ IO ="
    echo "        let name = System.getenv(\"FGE_ENTRY\");"
    echo "        match name {"
    printf '%s\n' "$entries" | while IFS= read -r e; do
        echo "            case \"$e\" => $e()"
    done
    echo "            case _ => bug!(\"headless-run: 知らない入口 \${name}\")"
    echo "        }"
    echo "}"
}

# 中身の指紋（64 字）。bin/fge-go が無い・指紋を作れない時は空。
manifest_now() {
    printf '%s' "$manifest_start"
}

# jar が古いか: 無い・入口の一覧が変わった・中身の指紋が jar を作った時と違う
# （指紋を作れない時は src / flix.toml / lib のどれかが jar より新しい）。
is_stale() {
    [ -f "$jar" ] || return 0
    [ -f "$proj/src/$main.flix" ] || return 0
    [ "$(build_dispatcher)" = "$(cat "$proj/src/$main.flix")" ] || return 0
    now=$(manifest_now)
    if [ -n "$now" ]; then
        [ "$now" = "$(cat "$out/jar.manifest" 2>/dev/null)" ] || return 0
        return 1
    fi
    [ -z "$(newer_than "$jar")" ] || return 0
    return 1
}

# src・flix.toml・lib のうち、$1 より新しい物（1 件だけ）。-L で lib の中の symlink の先も見る。
newer_than() {
    find -L src flix.toml lib -newer "$1" -print 2>/dev/null | head -1
}

# 前に作れなかった時から、入力が何も変わっていないか（.failed.manifest には作れなかった時の指紋が入っている）。
failed_before() {
    [ -f "$out/.failed" ] || return 1
    now=$(manifest_now)
    if [ -n "$now" ]; then
        [ "$now" = "$(cat "$out/.failed.manifest" 2>/dev/null)" ]
        return
    fi
    [ -z "$(newer_than "$out/.failed")" ]
}

# 作れたら 0。jar.manifest には、作り終えた後に jar を作った写し（$proj: 写した src・flix.toml・lib）から取った指紋を書く
# — 作っている間に flix が lib へ依存を落とす（版を上げた直後の 1 回目）ので、作り始めの指紋だと次の回にまた作り直す。
# 写しの src は作り始めに写した物なので、作っている最中にゲームの src を保存すれば次の回に「jar と違う」と気づける。
# jar の時刻は「src を写し始めた時刻」にそろえる（指紋を作れない時の更新時刻の比べのため）。
# 作った秒数は build/headless/last-build-seconds に残す（Studio が「jar を作っています」の見込みに出す）。
build_jar() {
    touch "$out/.started"
    build_began=$(date +%s)
    started_manifest=$(manifest_now)
    rm -rf "$proj/src" "$proj/artifact"
    mkdir -p "$proj"
    cp -R src "$proj/src"
    cp flix.toml "$proj/flix.toml"
    # packages.lock もゲームの物にそろえる（無ければ消す）。前に作った時の lock が残ると、engine の fpkg を
    # 手元で作り直した後（engine の開発・use-engine）に「packages.lock の記録と違う」で作れなくなる。
    if [ -f packages.lock ]; then cp packages.lock "$proj/packages.lock"; else rm -f "$proj/packages.lock"; fi
    # lib はゲームの根の物を繋ぐ（無ければ作る）— flix が作っている間に落とす依存をゲームの lib に置き、
    # 写しから取る指紋とゲームの根から取る指紋をそろえるため。
    mkdir -p lib
    ln -sfn "$PWD/lib" "$proj/lib"
    build_dispatcher > "$proj/src/$main.flix"
    echo "[headless-run] jar を作る（src か lib が変わった）" >&2
    # 作った時の出力は build.log にも残す（作れなかった理由を、次からの回の知らせでも見せるため）。
    # pipefail（頭の set）なので、作るのに失敗すれば tee が成功しても列全体が失敗になる。
    if ! (cd "$proj" && "$flix" build-fatjar --entrypoint "$main.dispatch") 2>&1 | tee "$out/build.log" >&2; then
        return 1
    fi
    built=$(ls "$proj"/artifact/*.jar 2>/dev/null | head -1)
    [ -n "$built" ] || return 1
    mv "$built" "$jar.tmp.$$"
    touch -r "$out/.started" "$jar.tmp.$$"
    mv "$jar.tmp.$$" "$jar"
    built_seconds=$(( $(date +%s) - build_began ))
    printf '%s\n' "$built_seconds" > "$out/last-build-seconds.tmp.$$"
    mv "$out/last-build-seconds.tmp.$$" "$out/last-build-seconds"
    echo "[headless-run] jar を作った（${built_seconds} 秒）" >&2
    built_manifest=""
    if [ -n "$started_manifest" ] && [ -x "$fge_go" ]; then
        built_manifest=$("$fge_go" resident manifest "$proj" 2>/dev/null || true)
    fi
    # 指紋を作れなかった回は古い jar.manifest を残さない — 常駐が古い指紋のまま「同じ jar」と答えるため。
    if [ -n "$built_manifest" ]; then
        printf '%s\n' "$built_manifest" > "$out/jar.manifest.tmp.$$"
        mv "$out/jar.manifest.tmp.$$" "$out/jar.manifest"
    else
        rm -f "$out/jar.manifest"
    fi
}

# 鍵を生きている誰かが持っているか。
lock_held() {
    owner=$(cat "$out/.lock/pid" 2>/dev/null || true)
    [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null
}

if [ "$mode" = status ]; then
    if lock_held; then echo building
    elif ! is_stale; then echo fresh
    elif failed_before; then echo failed
    else echo stale
    fi
    exit 0
fi

# 段 1 の鍵に混ぜるコンパイラの jar（engine の bin/flix が使う物）。FLIX_CMD で別の flix を渡された時は空（分け合わない）。
# WhyNot: 別の flix でも分け合わない — その flix がどの jar で組むかを決められず、違うコンパイラの jar を使いうる。
shared_flix_jar() {
    [ "$flix" = "$engine/bin/flix" ] || return 1
    # 標準入力は閉じて渡す — bin/flix が FLIX_PRINT_JAR を知らないラッパ（Studio 同梱の engine の物など）に置き換わっていると、
    # 素の java -jar flix.jar = REPL になり、開いた標準入力を待って jar 作りごと止まる（依頼主の Mac で 8 分止まった）。
    found=$(FLIX_PRINT_JAR=1 "$flix" </dev/null 2>/dev/null) || return 1
    # 返った字が 1 行で .jar で終わる実在のファイルの時だけ分け合う（REPL の出力などを jar のパスと取り違えない）。
    case "$found" in
        *"
"*) return 1 ;;
        *.jar) ;;
        *) return 1 ;;
    esac
    [ -f "$found" ] || return 1
    printf '%s' "$found"
}

# 段 1 から鍵の jar を取って build/headless へ写す。写せたら 0（作らなくてよい）。
try_shared_jar() {
    [ -x "$fge_go" ] && [ -n "$manifest_start" ] || return 1
    flix_jar=$(shared_flix_jar) || return 1
    dispatcher_file="$out/dispatcher.tmp.$$"
    build_dispatcher > "$dispatcher_file"
    shared_began=$(date +%s)
    if stage=$("$fge_go" jar fetch --dir=. --dispatcher="$dispatcher_file" --flix-jar="$flix_jar" --revision="$headless_revision" --manifest="$manifest_start" 2>/dev/null); then
        rm -f "$dispatcher_file"
        echo "[headless-run] 先に作った jar を使う（段 ${stage}・$(( $(date +%s) - shared_began )) 秒）" >&2
        return 0
    fi
    rm -f "$dispatcher_file"
    return 1
}

# 作った jar を段 1 へ置き、古い物を消す。作り手（jar builder run が FGE_JAR_PUBLISH_REMOTE=1 で起こす）は段 2 へも上げる。
# 置けなくても描き出しは止めない。
# 引数 1 に元の指紋を取る所（ゲームの根からの相対）を渡せる（段 1 から取った時は . — 作った写しには src が無い）。
publish_shared_jar() {
    [ -x "$fge_go" ] || return 0
    flix_jar=$(shared_flix_jar) || return 0
    remote=""
    if [ "${FGE_JAR_PUBLISH_REMOTE:-}" = 1 ]; then remote="--remote"; fi
    source_dir=""
    if [ -n "${1:-}" ]; then source_dir="--source-dir=$1"; fi
    "$fge_go" jar publish --dir=. --dispatcher="$proj/src/$main.flix" --flix-jar="$flix_jar" --revision="$headless_revision" \
        $remote $source_dir --commit="${FGE_JAR_COMMIT:-}" >&2 || true
    "$fge_go" jar prune >/dev/null 2>&1 || true
}

if is_stale; then
    mkdir -p "$out"
    lock="$out/.lock"
    # 鍵はフォルダ + 作り手の pid。作り手がもう居なければ（落ちた・止められた）外して取り直す。
    # 外すのは別名への mv 1 回だけ — 2 人が同時に古い鍵を見ても、外せるのは 1 人で、
    # その後に取り直された新しい鍵を消してしまうことはない。
    waited=0
    until mkdir "$lock" 2>/dev/null; do
        owner=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            if mv "$lock" "$lock.stale.$$" 2>/dev/null; then rm -rf "$lock.stale.$$"; fi
            continue
        fi
        [ "$waited" = 0 ] && echo "[headless-run] pid ${owner:-?} が jar を作っているので待つ" >&2
        waited=$((waited + 2))
        if [ "$waited" -ge 900 ]; then
            loud_fallback "15 分待っても jar を作る鍵が空かない（鍵: $lock）"
        fi
        sleep 2
    done
    echo $$ > "$lock/pid"
    trap 'rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true' EXIT
    # 待っている間に他の make が作り終えていれば、もう一度作らない。
    built_ok=1
    if failed_before; then built_ok=0
    elif is_stale; then
        # WhyNot: 段 1 から取った時も作り手は段 2 へ上げる — この機械の別の作業場が先に作っていても、段 2 にはまだ無いことがある。
        if try_shared_jar; then
            rm -f "$out/.failed" "$out/.failed.manifest"
            if [ "${FGE_JAR_PUBLISH_REMOTE:-}" = 1 ]; then publish_shared_jar .; fi
        elif build_jar; then rm -f "$out/.failed" "$out/.failed.manifest"; publish_shared_jar
        else
            built_ok=0
            # 色の符号を落とした最後の 15 行（MethodTooLargeException などの理由が見える所）。
            { sed 's/\x1b\[[0-9;]*m//g' "$out/build.log" 2>/dev/null | grep -v '^[[:space:]]*$' || true; } | tail -15 > "$out/.failed"
            printf '%s\n' "${started_manifest:-}" > "$out/.failed.manifest"
            touch -r "$out/.started" "$out/.failed"
        fi
    fi
    rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true
    trap - EXIT
    if [ "$built_ok" = 0 ]; then
        if [ "$mode" = build ]; then
            { echo "[headless-run] jar を作れなかった（$out/build.log）"; sed 's/^/    /' "$out/.failed" 2>/dev/null || true; } >&2
            exit 3
        fi
        loud_fallback "jar を作れなかった（JVM のメソッドが大きすぎる MethodTooLargeException もここに来る）"
    fi
fi

# java の旗は bin/flix と同じ（深い再帰のための -Xss32m・ヒープは物理メモリの 50%）。描き出しは窓を開かないので headless。
java_cmd="${JAVA:-java}"
if ! "$java_cmd" -version >/dev/null 2>&1; then
    java_cmd="$engine/.devbox/nix/profile/default/bin/java"
fi

# jar を作り直した回は、語彙を書き出す入口（名前が .vocab で終わる物。flow の E2e.vocab など）を全部流す。
# Go の検査（bin/fge flow check など）は JVM なしで語彙の JSON を読むので、src の表を直した後に古い語彙で止めないため。
if [ "${built_ok:-0}" = 1 ]; then
    # WhyNot: grep をそのまま列に置かない — .vocab の入口が無いゲームでは grep が 1 を返し、
    # pipefail と set -e で何も言わずに抜ける。
    printf '%s\n' "$entries" | { grep -E '\.vocab$' || true; } | while IFS= read -r vocab; do
        [ "$vocab" = "$entry" ] && continue
        FGE_ENTRY="$vocab" "$java_cmd" -Xss32m -Djava.awt.headless=true -jar "$jar" >&2 || true
    done
fi
if [ "$mode" = build ]; then
    exit 0
fi
# 常駐に頼む（HEADLESS_RESIDENT=1 の時だけ。既定は今の java -jar。常駐は GL を持たないので --window は頼まない）。
# 125 は「常駐を使えなかった」で下の java -jar へ、124 は「GL が要る」で GL の旗の java -jar へ進む。
# それ以外は入口の終了コードなのでそのまま返す。
resident_entry="${HEADLESS_RESIDENT_ENTRY:-E2e.serveHeadless}"
if [ "$gl" = 0 ] && [ "${HEADLESS_RESIDENT:-}" = 1 ] && [ "$entry" != "$resident_entry" ] && [ -x "$fge_go" ]; then
    rc=0
    HEADLESS_ENTRIES="$(printf '%s\n' "$entries" | paste -sd' ' -)" \
        "$fge_go" resident run --entry "$entry" --dir . --java "$java_cmd" || rc=$?
    case "$rc" in
        125) ;;
        124) gl=1 ;;
        *)   exit "$rc" ;;
    esac
fi
# 窓なしは headless に固定（-XstartOnFirstThread の下で AWT が AppKit を待って固まらないため）。
# GL を開く入口は bin/flix の run と同じく、Darwin だけ -XstartOnFirstThread を付けて headless にしない。
if [ "$gl" = 1 ]; then
    java_flags="-Xss32m -XX:MaxRAMPercentage=50"
    if [ "$(uname)" = Darwin ]; then java_flags="$java_flags -XstartOnFirstThread"; fi
else
    java_flags="-Xss32m -XX:MaxRAMPercentage=50 -Djava.awt.headless=true"
fi
# HEADLESS_JAVA_OPTS は空白で分けて既定の後ろに足す（同じ旗は後ろが勝つ）。
# shellcheck disable=SC2086
FGE_ENTRY="$entry" exec "$java_cmd" $java_flags ${HEADLESS_JAVA_OPTS:-} -jar "$jar"
