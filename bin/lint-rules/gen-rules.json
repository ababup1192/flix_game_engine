{
  "note": "gen-rules（docs/ の規約から .claude/rules/*.md を作る）の規約データ。この JSON が source of truth で、bin/fge gen-rules はこれを読んで動く。rules は並びが出力の行順になるので配列で持つ（JSON のオブジェクトは並びを保てない）。",
  "banner": "<!-- generated by bin/fge gen-rules from {src} — 編集しないで。本文は {src} を直して make rules -->",
  "rules": [
    {
      "out": "drawing.md",
      "src": "docs/drawing-floor.md",
      "globs": [
        "**/View*.flix",
        "**/src/render/*.flix",
        "**/src/hand/*.flix",
        "**/*Hand.flix",
        "**/*Scene.flix",
        "**/*Map.flix",
        "**/*View.flix",
        "**/*Screen.flix",
        "**/*Art.flix",
        "**/bin/gen-*.py",
        "**/*.anim.json",
        "**/*.sprite.json",
        "**/*.theme.json",
        "**/*.palette.json",
        "**/*.fx.json",
        "**/*.shader.json"
      ]
    },
    {
      "out": "flix.md",
      "src": "docs/flix-conventions.md",
      "globs": ["**/*.flix"]
    },
    {
      "out": "error-handling.md",
      "src": "docs/error-handling.md",
      "globs": ["**/*.flix"]
    }
  ],
  "outDirs": [".claude/rules", "agents-pack/rules"]
}
