#!/usr/bin/env python3
# flix check のフェーズ別の秒数を出す。使い方: bin/check-phases [パッケージdir]（省略時はカレント）
#
# WhyNot: --Xbenchmark-phases を使わないのは、あれがコンパイラ自身のテスト一式を
# 対象にする物で、プロジェクトのソースには掛からないため。check の進捗表示（TTY の
# ときだけ出る `[spinner] [メモリ] [フェーズ名]`）を擬似端末で受け、フェーズ名が
# 切り替わった時刻の差を数える。数字は同時に走っている物に引きずられるので、
# 比べるときは同じ負荷で交互に測る。
import collections, os, pty, re, select, sys, time

engine_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
flix = os.path.join(engine_root, "bin", "flix")
cwd = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else ".")
os.chdir(cwd)

pid, fd = pty.fork()
if pid == 0:
    os.environ["COLUMNS"] = "200"
    os.execv(flix, [flix, "check"])

ansi = re.compile(rb"\x1b\[[0-9;]*[A-Za-z]")
phase = re.compile(r"\[\s*\d+M\]\s*\[([A-Za-z0-9]+)\s*\]")
times = collections.OrderedDict()
t0 = time.time()
cur, cur_t = None, t0


def on_segment(seg):
    global cur, cur_t
    m = phase.search(ansi.sub(b"", seg).decode("utf-8", "replace"))
    if not m:
        return
    name = m.group(1)
    if name != cur:
        now = time.time()
        if cur is not None:
            times[cur] = times.get(cur, 0.0) + (now - cur_t)
        cur, cur_t = name, now


buf = b""
while True:
    try:
        ready, _, _ = select.select([fd], [], [], 1)
        if not ready:
            continue
        data = os.read(fd, 65536)
        if not data:
            break
    except OSError:
        break
    buf += data
    while True:
        cuts = [i for i in (buf.find(b"\r"), buf.find(b"\n")) if i != -1]
        if not cuts:
            break
        i = min(cuts)
        on_segment(buf[:i])
        buf = buf[i + 1:]

if cur is not None:
    times[cur] = times.get(cur, 0.0) + (time.time() - cur_t)
_, status = os.waitpid(pid, 0)
print(f"{cwd}: total {time.time() - t0:.1f}s")
for name, sec in sorted(times.items(), key=lambda kv: -kv[1]):
    if sec >= 0.3:
        print(f"  {name:<16}{sec:6.1f}s")
sys.exit(os.waitstatus_to_exitcode(status))
