{
  "version": 1,
  "note": "エンジン共通のお題（どのゲームの足元でも同じ道具が当たるべき物）。bin/fge agent-eval が読む（make agent-eval）。prompt は依頼の言葉だけにし、道具の名前を入れない。expect は答えに出てほしい道具（1 つ 1 点）、avoid は古い書き方（打ち消しの無い行に出たら 1 点引く）。新しい仕組みを入れた人は、早見表の 1 行と一緒にここへお題を 1 本足す。 avoid の正規表現は、ゲームに実在する名前（bgmFightIntro など）や道具の説明（use-engine が local.mk を書き換える）に当てない。今のコードや道具を説明しただけで減点になる。",
  "tasks": [
    {
      "id": "hud-timer",
      "prompt": "画面の右上に残り時間の表示を足したい。ゲームの絵（爆発など）がどれだけ手前に出ても、この表示は隠れないようにしたい",
      "expect": [
        {"re": "withHudView", "why": "App.withHudView"},
        {"re": "ZStack\\.(of|leaf)", "why": "ZStack の木（of / leaf）"}
      ],
      "avoid": [
        {"re": "\\bz[A-Z]\\w*\\(\\)\\s*(:\\s*Int32\\s*)?=\\s*[1-9]\\d{2,}|\\bzIndex\\s*[=:]\\s*[1-9]\\d{2,}", "why": "z の大きな数を直に書く"}
      ]
    },
    {
      "id": "topdown-behind-tree",
      "prompt": "見下ろしの町で、人が木の裏に回ったら木に隠れ、手前に来たら木の前に出るようにしたい",
      "expect": [
        {"re": "Depth\\.orderAt|orderAt", "why": "Depth.orderAt"},
        {"re": "ZStack\\.zIndex|zIndex\\(", "why": "ZStack.zIndex"}
      ],
      "avoid": [
        {"re": "Depth\\.(Bands|place)", "why": "Depth.Bands / place"},
        {"re": "zShifted|zMapped|ZLegacy", "why": "z の付け替え"}
      ]
    },
    {
      "id": "tooltip-front",
      "prompt": "カードの一覧の中で、選んだカードの説明の窓を、ほかのどの部品よりも必ず手前に出したい。窓が画面からはみ出さない所に置きたい",
      "expect": [
        {"re": "topLayer", "why": "ZStack.topLayer"},
        {"re": "UiTooltip", "why": "UiTooltip"}
      ],
      "avoid": [
        {"re": "\\bz[A-Z]\\w*\\(\\)\\s*(:\\s*Int32\\s*)?=\\s*[1-9]\\d{2,}|\\bzIndex\\s*[=:]\\s*[1-9]\\d{2,}", "why": "z の大きな数を直に書く"}
      ]
    },
    {
      "id": "shake-scale-scene",
      "prompt": "被弾したとき、画面全体を一瞬少し縮めてから戻す演出を入れたい",
      "expect": [
        {"re": "mapItems", "why": "ZStack.mapItems"},
        {"re": "scaledAllAround", "why": "Render.scaledAllAround"}
      ],
      "avoid": [
        {"re": "zShifted|zMapped|ZLegacy", "why": "z の付け替え"}
      ]
    },
    {
      "id": "pause-layer",
      "prompt": "ポーズ画面を足したい。ゲームの絵と会話の窓のどちらよりも上に重ねたい",
      "expect": [
        {"re": "SortingLayer|Layer\\s*(の\\s*)?enum|enum\\s+Layer", "why": "SortingLayer の表"},
        {"re": "compose|topLayer", "why": "SortingLayer.compose / topLayer"}
      ],
      "avoid": [
        {"re": "\\bz[A-Z]\\w*\\(\\)\\s*(:\\s*Int32\\s*)?=\\s*[1-9]\\d{2,}|\\bzIndex\\s*[=:]\\s*[1-9]\\d{2,}", "why": "z の大きな数を直に書く"},
        {"re": "leafAbsolute|SortingLayer\\.z\\(|ZLegacy", "why": "移行の口（消した名前）"}
      ]
    },
    {
      "id": "doc-fallback-log",
      "prompt": "設定の JSON が壊れていたら既定値で続け、ログに 1 行だけ知らせたい",
      "expect": [
        {"re": "loadOr|decodeObject", "why": "DocJson.loadOr"},
        {"re": "fellBackThen|warnThen|warnAllThen", "why": "Log.*Then"}
      ],
      "avoid": [
        {"re": "let\\s+_\\s*=", "why": "let _ ="}
      ]
    },
    {
      "id": "check-render-after-doc",
      "prompt": "Doc（JSON）の数値を少し直した。絵が崩れていないかを確かめたい",
      "expect": [
        {"re": "make render SHOT|render SHOT=", "why": "make render SHOT="},
        {"re": "reference-check", "why": "make reference-check"}
      ],
      "avoid": [
        {"re": "解像度を下げ|_FRAMES", "why": "速さのための回り道"}
      ]
    },
    {
      "id": "ticket-find-doc",
      "prompt": "F8 で囲って書き出した注釈チケットが届いた。どの Doc のどこを直せばよいか探したい",
      "expect": [
        {"re": "README", "why": "チケットの README"},
        {"re": "world\\.json", "why": "world.json"},
        {"re": "annotation\\.json|withAnnotationContext", "why": "文脈（annotation.json の context）"}
      ],
      "avoid": []
    },
    {
      "id": "sfx-on-timeline",
      "prompt": "演出の 0.4 秒目と 1.2 秒目に効果音を鳴らしたい。秒は Doc から調整できるようにしたい",
      "expect": [
        {"re": "Timeline\\.build|Timeline", "why": "Timeline の時刻表"},
        {"re": "withSound|soundsOn", "why": "音をクリップに付ける（withSound / soundsOn）"},
        {"re": "withAudio", "why": "App.withAudio"}
      ],
      "avoid": [
        {"re": "startedBetween", "why": "クリップの列と別に音の時刻を判定する古い形"}
      ]
    },
    {
      "id": "beat-synced-cutin",
      "prompt": "BGM のテンポに合わせて、警告の帯を 2 小節見せた後にカットインを入れ、その後のターン 1 の合図を、次の小節の頭のちょうど 1 拍前に出したい。帯やカットインの長さを変えても、曲の拍からずれないようにしたい",
      "expect": [
        {"re": "ToPickup", "why": "Duration.ToPickup（次の小節の頭の n 拍前）"},
        {"re": "Bars|ToNextBar", "why": "Duration.Bars / ToNextBar"},
        {"re": "Timeline\\.tempo|tempo\\(", "why": "Timeline.tempo に譜面の bpm を渡す"}
      ],
      "avoid": [
        {"re": "60(\\.0)?\\s*/\\s*\\w*bpm", "why": "60 / bpm を手で計算する"},
        {"re": "withDelay\\(\\s*(Duration\\.)?Beats\\(\\s*(0\\.0\\s*)?-", "why": "足場の行と負の withDelay で拍を戻す"}
      ]
    },
    {
      "id": "bgm-intro-loop",
      "prompt": "新しく足す曲にイントロを付けたい。イントロは鳴らし始めに 1 回だけ鳴らし、その後は本編だけを繰り返したい。継ぎ目に隙間が空かないようにしたい",
      "expect": [
        {"re": "renderLooped|ループ点|smpl|loopPoints", "why": "1 本の WAV のループ点（SfxSynth.renderLooped・smpl）"},
        {"re": "withSustained", "why": "App.withSustained で同じ名前を宣言し続ける"}
      ],
      "avoid": [
        {"re": "Intro\\.wav|イントロの長さを過ぎたら", "why": "頭と輪を 2 本の音に割って時刻で切り替える"}
      ]
    },
    {
      "id": "heavy-queue",
      "prompt": "同じ Mac でほかのエージェントも描き出しやテストを回している。自分も render-all を流したいが、同時に走ってメモリを食い合わないようにしたい。今だれが走らせているかも知りたい",
      "expect": [
        {"re": "fge heavy|heavy make|heavy \\S*make", "why": "bin/fge heavy"},
        {"re": "heavy --status", "why": "持ち主と待ち列"}
      ],
      "avoid": [
        {"re": "until mkdir", "why": "鍵を手で書く"},
        {"re": "-mmin \\+40", "why": "古さだけで鍵を外す"}
      ]
    },
    {
      "id": "heavy-short-beside-long",
      "prompt": "別のエージェント 2 人が動画の描き出しで重い処理の鍵をそれぞれ 30 分握り、その後ろにも描き出しが並んでいる。自分は型検査を 1 回流したいだけで、その後ろで 30 分も待ちたくない",
      "expect": [
        {"re": "fge heavy[^\\n]*(make check|check)|heavy make check", "why": "短い物は bin/fge heavy で包めば空いた枠で流れる"}
      ],
      "avoid": [
        {"re": "until mkdir", "why": "鍵を手で書く"},
        {"re": "rmdir /tmp/fge-heavy|rm -r[f]? /tmp/fge-heavy", "why": "人の鍵を外す"},
        {"re": "heavy --long[^\\n]*check", "why": "短い物に長い物の印を付ける"}
      ]
    },
    {
      "id": "use-engine-temp",
      "prompt": "このゲームの作業場だけ、いま別の作業場で直している開発中のエンジンで動くか確かめたい。終わったら元のエンジンに戻したい",
      "expect": [
        {"re": "use-engine", "why": "bin/fge use-engine"},
        {"re": "--restore", "why": "元へ戻す"}
      ],
      "avoid": [
        {"re": "ln -s[^\\n]*lib", "why": "lib を他の作業場へ symlink"},
        {"re": "local\\.mk[^\\n]{0,30}(書き換|編集|sed)|sed[^\\n]*local\\.mk", "why": "local.mk を手で書き換える", "unless": "use-engine"}
      ]
    },
    {
      "id": "compare-before-after",
      "prompt": "描画の直しを入れた。master の時と比べて、どの場面の絵と効果音が変わったかを一覧と前後を並べた画像で見たい",
      "expect": [
        {"re": "make compare", "why": "make compare"},
        {"re": "BASE=", "why": "基準の ref"}
      ],
      "avoid": [
        {"re": "git worktree add", "why": "worktree を手で作る"},
        {"re": "hstack", "why": "ffmpeg で手で並べる"}
      ]
    },
    {
      "id": "proposal-page",
      "prompt": "演出の案を 3 つ動画で並べて、依頼主に 1 つ選んでもらうページを作りたい",
      "expect": [
        {"re": "proposal\\.json", "why": "manifest"},
        {"re": "fge proposal", "why": "bin/fge proposal build"}
      ],
      "avoid": [
        {"re": "proposal\\.py", "why": "移した後の古い道具"}
      ]
    },
    {
      "id": "heavy-game-long-target",
      "prompt": "このゲームに 40 分かかるシミュレーションの make の口 sim-sweep を足した。ほかのエージェントが重い処理の鍵で流すとき、毎回印を付けてもらわなくても長い物として扱われるようにしたい。今日どの待ちが長かったかも見たい",
      "expect": [
        {"re": "HEAVY_LONG", "why": "ゲームの Makefile の HEAVY_LONG に口を足す"},
        {"re": "heavy --history", "why": "待ちの合計は heavy の記録から"}
      ],
      "avoid": [
        {"re": "until mkdir", "why": "鍵を手で書く"}
      ]
    },
    {
      "id": "pixel-walk",
      "prompt": "村の女の子の歩きをドット絵（sprite.json・4 方向 × 3 コマ）で描いてほしい。描き始める前に何を読み、どう進める？",
      "expect": [
        {"re": "pixel-art", "why": "短いスキル pixel-art を読む"},
        {"re": "walk\\.md|pixel-art/walk|pixel-art の walk", "why": "表からお題の種類（歩き）のファイルを読む"}
      ],
      "avoid": [
        {"re": "retro-pixel|px-character|visual-dict", "why": "長いスキル（詳しい参考）を既定で読む"}
      ]
    },
    {
      "id": "confirm-window-pacing",
      "prompt": "確認の窓が開くまでの長さと、閉じるまでの長さを決めたい。何を目安に、どのくらいにする？",
      "expect": [
        {"re": "pacing\\.md", "why": "演出の間の目安 docs/pacing.md を読む"}
      ],
      "avoid": []
    }
  ]
}
