  "lines": {
    "22": {
      "cmd": "<<audio ambience amb_winter_wind>>",
      "node": "WinterRoute"
    },
    "23": {
      "cmd": "<<bg slope grade=morning time=2.5>>",
      "node": "WinterRoute"
    },
    "24": {
      "cmd": "<<window off>>",
      "node": "WinterRoute"
    },
    "25": {
      "cmd": "<<wait 2>>",
      "node": "WinterRoute"
    },
    "26": {
      "cmd": "<<window nvl>>",
      "node": "WinterRoute"
    },
    "27": {
      "node": "WinterRoute",
      "text": "薄雪に、まだ靴の跡がない。",
      "who": "地の文"
    },
    "28": {
      "node": "WinterRoute",
      "text": "祖父の空き家へ来てから、朝に用事があるのは初めてだ。",
      "who": "地の文"
    },
    "29": {
      "node": "WinterRoute",
      "text": "まだ寝ぼけた体を、玄関で急かさずに待つ。",
      "who": "地の文"
    },
    "30": {
      "node": "WinterRoute",
      "text": "午前だけでいいからね。無理はしないで。",
      "who": "郵便局の人"
    },
    "31": {
      "node": "WinterRoute",
      "text": "はい、朝は得意です。お任せください。",
      "who": "灯"
    },
    "32": {
      "node": "WinterRoute",
      "text": "坂の上は日陰が凍るよ。石垣の先、気をつけて。",
      "who": "郵便局の人"
    },
    "33": {
      "node": "WinterRoute",
      "text": "窓口で受け取った鞄は、思ったより腰の低い所に落ちた。",
      "who": "地の文"
    },
    "34": {
      "cmd": "<<window clear>>",
      "node": "WinterRoute"
    },
    "35": {
      "node": "WinterRoute",
      "text": "新しい配達の人かい。",
      "who": "坂の家の人"
    },
    "36": {
      "node": "WinterRoute",
      "text": "冬の間だけ、お手伝いします。よろしくお願いします。",
      "who": "灯"
    },
    "37": {
      "node": "WinterRoute",
      "text": "上の工房の人、手紙が好きでね。今日も待ってるよ。",
      "who": "坂の家の人"
    },
    "38": {
      "node": "WinterRoute",
      "text": "石垣を回ると、靴底が横へ流れた。",
      "who": "地の文"
    },
    "39": {
      "node": "WinterRoute",
      "text": "膝を曲げて止まり、石の白い粒を見つめる。",
      "who": "地の文"
    },
    "40": {
      "node": "WinterRoute",
      "text": "次の一歩から、歩幅を半分にした。",
      "who": "地の文"
    },
    "41": {
      "cmd": "<<window clear>>",
      "node": "WinterRoute"
    },
    "42": {
      "node": "WinterRoute",
      "text": "最後の一軒は、坂の上の古い工房だった。",
      "who": "地の文"
    },
    "43": {
      "node": "WinterRoute",
      "text": "郵便受けの蓋を戻すと、庇の下の窓が開いた。",
      "who": "地の文"
    },
    "44": {
      "node": "WinterRoute",
      "text": "石垣の所……。これを。",
      "who": "冬馬"
    },
    "45": {
      "node": "WinterRoute",
      "text": "私にですか。ありがとうございます。",
      "who": "灯"
    },
    "46": {
      "node": "WinterRoute",
      "text": "あの、お名前を。",
      "who": "灯"
    },
    "47": {
      "node": "WinterRoute",
      "text": "雪明かりの向こうで、小さな封筒を持つ指だけが見えた。",
      "who": "地の文"
    },
    "48": {
      "node": "WinterRoute",
      "text": "窓はもう閉まり、私の声がガラスに薄く残った。",
      "who": "地の文"
    },
    "49": {
      "cmd": "<<window clear>>",
      "node": "WinterRoute"
    },
    "50": {
      "node": "WinterRoute",
      "text": "宛名には、次にここへ来る方へ、とある。",
      "who": "地の文"
    },
    "51": {
      "node": "WinterRoute",
      "text": "坂の下で封を開くと、折った紙が膝いっぱいに広がった。",
      "who": "地の文"
    },
    "52": {
      "node": "WinterRoute",
      "text": "道の線に沿って、細かな斜線が重なっている。",
      "who": "地の文"
    },
    "53": {
      "node": "WinterRoute",
      "text": "今朝、足を取られた曲がり角にもあった。",
      "who": "地の文"
    },
    "54": {
      "node": "WinterRoute",
      "text": "見られてた。",
      "who": "灯"
    },
    "55": {
      "node": "WinterRoute",
      "text": "まだ会っていない私の靴の置き場を、考えた人がいる。",
      "who": "地の文"
    },
    "56": {
      "node": "WinterRoute",
      "text": "帰ったら返事を書こう。封筒を内ポケットへ入れた。",
      "who": "地の文"
    },
    "57": {
      "cmd": "<<jump FirstLetter>>",
      "node": "WinterRoute"
    }
  },
