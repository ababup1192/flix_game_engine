    {"id": "baseline-check", "about": "基準の版（bench/baseline）との比べ", "make": "baseline-check", "select": "hold", "hold": "基準の版（bench/baseline）との比べ。版を上げる段の終わりと描き手を触った後に手で", "runs": ["manual"], "time": "?"},
