{
  "note": "engine のリポの門（テスト・検査の make の口）の一覧。この JSON が source of truth で、bin/fge gates が読む（一覧・--files で当たる門・--suite で流す・--check で Makefile との食い違い）。ゲームへは配らない（置き場が根なのはそのため。bin/lint-rules/ はフォルダごと配られる）。コミットの時の検査（bin/lint-rules/precommit.json の checks・docsSync・localGate）と hook の検査（bin/lint-rules/hooks.json の artEdit）はここに書かず、bin/fge gates が読み込んで一覧に混ぜる。1 件 = {id, about（確かめる性質）, make（流す口の名前）か cmd（make の口が無い物の打ち方。--suite では流さない）, vars（make <口> K=V …）, input（当たるファイル。precommit.json の when と同じ書き方。省くと「どの変更でも」）, samples（docs-sync:* だけ必須。input と precommit.json の docsSync の when の両方に当たる見本のパス）, runs（いつ流すか。下の runs の名前）, time（おおよその実時間。出典は plans/test-selection.md の 1 節と .test-logs の記録。測っていない物は ?）, prereq（true なら suite の中で落ちたら後ろを流さない）}。runs に release を持つ門の make の口の集まりは Makefile の RELEASE_GATES と同じ（--check が見る）。suites は make verify SUITE=<名前> の中身（gates の id の並び。fallback は「まだ作っていないので代わりにこの suite を流す」）。",
  "runs": {
    "precommit": "コミットの時（bin/fge precommit）",
    "hook": "Claude の hook（ファイルを書いた直後・会話の区切り）",
    "manual": "手で打つ",
    "release": "make release-verify の門（RELEASE_GATES）",
    "pre-release": "release の前に手元で（画面を開く門）"
  },
  "gates": [
    {"id": "release-guard", "about": "公開の前の安全策（配る物が未コミットでないか・flix.toml・同梱の flix.jar の版・追随の材料・jar の行）", "make": "release-guard", "runs": ["release"], "time": "?"},
    {"id": "studio-parity", "about": "外の Studio の clone で check-agents-parity（sync-agents の出力が Studio とずれていないか）", "make": "studio-parity", "input": {"anyOf": [{"prefixes": ["agents-pack/", "templates/", "go/internal/syncagents/"]}]}, "runs": ["release"], "time": "?"},
    {"id": "sync", "about": "層の作業場を張り、engine_full を build-pkg して templates / bench に配る（全パッケージのコンパイル）", "make": "sync", "prereq": true, "input": {"anyOf": [{"prefixes": ["engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/", "render_gl/java/"]}, {"basenames": ["flix.toml"]}]}, "runs": ["release"], "time": "20s"},
    {"id": "test-release", "about": "全パッケージの flix test（テンプレートとテストを持つ bench を含む・6 並列。make test ALL=1 JOBS=6 と同じ）", "make": "test-release", "runs": ["release"], "time": "2m"},
    {"id": "gl-parity", "about": "GL と SoftRaster の絵の一致・式の差の上限", "make": "gl-parity", "input": {"anyOf": [{"prefixes": ["render_gl/", "engine_tools/src/", "engine/src/shader/", "engine/src/scene3d/", "bench/gl_parity/"]}]}, "runs": ["release"], "time": "18s"},

    {"id": "release-verify", "about": "リリースの門（上の runs: release の 5 本）を通し、通した commit を release/verified.txt に書く", "make": "release-verify", "runs": ["manual"], "time": "3m"},
    {"id": "sync-engine-full", "about": "engine_full の fpkg を作り置き場へ（テンプレート・bench が読む束を新しくする）", "make": "sync-engine-full", "prereq": true, "input": {"anyOf": [{"prefixes": ["engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/", "render_gl/java/"]}]}, "runs": ["manual"], "time": "14s"},
    {"id": "check", "about": "根の 4 パッケージを 1 本の木で型検査", "make": "check", "input": {"suffixes": [".flix"], "prefixes": ["engine/", "engine_world/", "engine_tools/", "render_gl/"]}, "runs": ["manual"], "time": "10s"},
    {"id": "precommit-dry", "about": "ステージした物と作業ツリーの差分（追跡していない新しいファイルを含む）で bin/fge precommit を素振りする", "make": "precommit-dry", "runs": ["manual"], "time": "5s"},
    {"id": "lint", "about": "規約の全量（今 0 件の既定の束）", "make": "lint", "runs": ["manual"], "time": "5s"},
    {"id": "check-docs-sync", "about": "規約まわりの配線の検査を全部（docs-sync:* の 18 本）", "make": "check-docs-sync", "runs": ["manual"], "time": "1s"},
    {"id": "checkd", "about": "触ったパッケージの型検査（常駐の flix）", "cmd": "bin/fge hook-flix-work（Stop の hook）", "input": {"suffixes": [".flix"]}, "runs": ["hook"], "time": "1s"},
    {"id": "go-build", "about": "go/ を bin/fge-go と配る先ごとの 5 種に組む（go の変更は作り直すまで門に効かない）", "make": "go-build", "prereq": true, "input": {"prefixes": ["go/"]}, "runs": ["manual"], "time": "30s"},
    {"id": "go-test", "about": "go/ のテスト（PKG=<名前> で go/internal/<名前> だけ）", "make": "go-test", "input": {"anyOf": [{"prefixes": ["go/", "bin/lint-rules/", "testdata/"]}, {"basenames": ["check-codes.md"]}]}, "runs": ["manual"], "time": "?"},
    {"id": "render-all", "about": "テンプレートの gallery を描き直す（生成）", "make": "render-all", "input": {"anyOf": [{"prefixes": ["templates/", "engine/src/", "engine_world/src/", "engine_tools/src/"]}]}, "runs": ["manual"], "time": "2m30s"},
    {"id": "refactor-smoke", "about": "engine の新しい型を使う小さな場面で checkd・refactor・flixlint が通るか", "make": "refactor-smoke", "input": {"anyOf": [{"prefixes": ["testdata/refactor-smoke/", "go/internal/refactor/", "go/internal/checkd/"]}]}, "runs": ["manual"], "time": "?"},
    {"id": "baseline-check", "about": "基準の版（bench/baseline）との比べ", "make": "baseline-check", "runs": ["manual"], "time": "?"},
    {"id": "check-external", "about": "外のゲームの型検査（置き場の fpkg で）", "make": "check-external", "runs": ["manual"], "time": "?"},
    {"id": "webgpu-v1-check", "about": "WebGPU と GL の絵の比べ", "make": "webgpu-v1-check", "input": {"anyOf": [{"prefixes": ["render_gl/", "bench/webgpu_v1/", "bench/webgpu_v2/"]}]}, "runs": ["manual"], "time": "64s"},

    {"id": "test-engine", "about": "engine の flix test（1054 本）", "make": "test-engine", "input": {"prefixes": ["engine/src/", "engine/test/"]}, "runs": ["manual"], "time": "30s"},
    {"id": "test-engine_tools", "about": "engine_tools の flix test（.layers・331 本）", "make": "test-engine_tools", "input": {"anyOf": [{"prefixes": ["engine/src/", "engine_tools/"]}, {"suffixes": [".ttf", ".otf"], "prefixes": ["templates/"]}]}, "runs": ["manual"], "time": "27s"},
    {"id": "test-engine_world", "about": "engine_world の flix test（.layers・1656 本）", "make": "test-engine_world", "input": {"anyOf": [{"prefixes": ["engine/src/", "engine_world/", "testdata/lint/flow-check/", "go/internal/yarn/testdata/"]}]}, "runs": ["manual"], "time": "48s"},
    {"id": "test-render_gl", "about": "render_gl の flix test（.layers・682 本）", "make": "test-render_gl", "input": {"anyOf": [{"prefixes": ["engine/src/", "engine/test/data/", "render_gl/"]}, {"suffixes": [".shader.json"], "prefixes": ["templates/"]}]}, "runs": ["manual"], "time": "47s"},
    {"id": "test-hd2d-starter", "about": "hd2d-starter の flix test（置き場の fpkg を読む。engine 側を直したら先に sync-engine-full）", "make": "test-hd2d-starter", "input": {"anyOf": [{"prefixes": ["templates/hd2d-starter/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/"]}]}, "runs": ["manual"], "time": "45s"},
    {"id": "test-rpg-starter", "about": "rpg-starter の flix test（置き場の fpkg を読む）", "make": "test-rpg-starter", "input": {"anyOf": [{"prefixes": ["templates/rpg-starter/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/"]}]}, "runs": ["manual"], "time": "1m52s"},
    {"id": "test-sound-novel-starter", "about": "sound-novel-starter の flix test（置き場の fpkg を読む）", "make": "test-sound-novel-starter", "input": {"anyOf": [{"prefixes": ["templates/sound-novel-starter/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/"]}]}, "runs": ["manual"], "time": "35s"},
    {"id": "test-tidepool-starter", "about": "tidepool-starter の flix test（置き場の fpkg を読む）", "make": "test-tidepool-starter", "input": {"anyOf": [{"prefixes": ["templates/tidepool-starter/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/"]}]}, "runs": ["manual"], "time": "24s"},

    {"id": "test-hd2d_town", "about": "bench/hd2d_town の flix test（142 本・置き場の fpkg を読む。test-release に入る）", "make": "test-hd2d_town", "input": {"anyOf": [{"prefixes": ["bench/hd2d_town/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/src/"]}]}, "runs": ["manual"], "time": "13s"},
    {"id": "lint:template-rules", "about": "テンプレートの lint/rules.flix（hd2d・rpg・tidepool。コミットでは precommit-local が触ったテンプレートの分だけ流す・1 本 4〜7 秒）", "make": "lint", "vars": {"ONLY": "template-rules"}, "input": {"anyOf": [{"prefixes": ["templates/hd2d-starter/", "templates/rpg-starter/", "templates/tidepool-starter/"]}]}, "runs": ["precommit", "manual"], "time": "10s"},

    {"id": "determinism", "about": "rpg・sound-novel・tidepool を隠しウィンドウでシナリオどおり流し、記録の再生と World の指紋が同じか", "make": "determinism", "input": {"anyOf": [{"prefixes": ["testdata/determinism/", "templates/", "engine/src/", "engine_world/src/", "engine_tools/src/", "render_gl/"]}]}, "runs": ["pre-release"], "time": "3m32s"},
    {"id": "gl-capture-check", "about": "既定の場面を WebGPU で 2 回撮り SHA を比べ、機械の基準とも比べる（SCENES=<名前> で絞れる）", "make": "gl-capture-check", "input": {"anyOf": [{"prefixes": ["templates/", "bench/scene3d/", "bench/baseline/", "render_gl/", "engine/src/", "engine_world/src/"]}]}, "runs": ["pre-release"], "time": "12m"},
    {"id": "smoke-devtools", "about": "DEBUG 起動の開発の道具（rpg-starter と App）", "make": "smoke-devtools", "input": {"anyOf": [{"prefixes": ["engine_world/src/App/", "templates/rpg-starter/"]}]}, "runs": ["pre-release"], "time": "?"},
    {"id": "webgpu-v1-check-web", "about": "ブラウザで撮って WebGPU の絵を比べる", "make": "webgpu-v1-check-web", "input": {"anyOf": [{"prefixes": ["engine_web/", "render_gl/", "bench/webgpu_v1/", "bench/webgpu_v2/"]}]}, "runs": ["pre-release"], "time": "23s"},

    {"id": "docs-sync:claude-import", "about": "CLAUDE.md が AGENTS.md を import しているか", "make": "check-docs-sync", "vars": {"ONLY": "claude-import"}, "input": {"basenames": ["CLAUDE.md", "AGENTS.md"]}, "samples": ["CLAUDE.md", "AGENTS.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:rules", "about": ".claude/rules・agents-pack/rules が docs/ と一致しているか", "make": "check-docs-sync", "vars": {"ONLY": "rules"}, "input": {"anyOf": [{"prefixes": ["docs/", ".claude/rules/", "agents-pack/rules/", "go/internal/genrules/"]}]}, "samples": ["docs/x.md", ".claude/rules/x.md", "agents-pack/rules/x.md", "go/internal/genrules/x.go"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:px-ops", "about": "docs/px-ops.md と px のスキーマが op の登録と一致しているか", "make": "check-docs-sync", "vars": {"ONLY": "px-ops"}, "input": {"anyOf": [{"basenames": ["px-ops.md"]}, {"prefixes": ["go/internal/px/", "go/internal/pxlib/"]}]}, "samples": ["docs/px-ops.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:check-codes", "about": "docs/check-codes.md が検査の code の表と一致しているか", "make": "check-docs-sync", "vars": {"ONLY": "check-codes"}, "input": {"anyOf": [{"basenames": ["check-codes.md"]}, {"prefixes": ["go/internal/check/"]}]}, "samples": ["docs/check-codes.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:skill-table", "about": "AGENTS.md のスキル表が実在する skill を指しているか", "make": "check-docs-sync", "vars": {"ONLY": "skill-table"}, "input": {"anyOf": [{"basenames": ["AGENTS.md"]}, {"prefixes": [".claude/skills/"]}]}, "samples": ["AGENTS.md", ".claude/skills/x/SKILL.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:core-skills", "about": "AGENTS.core.md のスキル参照が agents-pack/skills に実在するか", "make": "check-docs-sync", "vars": {"ONLY": "core-skills"}, "input": {"prefixes": ["agents-pack/"]}, "samples": ["agents-pack/AGENTS.core.md", "agents-pack/skills/x/SKILL.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:core-bridge", "about": "AGENTS.core.md に skills への橋渡しがあるか", "make": "check-docs-sync", "vars": {"ONLY": "core-bridge"}, "input": {"basenames": ["AGENTS.core.md"]}, "samples": ["agents-pack/AGENTS.core.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:skill-links", "about": "agents-pack/skills にコピー先のゲームで切れる相対リンクが無いか", "make": "check-docs-sync", "vars": {"ONLY": "skill-links"}, "input": {"prefixes": ["agents-pack/skills/"]}, "samples": ["agents-pack/skills/x/SKILL.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:skill-frontmatter", "about": "skill の frontmatter に name と description があるか", "make": "check-docs-sync", "vars": {"ONLY": "skill-frontmatter"}, "input": {"anyOf": [{"prefixes": [".claude/skills/", "agents-pack/skills/"]}]}, "samples": [".claude/skills/x/SKILL.md", "agents-pack/skills/x/SKILL.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:skill-sync", "about": "同名スキルの sync 印が両側で一致するか", "make": "check-docs-sync", "vars": {"ONLY": "skill-sync"}, "input": {"anyOf": [{"prefixes": [".claude/skills/", "agents-pack/skills/"]}]}, "samples": [".claude/skills/x/SKILL.md", "agents-pack/skills/x/SKILL.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:old-prim-names", "about": "図形プリミティブの旧名 Render.box 等が docs/ と AGENTS.md に残っていないか", "make": "check-docs-sync", "vars": {"ONLY": "old-prim-names"}, "input": {"anyOf": [{"prefixes": ["docs/"], "suffixes": [".md"]}, {"basenames": ["AGENTS.md"]}]}, "samples": ["docs/x.md", "AGENTS.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:manifest", "about": "agents-pack/manifest.json が正しい JSON で src が全実在するか", "make": "check-docs-sync", "vars": {"ONLY": "manifest"}, "input": {"anyOf": [{"prefixes": ["agents-pack/", "go/internal/syncagents/"]}]}, "samples": ["agents-pack/manifest.json", "go/internal/syncagents/x.go"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:check-refs", "about": "Makefile / templates / agents-pack の参照先が実在するか", "make": "check-docs-sync", "vars": {"ONLY": "check-refs"}, "input": {"anyOf": [{"basenames": ["Makefile"]}, {"prefixes": ["templates/", "agents-pack/", "mk/", "go/internal/checkrefs/"]}]}, "samples": ["Makefile", "templates/x/Makefile", "agents-pack/x.md", "go/internal/checkrefs/x.go"], "runs": ["precommit", "manual"], "time": "0.3s"},
    {"id": "docs-sync:api-index", "about": "pub def を持つモジュールが API 索引に載っているか", "make": "check-docs-sync", "vars": {"ONLY": "api-index"}, "input": {"anyOf": [{"suffixes": [".flix"]}, {"basenames": ["module-index.md"]}, {"prefixes": ["docs/modules/", "go/internal/apiindex/"]}]}, "samples": ["engine/src/x.flix", "docs/module-index.md", "go/internal/apiindex/x.go"], "runs": ["precommit", "manual"], "time": "0.2s"},
    {"id": "docs-sync:api-digest", "about": "docs/api-digest.md が作り直しても差分ゼロか", "make": "check-docs-sync", "vars": {"ONLY": "api-digest"}, "input": {"anyOf": [{"suffixes": [".flix"]}, {"prefixes": ["docs/api-digest", "go/internal/apidigest/"]}]}, "samples": ["engine/src/x.flix", "docs/api-digest.md", "go/internal/apidigest/x.go"], "runs": ["precommit", "manual"], "time": "0.2s"},
    {"id": "docs-sync:docs-links", "about": "AGENTS.md から docs/ への導線があるか", "make": "check-docs-sync", "vars": {"ONLY": "docs-links"}, "input": {"basenames": ["AGENTS.md"]}, "samples": ["AGENTS.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:template-claude", "about": "templates/ に CLAUDE.md を置いていないか", "make": "check-docs-sync", "vars": {"ONLY": "template-claude"}, "input": {"prefixes": ["templates/"], "basenames": ["CLAUDE.md"]}, "samples": ["templates/x/CLAUDE.md"], "runs": ["precommit", "manual"], "time": "0.1s"},
    {"id": "docs-sync:gates", "about": "gates.json が Makefile の口・テストのパッケージ・検査の名前・リリースの門とそろっているか", "make": "check-docs-sync", "vars": {"ONLY": "gates"}, "input": {"anyOf": [{"basenames": ["gates.json", "Makefile", "precommit.json", "hooks.json"]}, {"prefixes": ["templates/", "go/internal/gates/"]}]}, "samples": ["gates.json", "Makefile", "bin/lint-rules/precommit.json", "go/internal/gates/x.go"], "runs": ["precommit", "manual"], "time": "0.3s"}
  ],
  "suites": [
    {"name": "quick", "about": "作業中の軽い確かめ（根の 4 パッケージの型検査・precommit の素振り・lint の既定の束・配線の検査の全部）", "gates": ["check", "precommit-dry", "lint", "check-docs-sync"]},
    {"name": "test", "about": "パッケージのテスト全部（engine の束を配り直してから、テンプレートを含めて並列）", "gates": ["sync-engine-full", "test-release"]},
    {"name": "release", "about": "リリースの全量（make release-verify と同じ。release/verified.txt を書く）", "gates": ["release-verify"]},
    {"name": "gui", "about": "画面を開く門（release の前に手元で。約 21 分）", "gates": ["sync-engine-full", "determinism", "gl-capture-check", "smoke-devtools", "webgpu-v1-check-web"]},
    {"name": "affected", "about": "差分から選んで流す（plans/test-selection.md の案 B の受け口。今は test を流す）", "fallback": "test"}
  ]
}
