    "rate": {
      "default": 22050,
      "maximum": 96000,
      "minimum": 8000,
      "type": "integer"
    },
    "style": {
      "default": "free",
      "description": "機種（bin/lint-rules/snd.json の styles の名前か .json の Doc）",
      "type": "string"
    },
    "target": {
      "description": "書き出す WAV（assets/ の外）",
      "pattern": "\\.wav$",
      "type": "string"
    },
    "tempo": {
      "additionalProperties": false,
