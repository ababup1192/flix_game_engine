                  "maxProperties": 1,
                  "minProperties": 1,
                  "properties": {
                    "noise": {
                      "additionalProperties": false,
                      "properties": {
                        "amp": {
                          "default": 0.5,
                          "description": "振幅（0〜1）",
                          "maximum": 4,
                          "minimum": 0,
                          "type": "number"
                        },
                        "hz": {
                          "default": 8000,
                          "description": "LFSR を回す速さ（回/秒。hash は読まない）",
                          "maximum": 1048576,
                          "minimum": 1,
                          "type": "number"
                        },
                        "kind": {
                          "default": "hash",
                          "description": "雑音の作り方",
                          "enum": [
                            "hash",
                            "lfsr15",
                            "lfsr7"
