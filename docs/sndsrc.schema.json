{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channels": {
      "default": "stereo",
      "description": "書き出しのチャンネル",
      "enum": [
        "stereo",
        "mono"
      ]
    },
    "kind": {
      "default": "sfx",
      "enum": [
        "ui",
        "sfx",
        "bgm"
      ]
    },
    "loop_start_ms": {
      "minimum": 0,
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "post": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "帰還つきのディレイ（ms ごとに feedback 倍で返る。pingpong で左右に交互に返す・帰還の道で lowpass）を wet だけ足す",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "delay": {
                "additionalProperties": false,
                "properties": {
                  "feedback": {
                    "default": 0.35,
                    "description": "返る量（0〜0.95）",
                    "maximum": 0.95,
                    "minimum": 0,
                    "type": "number"
                  },
                  "lowpass": {
                    "default": 6000,
                    "description": "帰還の道のローパス（Hz。返るたびに暗くなる）",
                    "maximum": 20000,
                    "minimum": 100,
                    "type": "number"
                  },
                  "ms": {
                    "description": "遅れ（ミリ秒）",
                    "maximum": 4000,
                    "minimum": 1,
                    "type": "number"
                  },
                  "pingpong": {
                    "default": true,
                    "description": "左右に交互に返す（モノラルの書き出しでは真ん中）",
                    "type": "boolean"
                  },
                  "wet": {
                    "default": 0.25,
                    "description": "返りの量",
                    "maximum": 2,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "ms"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "立ち上がり attack_ms・hold_ms 保ってから decay_ms の速さで指数に減衰（decay_ms 0 は減衰なし）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "env": {
                "additionalProperties": false,
                "properties": {
                  "attack_ms": {
                    "default": 0.5,
                    "description": "立ち上がり（ミリ秒）",
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "decay_ms": {
                    "default": 0,
                    "description": "1/e まで落ちる時間（ミリ秒）",
                    "maximum": 60000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "hold_ms": {
                    "default": 0,
                    "description": "保つ時間（ミリ秒）",
                    "maximum": 60000,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "頭を 1 倍・終わりを 0 倍へ直線で先細らせる（times 回重ねると急になる）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "fade": {
                "additionalProperties": false,
                "properties": {
                  "times": {
                    "default": 1,
                    "description": "重ねる回数",
                    "maximum": 8,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "仕上げ: 尾の無音を切り、25Hz の低域切り・8kHz の 2 段ローパス・頭 in_ms と尾 out_ms の直線の絞りを掛け、ピークを 1 にそろえる",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "finish": {
                "additionalProperties": false,
                "properties": {
                  "in_ms": {
                    "default": 2,
                    "description": "頭の絞り（ミリ秒）",
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "out_ms": {
                    "default": 12,
                    "description": "尾の絞り（ミリ秒）",
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "音量を by 倍にする",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "gain": {
                "additionalProperties": false,
                "properties": {
                  "by": {
                    "description": "倍率",
                    "maximum": 64,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "by"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "1 極のローパスを stages 段（hz より上をなだらかに落とす）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "lowpass": {
                "additionalProperties": false,
                "properties": {
                  "hz": {
                    "description": "切る所（Hz）",
                    "maximum": 20000,
                    "minimum": 1,
                    "type": "number"
                  },
                  "stages": {
                    "default": 1,
                    "description": "段の数",
                    "maximum": 4,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "hz"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "統合ラウドネスを lufs にそろえ、true peak が peak_dbtp を超えるなら倍率を下げる（倍率だけ。ループする音は輪の 1 周で測る）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "normalize": {
                "additionalProperties": false,
                "properties": {
                  "lufs": {
                    "description": "目標の統合ラウドネス（LUFS。省くと kind の目安）",
                    "maximum": 0,
                    "minimum": -60,
                    "type": "number"
                  },
                  "peak_dbtp": {
                    "description": "true peak の上限（dBTP。省くと snd.json の truePeakDbtp）",
                    "maximum": 0,
                    "minimum": -20,
                    "type": "number"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "隣のサンプルとの差 × 0.7（低い成分を落とした擦れ。times 回重ねる）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "rasp": {
                "additionalProperties": false,
                "properties": {
                  "times": {
                    "default": 1,
                    "description": "重ねる回数",
                    "maximum": 8,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "ratio 倍の速さで読み直す（高さが ratio 倍・長さが 1/ratio。線形の補間）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "resample": {
                "additionalProperties": false,
                "properties": {
                  "ratio": {
                    "description": "速さの倍率",
                    "maximum": 16,
                    "minimum": 0.0625,
                    "type": "number"
                  }
                },
                "required": [
                  "ratio"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "部屋の響き（櫛形 8 本 + 全域通過 4 本の Freeverb 型。左右で長さをずらして広げる）を wet だけ足す",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "reverb": {
                "additionalProperties": false,
                "properties": {
                  "damp": {
                    "default": 0.5,
                    "description": "響きの高域の減り（0〜1）",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "predelay_ms": {
                    "default": 0,
                    "description": "響きの始まりの遅れ（ミリ秒）",
                    "maximum": 200,
                    "minimum": 0,
                    "type": "number"
                  },
                  "room": {
                    "default": 0.5,
                    "description": "部屋の大きさ（0〜1。響きの長さ）",
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "wet": {
                    "default": 0.2,
                    "description": "響きの量",
                    "maximum": 2,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "音量を level/15 から every_ms ごとに 1 段ずつ下げる（0 で止まる。16 段の音量包絡）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "steps": {
                "additionalProperties": false,
                "properties": {
                  "every_ms": {
                    "default": 15.625,
                    "description": "1 段下げる間（ミリ秒。0 は下げない）",
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "number"
                  },
                  "level": {
                    "default": 15,
                    "description": "初めの段（0〜15）",
                    "maximum": 15,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "2 極のステートバリアブルフィルタ。中心を hz から to_hz へ指数で動かす（mode = band・low）",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "svf": {
                "additionalProperties": false,
                "properties": {
                  "gain": {
                    "default": 1,
                    "description": "出口の倍率",
                    "maximum": 8,
                    "minimum": 0,
                    "type": "number"
                  },
                  "hz": {
                    "description": "頭の中心（Hz）",
                    "maximum": 20000,
                    "minimum": 1,
                    "type": "number"
                  },
                  "mode": {
                    "default": "band",
                    "description": "出口（band = 中心のまわり・low = 中心より下）",
                    "enum": [
                      "band",
                      "low"
                    ]
                  },
                  "q": {
                    "default": 0.6,
                    "description": "減衰（小さいほど鋭く鳴る）",
                    "maximum": 2,
                    "minimum": 0.01,
                    "type": "number"
                  },
                  "to_hz": {
                    "description": "終わりの中心（Hz。省くと動かない）",
                    "maximum": 20000,
                    "minimum": 1,
                    "type": "number"
                  }
                },
                "required": [
                  "hz"
                ],
                "type": "object"
              }
            },
            "type": "object"
          }
        ]
      },
      "type": "array"
