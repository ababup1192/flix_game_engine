                          "description": "長さ（ミリ秒）",
                          "maximum": 600000,
                          "minimum": 0,
                          "type": "number"
                        },
                        "to_hz": {
                          "description": "滑って着く高さ（Hz。省くと滑らない）",
                          "maximum": 20000,
                          "minimum": 1,
                          "type": "number"
                        }
