                        },
                        "ms": {
                          "description": "長さ（ミリ秒）",
                          "maximum": 600000,
                          "minimum": 0,
                          "type": "number"
                        },
                        "to_hz": {
                          "description": "回す速さの着く先（比が一定の速さで滑る。省くと滑らない）",
                          "maximum": 1048576,
                          "minimum": 1,
                          "type": "number"
                        }
                      },
                      "required": [
                        "ms"
