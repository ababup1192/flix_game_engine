{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bpm": {
      "description": "速さ（4 分音符/分。既定 120）",
      "type": "number"
    },
    "chains": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "名前 → phrase の並び（\"名前 +半音\" で移調）",
      "type": "object"
    },
    "channels": {
      "description": "チャンネルの並び [{name, part（pulse・triangle・noise・wave。機種の外の saw・sine）, vol, pan（-1〜1）, cents（デチューン）, sub（1 オクターブ下のサイン。機種の外）, duck（サイドチェインで沈める）, send: {reverb, delay}, unison, filter, pitchenv, fm}]。rows の鍵はこの名前。機種の外の音色は下の表",
      "items": {
        "additionalProperties": false,
        "properties": {
          "cents": {
            "type": "number"
          },
          "duck": {
            "type": "boolean"
          },
          "filter": {
            "additionalProperties": false,
            "description": "2 極のフィルタ（mode = low・band・high、q 0.3〜12）。切る所 hz から、鳴らした頭に env オクターブ（-8〜8）上がり env_ms で戻る。sweep = [[小節, Hz], …] は頭からの小節で切る所を動かす（間は比で滑らか・ループの 2 周目も同じ位置）",
            "properties": {
              "env": {
                "maximum": 8,
                "minimum": -8,
                "type": "number"
              },
              "env_ms": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "hz": {
                "maximum": 20000,
                "minimum": 20,
                "type": "number"
              },
              "mode": {
                "enum": [
                  "low",
                  "band",
                  "high"
                ]
              },
              "q": {
                "maximum": 12,
                "minimum": 0.3,
                "type": "number"
              },
              "sweep": {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "fm": {
            "additionalProperties": false,
            "description": "2 オペレータの FM（part が sine だけ）。サインの高さを ratio（0.25〜16）倍のサインで index（0〜20 ラジアン）だけ揺らし、深さは鳴らした頭（打ち直しも）から decay_ms で floor（0〜1）の割合まで減る。ratio 1 で柔らかいエレピ・3.5 や 7 でベル・オルゴール",
            "properties": {
              "decay_ms": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "floor": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "index": {
                "maximum": 20,
                "minimum": 0,
                "type": "number"
              },
              "ratio": {
                "maximum": 16,
                "minimum": 0.25,
                "type": "number"
              }
            },
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "pan": {
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "part": {
            "enum": [
              "pulse",
              "triangle",
              "noise",
              "wave",
              "saw",
              "sine"
            ]
          },
          "pitchenv": {
            "additionalProperties": false,
            "description": "鳴らした頭（打ち直しも）に semis 半音（-60〜60）上から ms の速さで指数に落ちる",
            "properties": {
              "ms": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "semis": {
                "maximum": 60,
                "minimum": -60,
                "type": "number"
              }
            },
            "type": "object"
          },
          "send": {
            "additionalProperties": false,
            "properties": {
              "delay": {
                "minimum": 0,
                "type": "number"
              },
              "reverb": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "sub": {
            "minimum": 0,
            "type": "number"
          },
          "unison": {
            "additionalProperties": false,
            "description": "同じ音を voices 本（2〜7）、cents（0〜100）の幅でずらして重ね、左右へ width（0〜1）だけ広げる。sub は 1 本目だけ",
            "properties": {
              "cents": {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              "voices": {
                "maximum": 7,
                "minimum": 2,
                "type": "integer"
              },
              "width": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "vol": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "name",
          "part"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fx": {
      "description": "機種の外の厚み {reverb: {room, damp, wet, predelay_ms}, delay: {steps（段）, feedback, wet, pingpong, lowpass}, sidechain: {key（合図の楽器の名前の並び）, depth_db, release_ms}}",
      "type": "object"
    },
    "gain": {
      "description": "全体の倍率",
      "type": "number"
    },
    "groove": {
      "description": "段ごとの tick の並び（[7, 5] で跳ねる。平均が拍の速さを決める・長さは 16 を割り切る）",
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "instruments": {
      "additionalProperties": {
        "properties": {
          "arp": {
            "description": "音程（半音）の表。arp_fixed: true なら音の高さそのもの（太鼓）",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "type": "array"
              }
            ]
          },
          "arp_fixed": {
            "type": "boolean"
          },
          "duty": {
            "description": "デューティ（12・25・50・75）・波形の名前・雑音（long・short）の表",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "type": "array"
              }
            ]
          },
          "note": {
            "type": "string"
          },
          "pitch": {
            "description": "音程のずれ（セント）の表",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "type": "array"
              }
            ]
          },
          "rows": {
            "description": "今の形の表（1 行に vol・pitch・cents・wave・cmd）",
            "type": "array"
          },
          "speed": {
            "description": "表を何 tick ごとに進めるか（既定 1）",
            "minimum": 1,
            "type": "integer"
          },
          "vib": {
            "description": "\"hz cents 遅れの tick\"（遅れてかかるビブラート）",
            "type": "string"
          },
          "vol": {
            "description": "音量 0〜15 の表（\"15 13 12 | 11 10 / 6 3 0\": | の後をループ・/ の後は離した後に流す）",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "type": "array"
              }
            ]
          }
        },
        "type": "object"
      },
      "description": "楽器（*.instrument.json と同じ形。譜面の方が勝つ）",
      "type": "object"
    },
    "loop": {
      "description": "ループの頭の rows の行（無ければループしない）",
      "type": "integer"
    },
    "mix": {
      "description": "今の形の 5 本のチャンネルの倍率（channels を書かない時だけ）",
      "type": "object"
    },
    "note": {
      "type": "string"
    },
    "phrases": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "maxItems": 16,
        "type": "array"
      },
      "description": "名前 → 16 段の段の文字",
      "type": "object"
    },
    "rows": {
      "description": "曲の並び（行ごとに {チャンネル: chain}）",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "ticks": {
      "description": "1 段の tick（既定 6）",
      "minimum": 1,
      "type": "integer"
    },
    "version": {
      "type": "integer"
    },
    "waves": {
      "description": "波形メモリの形（名前 → 32 段 × 0〜15）",
      "type": "object"
    }
  },
  "title": "chip（song の op が読む譜面）",
  "type": "object"
}
