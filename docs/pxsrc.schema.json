{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ドット絵の指定 (*.pxsrc.json)",
  "description": "fge px build が読む。生成物（bin/fge px ops --md）。直すのは go/internal/px の Op の構造体。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "sprites"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "label": "名前"
    },
    "note": {
      "type": "string",
      "label": "メモ",
      "description": "いじると何が変わるか"
    },
    "target": {
      "type": "string",
      "description": "書き出す sprite.json（atelier/ の下。assets/ は不可）"
    },
    "base": {
      "type": "string",
      "description": "差し替える元の sprite.json（省くと target）"
    },
    "palette": {
      "type": "string",
      "description": "色票の Doc（base が無いときの paletteFile）"
    },
    "gate": {
      "type": "string",
      "description": "色の門の Doc（*.colorgate.json）。外れたら書き出さない"
    },
    "indent": {
      "description": "書き出す字下げ（\"tab\" か空白の数。省くと base の字面に合わせる）",
      "oneOf": [
        {
          "const": "tab"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      ]
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "description": "光（Doc に 1 か所だけ。op はここを読む）",
      "properties": {
        "dir": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3,
          "description": "光の来る向き [x, y] か [x, y, 高さ]（左上は [-1, -1]）",
          "default": [
            -1,
            -1
          ]
        },
        "gloss": {
          "type": "string",
          "description": "つやの色キー（色の名前 gloss）"
        },
        "ground": {
          "type": "string",
          "description": "絵を置く地の色（色キーか #rrggbb。見本の地と ground-contrast の検査）"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ramps": {
      "type": "object",
      "description": "名前 → 色キーの並び（暗 → 明）",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "shapes": {
      "type": "object",
      "description": "名前 → 形（{\"ref\": 名前} で引く）",
      "additionalProperties": {
        "$ref": "#/definitions/shape"
      }
    },
    "macros": {
      "type": "object",
      "description": "名前 → op の列（op use で差し込む）",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/op"
        }
      }
    },
    "sprites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/sprite"
      }
    }
  },
  "definitions": {
    "shape": {
      "description": "形（符号付き距離。画素の中心が内側なら塗る）",
      "oneOf": [
        {
          "type": "object",
          "description": "輪（中心から r の円に沿った、幅 2w の帯）",
          "additionalProperties": false,
          "required": [
            "annulus"
          ],
          "properties": {
            "annulus": {
              "description": "[cx, cy, r, w]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "description": "両端の丸い棒",
          "additionalProperties": false,
          "required": [
            "capsule"
          ],
          "properties": {
            "capsule": {
              "description": "[ax, ay, bx, by, r]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 5,
              "maxItems": 5
            }
          }
        },
        {
          "type": "object",
          "description": "丸",
          "additionalProperties": false,
          "required": [
            "disk"
          ],
          "properties": {
            "disk": {
              "description": "[cx, cy, r]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "type": "object",
          "description": "楕円",
          "additionalProperties": false,
          "required": [
            "ellipse"
          ],
          "properties": {
            "ellipse": {
              "description": "[cx, cy, rx, ry]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "description": "積（全部の中）",
          "additionalProperties": false,
          "required": [
            "inter"
          ],
          "properties": {
            "inter": {
              "description": "[形, 形, ...]（2 つ以上）",
              "type": "array",
              "items": {
                "$ref": "#/definitions/shape"
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "description": "rows で画素を直に指す（'.' と ' ' が外）",
          "additionalProperties": false,
          "required": [
            "mask"
          ],
          "properties": {
            "mask": {
              "description": "文字の行",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "at": {
              "description": "左上の位置 [x, y]",
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2,
              "default": [
                0,
                0
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "折れ線に太さを付けた物（角と端は丸い）",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "description": "[[x, y], ...]（2 点以上）",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2
            },
            "width": {
              "description": "太さ",
              "type": "number",
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "description": "多角形（点を順に結ぶ）",
          "additionalProperties": false,
          "required": [
            "poly"
          ],
          "properties": {
            "poly": {
              "description": "[[x, y], ...]（3 点以上）",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3
            }
          }
        },
        {
          "type": "object",
          "description": "角丸の矩形（中心と半分の幅）",
          "additionalProperties": false,
          "required": [
            "rbox"
          ],
          "properties": {
            "rbox": {
              "description": "[cx, cy, hw, hh, r]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 5,
              "maxItems": 5
            }
          }
        },
        {
          "type": "object",
          "description": "画素に揃った矩形（x..x+w-1・y..y+h-1 の画素）",
          "additionalProperties": false,
          "required": [
            "rect"
          ],
          "properties": {
            "rect": {
              "description": "[x, y, w, h]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "description": "shapes の名前つきの形を引く",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "description": "shapes の名前",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "description": "形を回す（1 周 = 1.0）",
          "additionalProperties": false,
          "required": [
            "rotate",
            "about",
            "of"
          ],
          "properties": {
            "rotate": {
              "description": "回す量（周。正は時計回り）",
              "type": "number"
            },
            "about": {
              "description": "回す中心 [x, y]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "of": {
              "description": "元の形",
              "$ref": "#/definitions/shape"
            }
          }
        },
        {
          "type": "object",
          "description": "画素の範囲で書く角丸の矩形（x0..x1・y0..y1 の画素を含み、角は内側へ r の丸。塗りの判定専用。smoothUnion・rounded には使えない）",
          "additionalProperties": false,
          "required": [
            "roundRect"
          ],
          "properties": {
            "roundRect": {
              "description": "[x0, y0, x1, y1, r]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 5,
              "maxItems": 5
            }
          }
        },
        {
          "type": "object",
          "description": "形を太らせて角を丸める",
          "additionalProperties": false,
          "required": [
            "rounded",
            "of"
          ],
          "properties": {
            "rounded": {
              "description": "太らせる量",
              "type": "number"
            },
            "of": {
              "description": "元の形",
              "$ref": "#/definitions/shape"
            }
          }
        },
        {
          "type": "object",
          "description": "なめらかにつないだ和",
          "additionalProperties": false,
          "required": [
            "smoothUnion"
          ],
          "properties": {
            "smoothUnion": {
              "description": "[形, 形]",
              "type": "array",
              "items": {
                "$ref": "#/definitions/shape"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "k": {
              "description": "つなぎの幅（0 より大きい）",
              "type": "number",
              "default": 1
            }
          }
        },
        {
          "type": "object",
          "description": "星（外と内の半径を交互に結ぶ多角形）",
          "additionalProperties": false,
          "required": [
            "star"
          ],
          "properties": {
            "star": {
              "description": "[cx, cy, rOut, rIn]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "n": {
              "description": "角の数",
              "type": "integer",
              "default": 5
            },
            "rot": {
              "description": "最初の角の向き（ラジアン。既定は真上）",
              "type": "number",
              "default": -1.5707963267948966
            }
          }
        },
        {
          "type": "object",
          "description": "先細りの棒（塗りの判定専用。smoothUnion・rounded には使えない）",
          "additionalProperties": false,
          "required": [
            "taper"
          ],
          "properties": {
            "taper": {
              "description": "[ax, ay, bx, by, r0, r1]",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          }
        },
        {
          "type": "object",
          "description": "和（どれかの中）",
          "additionalProperties": false,
          "required": [
            "union"
          ],
          "properties": {
            "union": {
              "description": "[形, 形, ...]（2 つ以上）",
              "type": "array",
              "items": {
                "$ref": "#/definitions/shape"
              },
              "minItems": 2
            }
          }
        }
      ]
    },
    "color": {
      "type": "string",
      "description": "色: ink・shade・mid・light（部品のランプの 0〜3 段）・ramp[i]（ramp[-1] は一番明るい段）・gloss（light.gloss）・色キー・\"\"（透明）"
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "description": "小物の陰の段: 光の側の縁を lit、影の側の縁（と影の向きへ 2 つ先が外の画素）を dark、中を face",
          "additionalProperties": false,
          "required": [
            "bevel"
          ],
          "properties": {
            "bevel": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "description": "形（省くと部品の塊）",
                  "$ref": "#/definitions/shape"
                },
                "lit": {
                  "description": "光の側の縁の色",
                  "$ref": "#/definitions/color",
                  "default": "light"
                },
                "face": {
                  "description": "中の色",
                  "$ref": "#/definitions/color",
                  "default": "mid"
                },
                "dark": {
                  "description": "影の側の縁の色",
                  "$ref": "#/definitions/color",
                  "default": "shade"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "角丸の板: 斜めの帯で 光・地・影、縁の 1px につや（光の側）と墨（影の側）、外側に墨の輪郭（格子は正方形）",
          "additionalProperties": false,
          "required": [
            "bevel_box"
          ],
          "properties": {
            "bevel_box": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "radius": {
                  "description": "角の丸みの半径",
                  "type": "number",
                  "default": 6.5
                },
                "inset": {
                  "description": "格子の縁からの余白",
                  "type": "number",
                  "default": 2
                },
                "bands": {
                  "description": "光・地・影の境目（0〜1。左上の角が 0）",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "default": [
                    0.3,
                    0.72
                  ]
                },
                "gloss_until": {
                  "description": "縁のつやを置く範囲（x+y が格子の幅のこの割合まで）",
                  "type": "number",
                  "default": 0.8
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "親（on）の塊の割れ目: 墨の 1px と、その右下に切り口のつや 1px",
          "additionalProperties": false,
          "required": [
            "crack"
          ],
          "properties": {
            "crack": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "description": "折れ線の点 [[x, y], ...]（小数も可。画素には偶数丸めで落とす）",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 2
                }
              },
              "required": [
                "points"
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "2 次ベジェを 1px の連なった線で引く（alt で 1 画素ごとに色を交互に・avoid の形の中は飛ばす）",
          "additionalProperties": false,
          "required": [
            "curve"
          ],
          "properties": {
            "curve": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "points": {
                  "description": "始点・制御点・終点 [[x, y], [x, y], [x, y]]",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "color": {
                  "description": "色（ink・shade・mid・light・ramp[i]・gloss・色キー。\"\" で透明へ抜く）",
                  "$ref": "#/definitions/color"
                },
                "alt": {
                  "description": "1 画素おきに置く 2 つ目の色（省くと color だけ）",
                  "$ref": "#/definitions/color"
                },
                "avoid": {
                  "description": "画素の中心がこの形の中なら置かない（数にも入れない）",
                  "$ref": "#/definitions/shape"
                },
                "steps": {
                  "description": "曲線を刻む数（多いほど取りこぼしが無い）",
                  "type": "integer",
                  "default": 400
                }
              },
              "required": [
                "points",
                "color"
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "塊をアイコンの作りで塗る: 縁（4 近傍で外に接する画素）を edge、光の側の縁のすぐ内側 1 段を top、残りを face",
          "additionalProperties": false,
          "required": [
            "emblem"
          ],
          "properties": {
            "emblem": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "description": "形（省くと部品の塊）",
                  "$ref": "#/definitions/shape"
                },
                "edge": {
                  "description": "縁の色",
                  "$ref": "#/definitions/color",
                  "default": "ink"
                },
                "face": {
                  "description": "面の色",
                  "$ref": "#/definitions/color",
                  "default": "mid"
                },
                "top": {
                  "description": "光の側（light.dir の上下）のつやの色",
                  "$ref": "#/definitions/color",
                  "default": "light"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "塊を 1 色で塗る",
          "additionalProperties": false,
          "required": [
            "fill"
          ],
          "properties": {
            "fill": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "description": "形（省くと部品の塊）",
                  "$ref": "#/definitions/shape"
                },
                "color": {
                  "description": "色（ink・shade・mid・light・ramp[i]・gloss・色キー。\"\" で透明へ抜く）",
                  "$ref": "#/definitions/color"
                }
              },
              "required": [
                "color"
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "格子全体を左右（x）か上下（y）に返す（右向きのコマから左向きを作る）",
          "additionalProperties": false,
          "required": [
            "flip"
          ],
          "properties": {
            "flip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "description": "\"x\" は左右・\"y\" は上下",
                  "enum": [
                    "x",
                    "y"
                  ],
                  "default": "x"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "白抜きの記号: 形をつやの色で塗り、右下へ墨の影を 1px",
          "additionalProperties": false,
          "required": [
            "glyph"
          ],
          "properties": {
            "glyph": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "description": "形（省くと部品の塊）",
                  "$ref": "#/definitions/shape"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "description": "文字の格子の白抜きの記号: '.' と空白でない字の画素を color で、その右下 1px に shadow の影（影を先に置く）",
          "additionalProperties": false,
          "required": [
            "glyph_rows"
          ],
          "properties": {
            "glyph_rows": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "description": "記号の左上 [x, y]",
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "rows": {
                  "description": "記号の行（'.' と空白は外）",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "color": {
                  "description": "記号の色",
                  "$ref": "#/definitions/color",
                  "default": "gloss"
                },
                "shadow": {
                  "description": "右下 1px の影の色",
                  "$ref": "#/definitions/color",
                  "default": "shade"
                }
              },
              "required": [
                "at",
                "rows"
              ]
            }
          }
        },
        {
          "type": "object",
          "description": "部品の塊の塗ってある画素を、中心から光の向き（light.dir）へどれだけ寄っているかで lit・base・dark の 3 段に塗り分ける",
          "additionalProperties": false,
          "required": [
            "light_bands"
          ],
          "properties": {
            "light_bands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "center": {
                  "description": "中心 [x, y]（画素の番号）",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "cut": {
                  "description": "[a, b]: 光への寄り（光の向きの符号で dx・dy を足した値）が a より大きければ lit、b より小さければ dark",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "default": [
                    0,
                    0
                  ]
                },
                "lit": {
                  "description": "光の側の色",
                  "$ref": "#/definitions/color",
                  "default": "light"
                },
                "base": {
                  "description": "あいだの色",
                  "$ref": "#/definitions/color",
                  "default": "mid"
                },
                "dark": {
