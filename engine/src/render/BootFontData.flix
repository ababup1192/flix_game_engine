// BootFontData — 生成物。手で編集しない（`make boot-font` で生成し直す）。
//
// 起動画面 (Splash) が使う組み込みフォントとロゴの素データ。fpkg は .flix しか運べないので、
// ビットマップを 16 進の文字列として持つ。読み解くのは BootFont。
//
// 素材: PixelMplus10-Regular.ttf / 10px / M+ FONT LICENSE
//       docs/brand/flix_ge_icon.png
pub mod BootFontData {

    /// 素材の出どころ（ライセンス表記のため実行時にも名乗れるようにしてある）。
    pub def source(): String = "PixelMplus10-Regular.ttf / 10px / M+ FONT LICENSE"

    /// アトラスの一辺。Text の表示サイズ計算がアトラスを正方と決め打つので正方。
    pub def side(): Int32 = 128

    /// 生成ピクセル高さ。この大きさで出すとドットが 1:1 で揃う。
    pub def fontSize(): Float64 = 10.0

    pub def ascent(): Float64 = 9.0
    pub def descent(): Float64 = 2.0
    pub def lineGap(): Float64 = 0.0

    /// 字の高さ（アトラス上の 1 マスの縦）。
    pub def cellH(): Int32 = 11

    /// 1 字 14 桁: 文字番号(4) 左(3) 上(3) 幅(2) 送り幅(2)。すべて 16 進。
    pub def glyphsHex(): String = ""

    /// アトラスの 1bit 画素。行優先・上位ビットが左・16 進 2 桁 = 1 バイト。
    pub def bitsHex(): List[String] =
        "" ::
        Nil

    /// ロゴの一辺。
    pub def logoSide(): Int32 = 64

    /// ロゴの色票。1 色 8 桁 rrggbbaa。先頭は透明。
    pub def logoPaletteHex(): String = "00000000080a0dff0b0d11ff3ba3e8ff0c0f14ff101c26ff213f57ff7059aaff6a529fff6a519fff2d617dff5e5095ff52c0f0ff71d5f6ff5e5faaff337ee1ff"

    /// ロゴの画素。色票の番号を 4bit で 1 画素、上位が左。
    pub def logoHex(): List[String] =
        "" ::
        Nil
}
