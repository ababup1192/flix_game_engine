@@ -0,0 +1,6 @@
+[package]
+version     = "0.1.0"
+flix        = "0.78.0"
+
+[dependencies]
+"github:ababup1192/flix_game_engine" = { version = "0.81.0", mount = "fge", security = "unrestricted" }
diff --git a/bench/par/src/Main.flix b/bench/par/src/Main.flix
new file mode 100644
index 00000000..8c82eefd
--- /dev/null
+++ b/bench/par/src/Main.flix
@@ -0,0 +1,200 @@
+// 入口。Par（並列の map と join）の速さを、1 スレッドの Vector.map・順に呼ぶ形と並べて測る（窓は開かない）。
+//   main          … 「1 スレッドより遅くならない」門。一番軽い f を境目のすぐ上（16,384・24,576・32,768 個）で
+//                   Vector.map と Par.map を交互に測り、Par.map が 1 スレッドから門の幅の内なら緑（外なら exit 1）。
+//                   あわせて join の軽い系（順に呼ぶ道に落ちる）が順に呼ぶ形から門の幅の内かを見る。
+//   ParBench.sizes … minChunk を決めるための表（大きさ × 塊の数・重い join・標準の Map.map）。門ではなく知らせるだけ。
+// コアの数を変えて測るのは JAVA_TOOL_OPTIONS=-XX:ActiveProcessorCount=<n>（Makefile の gate-cores）。
+mod ParBench {
+    use fge::Par
+
+    import java.lang.System
+
+    /// 物 1 つ（位置と速さ）。
+    pub type alias Body = { x = Float64, y = Float64, vx = Float64, vy = Float64 }
+
+    /// 物 1 つを w 回だけ小さな式で進める（w = 1 が一番軽い物ごとの更新）。
+    def stepBody(w: Int32, body: Body): Body =
+        def loop(i, x, y, vx, vy) =
+            if (i >= w) { x = x, y = y, vx = vx, vy = vy }
+            else {
+                let ax = 0.0 - x * 0.001 + vy * 0.0001;
+                let ay = 0.0 - y * 0.001 - vx * 0.0001;
+                let nvx = (vx + ax * 0.016) * 0.999;
+                let nvy = (vy + ay * 0.016) * 0.999;
+                loop(i + 1, x + nvx * 0.016, y + nvy * 0.016, nvx, nvy)
+            };
+        loop(0, body#x, body#y, body#vx, body#vy)
+
+    def bodies(n: Int32): Vector[Body] =
+        Vector.range(0, n) |> Vector.map(i -> { let f = Int32.toFloat64(i); { x = f, y = f * 0.5, vx = 1.0, vy = -0.5 } })
+
+    /// 並びを 1 本で畳んだ値（測る仕事の結果を捨てさせない）。
+    def checksum(xs: Vector[Body]): Float64 =
+        Vector.foldLeft((acc, body) -> acc + body#x * 3.0 + body#y * 7.0 + body#vx + body#vy, 0.0, xs)
+
+    /// 1 回の時間（ns）。純粋な式が時計の外へ動かないよう、結果を IO の Ref へ書いてから時計を読む。
+    def timeOnce(cell: Ref[Float64, Static], work: Unit -> Float64): Int64 \ IO =
+        let started = System.nanoTime();
+        Ref.put(work(), cell);
+        System.nanoTime() - started
+
+    /// reps 回の中央値（ns）。
+    def medianNs(reps: Int32, work: Unit -> Float64): Int64 \ IO =
+        let cell = Ref.fresh(Static, 0.0);
+        let samples = List.range(0, reps) |> List.map(_ -> timeOnce(cell, work)) |> List.sort;
+        List.nth(reps / 2, samples) |> Option.getWithDefault(0i64)
+
+    def warm(times: Int32, work: Unit -> Float64): Unit \ IO =
+        let cell = Ref.fresh(Static, 0.0);
+        List.range(0, times) |> List.forEach(_ -> Ref.put(work(), cell))
+
+    def medianOf(xs: List[Int64]): Int64 =
+        List.sort(xs) |> List.nth(List.length(xs) / 2) |> Option.getWithDefault(0i64)
+
+    def us(ns: Int64): String =
+        let tenths = Int64.toFloat64(ns) / 100.0 |> Float64.round;
+        Float64.toString(tenths / 10.0)
+
+    def percent(ratio: Float64): String =
+        Float64.toString(Float64.round(ratio * 1000.0) / 10.0)
+
+    /// 交互に測った結果。base と again は同じ 1 スレッドの仕事を 2 回（揺れの物差し）。
+    type alias Paired = { base = Int64, again = Int64, candidate = Int64 }
+
+    /// base → candidate → base を 1 回ずつ交互に samples 組流し、それぞれの中央値を取る（A B A を 1 回ごとに替えるので、
+    /// 時間とともに変わる物 — JIT・GC・高性能と高効率のコアの付け替え — が 3 つに同じように乗る）。
+    def alternate(samples: Int32, base: Unit -> Float64, candidate: Unit -> Float64): Paired \ IO =
+        let cell = Ref.fresh(Static, 0.0);
+        let rows = List.range(0, samples) |> List.map(_ -> {
+            let b = timeOnce(cell, base);
+            let c = timeOnce(cell, candidate);
+            let a = timeOnce(cell, base);
+            (b, c, a)
+        });
+        { base = rows |> List.map(r -> { let (b, _, _) = r; b }) |> medianOf,
+          candidate = rows |> List.map(r -> { let (_, c, _) = r; c }) |> medianOf,
+          again = rows |> List.map(r -> { let (_, _, a) = r; a }) |> medianOf }
+
+    /// 門の幅: 目標 target と、揺れ（同じ仕事どうしの差）の 2 倍の大きい方。
+    def gateWidth(target: Float64, paired: Paired): Float64 =
+        let base = Int64.toFloat64(paired#base);
+        let noise = if (base <= 0.0) 0.0 else Float64.abs(Int64.toFloat64(paired#again) - base) / base;
+        Float64.max(target, noise * 2.0)
+
+    /// 1 行を出して、門の内なら true。
+    def report(label: String, target: Float64, paired: Paired): Bool \ IO =
+        let base = Int64.toFloat64(paired#base);
+        let ratio = if (base <= 0.0) 1.0 else Int64.toFloat64(paired#candidate) / base;
+        let width = gateWidth(target, paired);
+        let pass = ratio <= 1.0 + width;
+        let noise = if (base <= 0.0) 0.0 else Float64.abs(Int64.toFloat64(paired#again) - base) / base;
+        println("${label}  1 スレッド ${us(paired#base)} µs（もう 1 回 ${us(paired#again)}・揺れ ${percent(noise)}%）  Par ${us(paired#candidate)} µs  比 ${percent(ratio)}%  門 +${percent(width)}%  ${if (pass) "緑" else "赤"}");
+        pass
+
+    def samples(): Int32 = 401
+
+    /// 一番軽い f（w = 1）を境目のすぐ上で測る行。
+    def mapGateRow(n: Int32): Bool \ IO =
+        let xs = bodies(n);
+        let base = () -> checksum(Vector.map(b -> stepBody(1, b), xs));
+        let candidate = () -> checksum(Par.map(b -> stepBody(1, b), xs));
+        warm(200, base);
+        warm(200, candidate);
+        report("map    n=${n} w=1", 0.05, alternate(samples(), base, candidate))
+
+    /// Par を使わずに系を順に呼ぶ形（比べの元）。
+    // WhyNot: 比べの元を system(10)() + system(11)() と直に書かない — Flix の最適化が w の定数をラムダの中へ書き写して
+    //   ループを特化するので、関数で受けて呼ぶ Par.join の側と同じ仕事にならない（同じ順の呼び出しで 1 割ほど差が出た）。
+    def inOrder2(f: Unit -> a, g: Unit -> b): (a, b) = (f(), g())
+
+    def gated2(size: Par.Work, f: Unit -> a, g: Unit -> b): (a, b) =
+        if (size#work < size#minWork) (f(), g()) else (g(), f()) |> swapBack
+
+    def swapBack(p: (b, a)): (a, b) = let (x, y) = p; (y, x)
+
+    def inOrder4(f: Unit -> a, g: Unit -> b, h: Unit -> c, i: Unit -> d): (a, b, c, d) = (f(), g(), h(), i())
+
+    /// 軽い系 2 本・4 本（1 本で 30〜120 µs）。work が minWork に満たないので順に呼ぶ道に落ちる。
+    def lightJoinRow(systems: Int32): Bool \ IO =
+        let xs = bodies(512);
+        let system = (w: Int32) -> () -> checksum(Vector.map(b -> stepBody(w, b), xs));
+        let size = { work = 512 * systems, minWork = Par.defaultMinChunk() * 2 };
+        let base = if (systems == 2) () -> { let (a, b) = inOrder2(system(10), system(11)); a + b }
+                   else () -> { let (a, b, c, d) = inOrder4(system(10), system(11), system(12), system(13)); a + b + c + d };
+        let candidate = if (systems == 2) () -> { let (a, b) = gated2(size, system(10), system(11)); a + b }
+                        else () -> { let (a, b, c, d) = Par.join4(size, system(10), system(11), system(12), system(13)); a + b + c + d };
+        warm(300, base);
+        warm(300, candidate);
+        report("join${systems}  軽い系（512 個 × w 10）", 0.05, alternate(samples(), base, candidate))
+
+    /// 測る前に全部の行の仕事を温める（先に測る行だけが JIT と GC の落ち着かない時間に当たらないように）。
+    def warmAll(): Unit \ IO =
+        let xs = bodies(32768);
+        let ys = bodies(512);
+        let light = (w: Int32) -> () -> checksum(Vector.map(b -> stepBody(w, b), ys));
+        List.range(0, 3) |> List.forEach(_ -> {
+            warm(300, () -> checksum(Vector.map(b -> stepBody(1, b), xs)));
+            warm(300, () -> checksum(Par.map(b -> stepBody(1, b), xs)));
+            warm(2000, () -> { let (a, b) = inOrder2(light(10), light(11)); a + b });
+            warm(2000, () -> { let (a, b) = Par.join2({ work = 0, minWork = 1 }, light(10), light(11)); a + b })
+        })
+
+    /// 門を流し、どれかが門の外なら exit 1。
+    pub def gate(): Unit \ IO =
+        println("[par] workers = ${Par.workers()}・minChunk の既定 = ${Par.defaultMinChunk()}・A B A を 1 回ずつ交互に ${samples()} 組流した中央値");
+        warmAll();
+        let results = ((16384 :: 24576 :: 32768 :: Nil) |> List.map(mapGateRow)) ::: (lightJoinRow(2) :: lightJoinRow(4) :: Nil);
+        if (List.forAll(identity, results)) println("[par] 門: 緑")
+        else {
+            println("[par] 門: 赤（Par が 1 スレッドから門の幅を超えて遅い）");
+            System.exit(1)
+        }
+
+    /// 大きさ × 塊の数の表（一番軽い f）。minChunk の既定を決める材料。
+    def sizeRow(n: Int32): Unit \ IO =
+        let xs = bodies(n);
+        let f = b -> stepBody(1, b);
+        let seq = () -> checksum(Vector.map(f, xs));
+        let chunked = (k: Int32) -> () -> checksum(Par.Internal.mapInChunks(k, f, xs));
+        let ks = 2 :: 4 :: 12 :: 24 :: 48 :: Nil;
+        warm(200, seq);
+        ks |> List.forEach(k -> warm(200, chunked(k)));
+        let seqNs = medianNs(41, seq);
+        let cells = ks |> List.map(k -> "k=${k} ${us(medianNs(41, chunked(k)))}") |> List.join("  ");
+        println("n=${n}  1 スレッド ${us(seqNs)} µs（1 要素 ${Int64.toString(seqNs / Int32.toInt64(n))} ns）  ${cells}")
+
+    /// 重い系 2 本・4 本（1 本で 0.5〜4 ms）を join で回した時と順に呼んだ時。
+    def heavyJoinRow(n: Int32, w: Int32): Unit \ IO =
+        let xs = bodies(n);
+        let system = (k: Int32) -> () -> checksum(Vector.map(b -> stepBody(w + k, b), xs));
+        let size = { work = n * w, minWork = 0 };
+        let seq2 = () -> system(0)() + system(1)();
+        let par2 = () -> { let (a, b) = Par.join2(size, system(0), system(1)); a + b };
+        let seq4 = () -> system(0)() + system(1)() + system(2)() + system(3)();
+        let par4 = () -> { let (a, b, c, d) = Par.join4(size, system(0), system(1), system(2), system(3)); a + b + c + d };
+        warm(30, seq2); warm(30, par2); warm(30, seq4); warm(30, par4);
+        println("join 重い系 n=${n} w=${w}  2 本: 順 ${us(medianNs(21, seq2))} µs・join2 ${us(medianNs(21, par2))} µs  4 本: 順 ${us(medianNs(21, seq4))} µs・join4 ${us(medianNs(21, par4))} µs")
+
+    /// 標準の Map.map（純粋な f なら木が大きい時に勝手に並列）と、1 本で組み直す foldLeft の形。
+    def mapMapRow(n: Int32): Unit \ IO =
+        let m = bodies(n) |> Vector.toList |> List.zipWithIndex |> List.toMap;
+        let f = b -> stepBody(1, b);
+        let sumMap = (mm: Map[Int32, Body]) -> Map.foldLeft((acc, body) -> acc + body#x * 3.0 + body#y * 7.0 + body#vx + body#vy, 0.0, mm);
+        let viaMap = () -> sumMap(Map.map(f, m));
+        let viaFold = () -> sumMap(Map.foldLeftWithKey((acc, k, b) -> Map.insert(k, f(b), acc), Map.empty(), m));
+        warm(200, viaMap); warm(200, viaFold);
+        println("Map n=${n} w=1  Map.map ${us(medianNs(41, viaMap))} µs  foldLeft と insert ${us(medianNs(41, viaFold))} µs")
+
+    /// minChunk を決めるための表（門ではない）。
+    pub def sizes(): Unit \ IO =
+        println("[par] workers = ${Par.workers()}・一番軽い f（w = 1）・41 回の中央値・k は塊の数");
+        (4096 :: 8192 :: 12288 :: 16384 :: 24576 :: 32768 :: 65536 :: Nil) |> List.forEach(sizeRow);
+        heavyJoinRow(512, 100);
+        heavyJoinRow(512, 1000);
+        (1024 :: 2048 :: 4096 :: 8192 :: Nil) |> List.forEach(mapMapRow)
+
+}
+
+def main(): Unit \ IO = ParBench.gate()
+
+
