diff --git a/engine/src/core/Par.flix b/engine/src/core/Par.flix
new file mode 100644
index 00000000..d9a6eea5
--- /dev/null
+++ b/engine/src/core/Par.flix
@@ -0,0 +1,116 @@
+// Par — 純粋な関数を並列に回す口（並列の map と fork-join）。外から見て純粋で、結果はコアの数に関わらず 1 スレッドと同じ値。
+//
+// 決まり（どれも「コアの数で値が変わらない」ため）:
+//   1. 受けるのは純粋な関数だけ（IO の関数は型で止まる。effect の handler はスレッドをまたがない）。
+//   2. 結果は入力の並びの順に集める（終わった順に使わない）。
+//   3. 並列の畳み込みは置かない。合計などは map の後に呼ぶ側が 1 本で畳む（浮動小数の足す順を固定する）。
+//   4. 乱数は World の種と物の番号とコマ数から作る（Hash01 の形）。
+//   5. f から届く unsafe の状態（外から純粋に見える関数の中の可変の表）は、呼び出しごとに局所に置くか、スレッド安全な物にする。
+//
+// 並列にして得になるのは、1 スレッドで約 150 µs を超える仕事だけ（塊を回して集める代金が約 60〜120 µs ある）。
+// 軽い物は 1 本の道（Vector.map）に落ちる。1 本に戻すのは JVM の旗 -XX:ActiveProcessorCount=1（環境変数は読まない）。
+//
+// 使う側の決まり:
+//   - 結果をラムダの中で使うなら、ラムダの外で値を 1 回作ってから渡す（Flix の最適化は、ラムダの中で 1 回だけ使う
+//     純粋な let をラムダの中へ書き写す。`let ys = Par.map(..)` を行ごとのラムダで使うと、並列の束が行ごとに走りうる）。
+//   - 入れ子（join の中の map・塊の中の標準の Map.map）は書いてよい（値は変わらない）が、スレッドの数が掛け算で増えるので、
+//     内側には大きい minChunk を渡す。
+pub mod Par {
+    import java.lang.Runtime
+
+    /// 違う仕事を同時に回すかの物差し。work = 呼ぶ側が数える仕事の大きさ（物の数の合計など）・
+    /// minWork = 並列にする下限（work がこれに満たなければ順に呼ぶ）。
+    pub type alias Work = { work = Int32, minWork = Int32 }
+
+    /// map が使う minChunk。並び全体が 2 × これに満たなければ 1 本で回す。
+    /// 一番軽い f（1 要素数十 ns）で、塊を回して集める代金を割って得になる所から決めた値（bench/par の README）。
+    pub def defaultMinChunk(): Int32 = 8192
+
+    /// 使えるスレッドの数（JVM の availableProcessors・-XX:ActiveProcessorCount で変わる）。呼ぶたびに読む。
+    // WhyNot: 値を 1 回読んで持たない — 持つ所が大域の可変の値になる。読む代金は数十 ns で、塊を回す代金に比べて小さい。
+    pub def workers(): Int32 =
+        Runtime.getRuntime().availableProcessors()
+
+    /// xs の並びの順に f を当てた並び（Vector.map と同じ値）。軽い物ごとの更新のための口で、要素の重さが分かる所は mapChunked。
+    pub def map(f: a -> b, xs: Vector[a]): Vector[b] =
+        mapChunked(defaultMinChunk(), f, xs)
+
+    /// map の塊の下限を呼ぶ側が決める形。塊の数は min(workers() × 4, 要素の数 / minChunk) で、1 以下なら Vector.map。
+    /// 1 要素が重い仕事（行の塗りなど）は小さい minChunk（1〜8）を渡す。
+    pub def mapChunked(minChunk: Int32, f: a -> b, xs: Vector[a]): Vector[b] =
+        let n = Vector.length(xs);
+        if (n < 2 * Int32.max(1, minChunk)) Vector.map(f, xs)
+        else Par.Internal.mapInChunks(chunkCount(workers(), minChunk, n), f, xs)
+
+    /// f と g を同時に回して組で返す（同じ World を読む独立した系など）。size#work < size#minWork なら f・g の順に呼ぶ。
+    /// どちらかが例外を投げたら、その例外で抜ける。
+    pub def join2(size: Work, f: Unit -> a, g: Unit -> b): (a, b) =
+        if (not isWorthForking(size)) (f(), g())
+        else {
+            let slots = runEach(Vector#{() -> Slot.S1(f()), () -> Slot.S2(g())});
+            (slot1(0, slots), slot2(1, slots))
+        }
+
+    /// join2 の 3 つ版。
+    pub def join3(size: Work, f: Unit -> a, g: Unit -> b, h: Unit -> c): (a, b, c) =
+        if (not isWorthForking(size)) (f(), g(), h())
+        else {
+            let slots = runEach(Vector#{() -> Slot.S1(f()), () -> Slot.S2(g()), () -> Slot.S3(h())});
+            (slot1(0, slots), slot2(1, slots), slot3(2, slots))
+        }
+
+    /// join2 の 4 つ版。
+    pub def join4(size: Work, f: Unit -> a, g: Unit -> b, h: Unit -> c, i: Unit -> d): (a, b, c, d) =
+        if (not isWorthForking(size)) (f(), g(), h(), i())
+        else {
+            let slots = runEach(Vector#{() -> Slot.S1(f()), () -> Slot.S2(g()), () -> Slot.S3(h()), () -> Slot.S4(i())});
+            (slot1(0, slots), slot2(1, slots), slot3(2, slots), slot4(3, slots))
+        }
+
+    def isWorthForking(size: Work): Bool =
+        size#work >= size#minWork and workers() > 1
+
+    /// 塊の数。使えるスレッドが 1 なら 1（塊を作らない）。
+    def chunkCount(workerCount: Int32, minChunk: Int32, n: Int32): Int32 =
+        if (workerCount <= 1) 1
+        else Int32.max(1, Int32.min(workerCount * 4, n / Int32.max(1, minChunk)))
+
+    /// 仕事を 1 つずつ別の塊で回し、結果を並びの順に返す。
+    def runEach(tasks: Vector[Unit -> a]): Vector[a] =
+        Par.Internal.mapInChunks(Vector.length(tasks), task -> task(), tasks)
+
+    /// join の仕事の結果を同じ型の並びに載せる入れ物（塊は 1 つの型の並びしか回さない）。
+    enum Slot[a, b, c, d] {
+        case S1(a)
+        case S2(b)
+        case S3(c)
+        case S4(d)
+    }
+
+    def slotAt(index: Int32, slots: Vector[Slot[a, b, c, d]]): Slot[a, b, c, d] =
+        match Vector.nth(index, slots) {
+            case Some(slot) => slot
+            case None       => bug!("Par: join の結果が足りない")
+        }
+
+    def slot1(index: Int32, slots: Vector[Slot[a, b, c, d]]): a = match slotAt(index, slots) {
+        case Slot.S1(x) => x
+        case _          => bug!("Par: join の 1 つ目の結果が別の入れ物にあった")
+    }
+
+    def slot2(index: Int32, slots: Vector[Slot[a, b, c, d]]): b = match slotAt(index, slots) {
+        case Slot.S2(x) => x
+        case _          => bug!("Par: join の 2 つ目の結果が別の入れ物にあった")
+    }
+
+    def slot3(index: Int32, slots: Vector[Slot[a, b, c, d]]): c = match slotAt(index, slots) {
+        case Slot.S3(x) => x
+        case _          => bug!("Par: join の 3 つ目の結果が別の入れ物にあった")
+    }
+
+    def slot4(index: Int32, slots: Vector[Slot[a, b, c, d]]): d = match slotAt(index, slots) {
+        case Slot.S4(x) => x
+        case _          => bug!("Par: join の 4 つ目の結果が別の入れ物にあった")
+    }
+
+}
diff --git a/engine/src/core/Par/Internal.flix b/engine/src/core/Par/Internal.flix
new file mode 100644
index 00000000..32e56582
--- /dev/null
+++ b/engine/src/core/Par/Internal.flix
@@ -0,0 +1,42 @@
+// Par.Internal — Par の中身。塊の数を直に決めて回す口を、テストと bench のために出す。
+// ゲームの src からは呼ばない（版を上げると形が黙って変わる・lint で止める）。
+pub mod Par.Internal {
+
+    /// xs を chunks 個の塊に割って f を当て、塊の番号の順につなぐ（Vector.map と同じ値）。chunks が 1 以下か、
+    /// 要素が 1 つ以下なら塊を作らず Vector.map。塊の数は要素の数で頭打ち。
+    pub def mapInChunks(chunks: Int32, f: a -> b, xs: Vector[a]): Vector[b] =
+        let n = Vector.length(xs);
+        let k = Int32.min(chunks, n);
+        if (k <= 1) Vector.map(f, xs)
+        else {
+            let size = (n + k - 1) / k;
+            Vector.range(0, k)
+                |> Vector.map(c -> {
+                    let lo = Int32.min(n, c * size);
+                    let hi = Int32.min(n, lo + size);
+                    () -> Vector.map(f, Vector.slice(start = lo, end = hi, xs))
+                })
+                |> runTasks
+                |> Vector.flatten
+        }
+
+    /// tasks を 1 つずつ別のスレッドで回し、結果を tasks の順に並べる。どれかが例外を投げたら、その例外で抜ける。
+    /// engine でスレッドに触るのはこの関数だけ。
+    // WhyNot: Flix の `par (..) yield` で書かない — 自分のコードに書いた par は 1 スレッドと同じ速さだった（標準の中の par だけが効く）。
+    // WhyNot: 機種ごとに差し替える層にしない — スレッドの無い機種の 2 つ目の実装が今は無い。コンシューマの計画が立った時に、
+    //   この関数と Par.workers の 2 つだけを別のモジュールへ切り出せば替えられる。ブラウザは訳す前の付け替えの道具で availableProcessors を 1 にする。
+    // WhyNot: unchecked_cast で IO を消してよい — 受ける仕事は純粋で、結果は番号の順に並べ直すので、スレッドの数と終わる順は値に出ない。
+    def runTasks(tasks: Vector[Unit -> a]): Vector[a] =
+        let runWithThreads = () -> region rc {
+            let k = Vector.length(tasks);
+            let (tx, rx) = Channel.buffered(k);
+            Vector.forEachWithIndex((index, task) -> spawn { Channel.send((index, task()), tx) } @ rc, tasks);
+            List.range(0, k)
+                |> List.map(_ -> Channel.recv(rx))
+                |> List.sortBy(fst)
+                |> List.map(snd)
+                |> List.toVector
+        };
+        unchecked_cast(runWithThreads() as _ \ {})
+
+}
diff --git a/engine/test/TestPar.flix b/engine/test/TestPar.flix
new file mode 100644
index 00000000..e43f743b
--- /dev/null
+++ b/engine/test/TestPar.flix
@@ -0,0 +1,120 @@
+// Par の並列の map と join が、塊の数に関わらず 1 スレッドと同じ値・同じ呼ばれた回数になること、
+// 仕事の例外がそのまま抜けること（固まらないこと）。
+mod TestPar {
+    import java.lang.{RuntimeException, Throwable}
+    import java.util.concurrent.atomic.AtomicInteger
+
+    /// calls を 1 つ進めて 0 を返す（純粋に見える関数の中で呼ばれた回数を数える）。
+    def countedZero(calls: AtomicInteger): Int32 =
+        Int32.min(0, unchecked_cast(calls.incrementAndGet() as _ \ {}))
+
+    /// 塊の数の候補（1 は 1 本の道・48 は 12 コアの 4 倍）。
+    def chunkCounts(): List[Int32] = 1 :: 2 :: 3 :: 7 :: 12 :: 48 :: Nil
+
+    /// 長さの候補（空・塊の数より短い・割り切れない・大きい）。
+    def lengths(): List[Int32] = 0 :: 1 :: 2 :: 5 :: 47 :: 1000 :: 4099 :: 20000 :: Nil
+
+    /// 決まった種から作る並び（Hash の形の数で、要素ごとに違う値）。
+    def numbers(seed: Int32, n: Int32): Vector[Int32] =
+        Vector.range(0, n) |> Vector.map(i -> (i * 1103515245 + seed * 12345) `Int32.bitwiseXor` (i / 8))
+
+    /// 浮動小数の足す順が出る重めの純粋な関数（塊の切れ目で値が変わらないことを見る）。
+    def heavy(x: Int32): Float64 =
+        List.range(0, 16) |> List.foldLeft((acc, k) -> acc * 0.999 + Int32.toFloat64(x `Int32.bitwiseXor` k) / 7.0, 0.1)
+
+    @Test
+    def testMapInChunksEqualsVectorMapForEveryChunkCount(): Unit \ Assert =
+        let mismatches = lengths() |> List.flatMap(n ->
+            chunkCounts() |> List.filterMap(k -> {
+                let xs = numbers(n, n);
+                if (Par.Internal.mapInChunks(k, heavy, xs) == Vector.map(heavy, xs)) None else Some((n, k))
+            }));
+        Assert.assertEq(expected = Nil, mismatches)
+
+    @Test
+    def testMapEqualsVectorMap(): Unit \ Assert =
+        let xs = numbers(7, 40000);
+        Assert.assertEq(expected = Vector.map(heavy, xs), Par.map(heavy, xs))
+
+    @Test
+    def testMapChunkedEqualsVectorMap(): Unit \ Assert =
+        let xs = numbers(3, 3001);
+        Assert.assertEq(expected = Vector.map(heavy, xs), Par.mapChunked(1, heavy, xs))
+
+    @Test
+    def testMapChunkedOfEmptyIsEmpty(): Unit \ Assert =
+        Assert.assertEq(expected = Vector.empty(), Par.mapChunked(1, heavy, Vector.empty()))
+
+    @Test
+    def testMapChunkedCallsFOncePerElement(): Unit \ {Assert, IO} =
+        let calls = new AtomicInteger(0);
+        let counted = x -> x + countedZero(calls);
+        let ys = Par.mapChunked(1, counted, numbers(1, 5000));
+        let lengthsReadInLambda = List.range(0, 3) |> List.map(_ -> Vector.length(ys));
+        Assert.assertEq(expected = (5000, 5000 :: 5000 :: 5000 :: Nil), (calls.get(), lengthsReadInLambda))
+
+    @Test
+    def testMapInChunksCallsFOncePerElement(): Unit \ {Assert, IO} =
+        let calls = new AtomicInteger(0);
+        let counted = x -> x + countedZero(calls);
+        let ys = Par.Internal.mapInChunks(48, counted, numbers(2, 777));
+        Assert.assertEq(expected = (777, 777), (Vector.length(ys), calls.get()))
+
+    @Test
+    def testJoin2EqualsCallingInOrder(): Unit \ Assert =
+        let forked = { work = 1, minWork = 0 };
+        Assert.assertEq(expected = (heavy(1), "b"), Par.join2(forked, () -> heavy(1), () -> "b"))
+
+    @Test
+    def testJoin3EqualsCallingInOrder(): Unit \ Assert =
+        let forked = { work = 1, minWork = 0 };
+        Assert.assertEq(expected = (heavy(1), "b", 3), Par.join3(forked, () -> heavy(1), () -> "b", () -> 3))
+
+    @Test
+    def testJoin4EqualsCallingInOrder(): Unit \ Assert =
+        let forked = { work = 1, minWork = 0 };
+        Assert.assertEq(expected = (heavy(1), "b", 3, 'd'), Par.join4(forked, () -> heavy(1), () -> "b", () -> 3, () -> 'd'))
+
+    @Test
+    def testJoin2BelowMinWorkEqualsCallingInOrder(): Unit \ Assert =
+        let sequential = { work = 1, minWork = 2 };
+        Assert.assertEq(expected = (heavy(1), "b"), Par.join2(sequential, () -> heavy(1), () -> "b"))
+
+    @Test
+    def testJoin4CallsEachTaskOnce(): Unit \ {Assert, IO} =
+        let calls = new AtomicInteger(0);
+        let counted = (x: Int32) -> () -> x + countedZero(calls);
+        let joined = Par.join4({ work = 1, minWork = 0 }, counted(1), counted(2), counted(3), counted(4));
+        Assert.assertEq(expected = ((1, 2, 3, 4), 4), (joined, calls.get()))
+
+    /// 仕事の 1 つが落ちる f（x == 4321 だけ・Java の例外を投げる）。
+    def failsAt4321(x: Int32): Int32 =
+        if (x == 4321) unchecked_cast(throwTaskFailure() as _ \ {}) else x * 2
+
+    def throwTaskFailure(): Int32 \ IO =
+        throw new RuntimeException("仕事 4321 が落ちた")
+
+    /// f を回し、抜けた例外の字を返す（抜けなければ結果の長さ）。
+    def thrownMessage(f: Unit -> Vector[Int32]): Result[Int32, String] =
+        try { Err(Vector.length(f())) } catch {
+            case e: Throwable => Ok(e.getMessage())
+        }
+
+    @Test
+    def testMapChunkedRethrowsTaskFailure(): Unit \ Assert =
+        let thrown = thrownMessage(() -> Par.mapChunked(1, failsAt4321, Vector.range(0, 10000)));
+        Assert.assertTrue(thrown |> Result.exists(String.contains(substr = "仕事 4321 が落ちた")))
+
+    @Test
+    def testJoin2RethrowsTaskFailure(): Unit \ Assert =
+        let thrown = thrownMessage(() -> {
+            let (a, b) = Par.join2({ work = 1, minWork = 0 }, () -> Vector#{1}, () -> Vector#{failsAt4321(4321)});
+            Vector.append(a, b)
+        });
+        Assert.assertTrue(thrown |> Result.exists(String.contains(substr = "仕事 4321 が落ちた")))
+
+    @Test
+    def testWorkersIsPositive(): Unit \ Assert =
+        Assert.assertTrue(Par.workers() >= 1)
+
+}
