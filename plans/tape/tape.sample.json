  "lines": {
    "18": { "cmd": "<<lights 1.8>>" }, "20": { "cmd": "<<girl>>" }, "23": { "cmd": "<<witch on>>" }, "35": { "cmd": "<<item bottle>>" }, "39": { "cmd": "<<item knife>>" },
    "25": { "who": "魔女", "text": "おや、あんた海の者でないね。／そんなに空気の泡を吐いてりゃ／すぐ分かるさ" },
    "28": { "who": "少女", "text": "……………………" },
    "29": { "who": "魔女", "text": "なになに……／海の魔女の力が借りたくて、／息苦しい中ここまで？／そりゃあご苦労なことだ" },
    "30": { "who": "魔女", "text": "それで、願いってのは？／……はあ。魂を捨てたい、ね。／人間様にしちゃ珍しい願い事だ" },
    "31": { "who": "魔女", "text": "ま、不可能じゃないよ。／ただし対価に／今あんたの一番大事なモノを……／え、そんなもの存在しない？" },
    "32": { "who": "魔女", "text": "……" },
    "33": { "who": "魔女", "text": "ああもう。分かった、分かった。／だからそんな目で見るんじゃないよ" },
    "34": { "who": "魔女", "text": "こいつを持っていきな" },
    "38": { "who": "魔女", "text": "この器を血で満たし、／ついでに魂の代わりに／お前を動かしてくれる核を／何か一つ、入れるんだ。／それを今の心臓とそっくり取り換えりゃ、／魂を失くしても生きていけるってわけさ" },
    "42": { "who": "魔女", "text": "ほら、このナイフもサービスだ。／血を集めるのに便利だろうし、／使い続ければ手に馴染むだろうさ" },
    "44": { "who": "魔女", "text": "ただし、中身を集めている間は、／海から上がるんじゃないよ。／私の魔法が解けて、／器が駄目になっちまうからね" },
    "45": { "who": "魔女", "text": "それだと息が続かない？／泣き言をいうんじゃないよ。／水中でも、息継ぎする手段はあるものさ。／それくらいは自分で探しな" },
    "46": { "who": "魔女", "text": "さあ、お行き。／魂を失くして新しい生を歩むか、／死んで魂ごと失くしちまうか。／それはあんたの努力次第だ。／それで、あんたの目的が果たされたら。／その時に余った心臓と魂を／対価として貰うことにしよう" },
    "51": { "who": "地の文", "text": "こうして『少女』は／魂の代わりになるモノを得るために、／海での暮らしを始めました" }
  },
