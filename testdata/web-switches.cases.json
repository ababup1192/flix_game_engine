    { "name": "真偽の旗に値", "search": "?fge=fps:1", "switches": {}, "unknown": ["fps:1"] },
    { "name": "Start と一緒（どこに置いてもよい）", "search": "?fge=fps&talk=Lair&line=46", "switches": { "fps": true } },
    { "name": "前の鍵を読んで知らせる", "search": "?fps=1&backend=webgl2", "switches": { "fps": true, "backend": "webgl2" }, "legacy": [{ "from": "fps=1", "to": "fps" }, { "from": "backend=webgl2", "to": "webgl2" }] },
    { "name": "前の鍵の値の形", "search": "?capture=6&deferred=all&usedAssets=1&net=4g&size=medium&webgpuFail=prepare", "switches": { "capture": 6, "deferred": "all", "usedAssets": true, "net": "4g", "size": "medium", "webgpuFail": "prepare" }, "legacy": [{ "from": "net=4g", "to": "4g" }, { "from": "size=medium", "to": "medium" }, { "from": "capture=6", "to": "capture:6" }, { "from": "deferred=all", "to": "deferred:all" }, { "from": "usedAssets=1", "to": "usedassets" }, { "from": "webgpuFail=prepare", "to": "webgpufail:prepare" }] },
    { "name": "前の鍵の読めない値も知らせる", "search": "?fps=yes", "switches": {}, "legacy": [{ "from": "fps=yes", "to": "fps" }] },
    { "name": "sw=0 は知らせずに読む", "search": "?sw=0", "switches": { "sw": false } },
