    { "name": "大文字を許す", "search": "?fge=FPS,WebGL2,Size:Small", "switches": { "fps": true, "backend": "webgl2", "size": "small" } },
    { "name": "nosw", "search": "?fge=nosw", "switches": { "sw": false } },
    { "name": "sw:0", "search": "?fge=sw:0", "switches": { "sw": false } },
    { "name": "同じ旗は後の語", "search": "?fge=touch,mouse", "switches": { "input": "mouse" } },
    { "name": "空の語は飛ばす", "search": "?fge=fps,,%20", "switches": { "fps": true } },
    { "name": "知らない語は捨てる", "search": "?fge=fps,turbo", "switches": { "fps": true }, "unknown": ["turbo"] },
    { "name": "値の要る旗を名前だけ", "search": "?fge=capture", "switches": {}, "unknown": ["capture"] },
