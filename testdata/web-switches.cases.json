    { "name": "gl は webgl2", "search": "?fge=gl", "switches": { "backend": "webgl2" } },
    { "name": "webgpu は既定と同じ", "search": "?fge=webgpu", "switches": {} },
    { "name": "名前:値", "search": "?fge=backend:webgl2,net:4g,input:touch,size:small,orientation:portrait", "switches": { "backend": "webgl2", "net": "4g", "input": "touch", "size": "small", "orientation": "portrait" } },
    { "name": "指と縦を短く", "search": "?fge=small,touch,portrait", "switches": { "size": "small", "input": "touch", "orientation": "portrait" } },
