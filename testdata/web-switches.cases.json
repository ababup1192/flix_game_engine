    { "name": "fgeDev の backend", "search": "", "dev": { "backend": "webgl2" }, "switches": { "backend": "webgl2" } },
    { "name": "fgeDev の型の違う値は捨てる", "search": "", "dev": { "capture": "x", "fps": 1, "size": "huge" }, "switches": {} }
