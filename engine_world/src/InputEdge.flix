// InputEdge — キーが「今まさに押された瞬間」か「押しっぱなし」かを見分ける。
// 押された最初の1フレームだけを true にできるので、長押ししてもメニュー選択やページ
// めくりが一度きりで効く。
// 利用例: メニューのカーソル移動 / ページ送り / 決定ボタンの1回だけの確定。

pub mod InputEdge {

    /// キーが押された瞬間のフレームだけ true: 今 (`cur`) は押されていて、前フレーム
    /// (`prev`) は離れていた。押しっぱなしは最初のフレーム以降 false のまま。
    pub def pressed(prev: Bool, cur: Bool): Bool =
        cur and not prev
}
